@@ -0,0 +1,206 @@
+package com.yugahashimoto.andcode.core.capability
+
+/** Stable validation codes, so tests, the UI and the audit log can rely on them. */
+enum class CapabilityIssueCode {
+    INVALID_ID,
+    INVALID_NAME,
+    EMPTY_DESCRIPTION,
+    CONTRACT_VERSION_UNSUPPORTED,
+    APP_VERSION_TOO_OLD,
+    FORBIDDEN_PERMISSION,
+    DUPLICATE_FIELD,
+    INVALID_FIELD_NAME,
+    FIELD_NEEDS_PERMISSION,
+    LIMITS_ABOVE_HARD_CAP,
+    NO_REQUIRED_TESTS,
+    UNKNOWN_TOOL,
+    WORKFLOW_HAS_NO_TOOLS,
+    CORE_CHANGE_CANNOT_BE_INSTALLED,
+    UNTRUSTED_SOURCE,
+    DUPLICATE_ID,
+}
+
+/**
+ * One finding about a manifest.
+ *
+ * [blocking] separates "this manifest is wrong" from "the user still has to look at it": an untrusted
+ * source is reported so the capability screen can say so, but it is not a validator failure - it is the
+ * review gate in [CapabilityRegistry.enable] that has to be satisfied.
+ */
+data class CapabilityIssue(
+    val code: CapabilityIssueCode,
+    val detail: String,
+    val blocking: Boolean = true,
+)
+
+/** What the app knows about itself while validating: its version, and the tools it actually has. */
+data class CapabilityValidationContext(
+    val appVersion: SemVer,
+    val supportedContractVersion: Int = CapabilityDependencies.CONTRACT_VERSION,
+    val registeredToolIds: Set<String> = emptySet(),
+    /** Manifests already known to the registry, used to reject a duplicate id. */
+    val existingIds: Set<String> = emptySet(),
+)
+
+/**
+ * Checks a [CapabilityManifest] before anything is stored or enabled.
+ *
+ * Every rule here exists because of a concrete failure the task asks to prevent: a capability that
+ * quietly gains a forbidden permission, one written against a newer contract than this APK understands,
+ * a workflow that mentions a tool that does not exist, a schema that asks for a command field without the
+ * permission to run commands, or limits larger than the app will honour. Validation failures are returned,
+ * never thrown, so the UI can show all of them at once.
+ */
+object CapabilityValidator {
+    private val ID_PATTERN = Regex("^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,3}$")
+    private val FIELD_PATTERN = Regex("^[a-zA-Z][a-zA-Z0-9_]{0,63}$")
+
+    fun validate(
+        manifest: CapabilityManifest,
+        context: CapabilityValidationContext,
+    ): List<CapabilityIssue> {
+        val issues = mutableListOf<CapabilityIssue>()
+
+        if (!ID_PATTERN.matches(manifest.id)) {
+            issues += CapabilityIssue(CapabilityIssueCode.INVALID_ID, "'${manifest.id}' is not a dotted lowercase id")
+        }
+        if (manifest.id in context.existingIds) {
+            issues += CapabilityIssue(CapabilityIssueCode.DUPLICATE_ID, "${manifest.id} is already registered")
+        }
+        if (manifest.name.isBlank() || manifest.name.length > MAX_NAME_LENGTH) {
+            issues += CapabilityIssue(CapabilityIssueCode.INVALID_NAME, "name must be 1..$MAX_NAME_LENGTH characters")
+        }
+        if (manifest.description.isBlank()) {
+            issues += CapabilityIssue(CapabilityIssueCode.EMPTY_DESCRIPTION, "a capability has to say what it does")
+        }
+        if (manifest.dependencies.contractVersion != context.supportedContractVersion) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.CONTRACT_VERSION_UNSUPPORTED,
+                    "contract ${manifest.dependencies.contractVersion}, app supports ${context.supportedContractVersion}",
+                )
+        }
+        if (manifest.minimumAppVersion > context.appVersion) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.APP_VERSION_TOO_OLD,
+                    "needs app ${manifest.minimumAppVersion}, installed ${context.appVersion}",
+                )
+        }
+
+        issues += permissionIssues(manifest)
+        issues += fieldIssues(manifest)
+        issues += limitIssues(manifest)
+
+        if (manifest.requiredTestIds.isEmpty()) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.NO_REQUIRED_TESTS,
+                    "declare at least one test id; a capability is not enabled on the manifest's word",
+                )
+        }
+        issues += dependencyIssues(manifest, context)
+
+        if (!manifest.kind.installableAsData && manifest.source != CapabilitySource.BUNDLED) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.CORE_CHANGE_CANNOT_BE_INSTALLED,
+                    "core changes ship in an APK; ${manifest.source.name.lowercase()} cannot install one",
+                )
+        }
+        if (!manifest.source.isTrustedByDefault) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.UNTRUSTED_SOURCE,
+                    "${manifest.source.name.lowercase()} capabilities need an explicit review before enabling",
+                    blocking = false,
+                )
+        }
+        return issues
+    }
+
+    private fun permissionIssues(manifest: CapabilityManifest): List<CapabilityIssue> =
+        manifest.permissions
+            .filter { it.forbidden }
+            .map { CapabilityIssue(CapabilityIssueCode.FORBIDDEN_PERMISSION, "${it.name}: ${it.description}") }
+
+    private fun fieldIssues(manifest: CapabilityManifest): List<CapabilityIssue> {
+        val issues = mutableListOf<CapabilityIssue>()
+        val allFields = manifest.inputs + manifest.outputs
+        allFields
+            .groupBy { it.name }
+            .filterValues { it.size > 1 }
+            .keys
+            .forEach { issues += CapabilityIssue(CapabilityIssueCode.DUPLICATE_FIELD, "'$it' is declared twice") }
+
+        for (field in allFields) {
+            if (!FIELD_PATTERN.matches(field.name)) {
+                issues += CapabilityIssue(CapabilityIssueCode.INVALID_FIELD_NAME, "'${field.name}' is not a valid field name")
+            }
+            if (field.hasAllowedValues && field.type == FieldType.PATH) {
+                // A closed path list is either dead weight or a bypass of the workspace rule; refuse it.
+                issues +=
+                    CapabilityIssue(
+                        CapabilityIssueCode.FIELD_NEEDS_PERMISSION,
+                        "'${field.name}': a PATH field cannot be restricted to a fixed list",
+                    )
+            }
+        }
+        // The schema and the permission set have to agree, or a capability could describe a command input
+        // while never asking for the right to run one.
+        if (allFields.any { it.type == FieldType.COMMAND } && CapabilityPermission.RUN_SHELL_COMMAND !in manifest.permissions) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.FIELD_NEEDS_PERMISSION,
+                    "a COMMAND field requires the RUN_SHELL_COMMAND permission",
+                )
+        }
+        if (allFields.any { it.type == FieldType.PATH } &&
+            manifest.permissions.none { it == CapabilityPermission.READ_PROJECT_FILES || it == CapabilityPermission.WRITE_PROJECT_FILES }
+        ) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.FIELD_NEEDS_PERMISSION,
+                    "a PATH field requires READ_PROJECT_FILES or WRITE_PROJECT_FILES",
+                )
+        }
+        return issues
+    }
+
+    private fun limitIssues(manifest: CapabilityManifest): List<CapabilityIssue> {
+        val caps = CapabilityLimits.HARD_CAPS
+        val issues = mutableListOf<CapabilityIssue>()
+        if (manifest.limits.maxDurationMs <= 0 || manifest.limits.maxDurationMs > caps.maxDurationMs) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.LIMITS_ABOVE_HARD_CAP,
+                    "maxDurationMs must be 1..${caps.maxDurationMs}",
+                )
+        }
+        if (manifest.limits.maxOutputBytes <= 0 || manifest.limits.maxOutputBytes > caps.maxOutputBytes) {
+            issues +=
+                CapabilityIssue(
+                    CapabilityIssueCode.LIMITS_ABOVE_HARD_CAP,
+                    "maxOutputBytes must be 1..${caps.maxOutputBytes}",
+                )
+        }
+        return issues
+    }
+
+    private fun dependencyIssues(
+        manifest: CapabilityManifest,
+        context: CapabilityValidationContext,
+    ): List<CapabilityIssue> {
+        val issues = mutableListOf<CapabilityIssue>()
+        if (manifest.kind == CapabilityKind.WORKFLOW && manifest.dependencies.toolIds.isEmpty()) {
+            issues += CapabilityIssue(CapabilityIssueCode.WORKFLOW_HAS_NO_TOOLS, "a workflow has to name the tools it calls")
+        }
+        manifest.dependencies.toolIds
+            .filterNot { it in context.registeredToolIds }
+            .distinct()
+            .forEach { issues += CapabilityIssue(CapabilityIssueCode.UNKNOWN_TOOL, "'$it' is not a registered tool") }
+        return issues
+    }
+
+    private const val MAX_NAME_LENGTH = 80
+}
