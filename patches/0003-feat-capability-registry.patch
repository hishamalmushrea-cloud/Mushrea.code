+package com.yugahashimoto.andcode.core.capability
+
+/** Where a capability is in its life. */
+enum class CapabilityState {
+    /** Known, not yet checked. */
+    DRAFT,
+
+    /** Passed [CapabilityValidator]; still not runnable. */
+    VALIDATED,
+
+    /** Its declared tests passed. */
+    TESTED,
+
+    /** Available to the agent and the UI. */
+    ENABLED,
+
+    /** Switched off by the user; can be re-enabled after revalidation. */
+    DISABLED,
+
+    /** Removed for good; keeps its history but can never be enabled again. */
+    REVOKED,
+    ;
+
+    val isRunnable: Boolean get() = this == ENABLED
+}
+
+/** Why the registry refused an operation. */
+enum class CapabilityRejection {
+    UNKNOWN_CAPABILITY,
+    STATE_NOT_ALLOWED,
+
+    /** Validation issues are still outstanding, so the manifest cannot move on. */
+    NOT_VALIDATED,
+
+    /** The declared tests have not passed, or a failure is on record. */
+    TESTS_NOT_PASSED,
+
+    /** A permission the manifest needs was not granted by the user. */
+    PERMISSION_NOT_GRANTED,
+
+    /** The source is not bundled and the user has not reviewed it yet. */
+    UNTRUSTED_SOURCE,
+
+    /** Reached [CapabilityState.REVOKED]; that is final. */
+    REVOKED,
+}
+
+/** One stored capability plus its current state and the issues last reported for it. */
+data class RegisteredCapability(
+    val manifest: CapabilityManifest,
+    val state: CapabilityState = CapabilityState.DRAFT,
+    val issues: List<CapabilityIssue> = emptyList(),
+    val testEvidence: CapabilityTestEvidence? = null,
+    /** Set once the user has explicitly reviewed a non-bundled manifest. */
+    val reviewed: Boolean = false,
+) {
+    val isRunnable: Boolean get() = state.isRunnable
+}
+
+/** Outcome of asking the registry to do something with a capability. */
+sealed interface CapabilityResult {
+    data class Success(val capability: RegisteredCapability) : CapabilityResult
+
+    data class Rejected(
+        val reason: CapabilityRejection,
+        val detail: String,
+    ) : CapabilityResult
+
+    val accepted: Boolean get() = this is Success
+}
+
+/** One recorded lifecycle change, so the capability screen can explain how it got here. */
+data class CapabilityEvent(
+    val timestampMs: Long,
+    val capabilityId: String,
+    val from: CapabilityState?,
+    val to: CapabilityState,
+    val actor: String,
+)
+
+/**
+ * Holds the capability manifests this device knows about and enforces their lifecycle.
+ *
+ * The rules that matter, all of them in code rather than in a prompt:
+ * - nothing is enabled on the manifest's own word: validation, the declared tests, the user's permission
+ *   grant and (for a non-bundled manifest) an explicit review all have to have happened;
+ * - [CapabilityState.REVOKED] is final, so a removed capability cannot be talked back into service;
+ * - a permission is granted by the caller, never read out of the manifest.
+ *
+ * In-memory and bounded like the policy audit log: persistence and the settings UI are a separate change,
+ * and pretending otherwise here would just move the gap somewhere less visible.
+ */
+class CapabilityRegistry(
+    private val maxCapabilities: Int = DEFAULT_MAX_CAPABILITIES,
+    private val clock: () -> Long = { System.currentTimeMillis() },
+) {
+    private val lock = Any()
+    private val capabilities = linkedMapOf<String, RegisteredCapability>()
+    private val events = ArrayDeque<CapabilityEvent>()
+
+    init {
+        require(maxCapabilities > 0) { "maxCapabilities must be positive" }
+    }
+
+    /** Validates [manifest] and stores it when there is nothing to report. */
+    fun draft(
+        manifest: CapabilityManifest,
+        context: CapabilityValidationContext,
+        actor: String = "user:add",
+    ): CapabilityResult {
+        synchronized(lock) {
+            if (manifest.id in capabilities) {
+                return reject(CapabilityRejection.STATE_NOT_ALLOWED, "${manifest.id} is already registered")
+            }
+            if (capabilities.size >= maxCapabilities) {
+                return reject(CapabilityRejection.STATE_NOT_ALLOWED, "capability limit $maxCapabilities reached")
+            }
+            val issues =
+                CapabilityValidator.validate(manifest, context.copy(existingIds = capabilities.keys.toSet()))
+            val registered = RegisteredCapability(manifest = manifest, issues = issues)
+            capabilities[manifest.id] = registered
+            record(manifest.id, null, CapabilityState.DRAFT, actor)
+            return CapabilityResult.Success(registered)
+        }
+    }
+
+    /** Re-runs validation, and moves the draft to [CapabilityState.VALIDATED] only when it is clean. */
+    fun validate(
+        id: String,
+        context: CapabilityValidationContext,
+        actor: String = "app:validate",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            if (current.state != CapabilityState.DRAFT && current.state != CapabilityState.VALIDATED) {
+                return reject(CapabilityRejection.STATE_NOT_ALLOWED, "cannot validate from ${current.state.name}")
+            }
+            val issues =
+                CapabilityValidator.validate(current.manifest, context.copy(existingIds = capabilities.keys.toSet() - id))
+            if (issues.any { it.blocking }) {
+                val stored = current.copy(issues = issues)
+                capabilities[id] = stored
+                return CapabilityResult.Success(stored)
+            }
+            return move(current.copy(issues = emptyList()), CapabilityState.VALIDATED, actor)
+        }
+
+    /** Records that the declared tests ran. A failure keeps the capability out and stores the evidence. */
+    fun recordTests(
+        id: String,
+        evidence: CapabilityTestEvidence,
+        actor: String = "app:test",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            if (current.state != CapabilityState.VALIDATED && current.state != CapabilityState.TESTED) {
+                return reject(CapabilityRejection.STATE_NOT_ALLOWED, "cannot test from ${current.state.name}")
+            }
+            val withEvidence = current.copy(testEvidence = evidence)
+            if (!evidence.covers(current.manifest.requiredTestIds)) {
+                capabilities[id] = withEvidence
+                return reject(CapabilityRejection.TESTS_NOT_PASSED, "declared tests have not all passed")
+            }
+            return move(withEvidence, CapabilityState.TESTED, actor)
+        }
+
+    /** Marks a non-bundled capability as reviewed by the user. Bundled ones do not need it. */
+    fun review(
+        id: String,
+        actor: String = "user:review",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            if (current.state == CapabilityState.REVOKED) return reject(CapabilityRejection.REVOKED, id)
+            val updated = current.copy(reviewed = true)
+            capabilities[id] = updated
+            return CapabilityResult.Success(updated)
+        }
+
+    /**
+     * Enables a capability. [grantedPermissions] is the user's decision, not the manifest's request: a
+     * permission the manifest needs but the user did not grant blocks the enable.
+     */
+    fun enable(
+        id: String,
+        grantedPermissions: Set<CapabilityPermission>,
+        actor: String = "user:enable",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            when (current.state) {
+                CapabilityState.REVOKED -> return reject(CapabilityRejection.REVOKED, id)
+                CapabilityState.ENABLED -> return CapabilityResult.Success(current)
+                CapabilityState.DISABLED, CapabilityState.TESTED -> Unit
+                else -> return reject(CapabilityRejection.STATE_NOT_ALLOWED, "cannot enable from ${current.state.name}")
+            }
+            val blocking = current.issues.filter { it.blocking }
+            if (blocking.isNotEmpty()) {
+                return reject(CapabilityRejection.NOT_VALIDATED, "${blocking.size} validation issue(s) outstanding")
+            }
+            val evidence = current.testEvidence
+            if (evidence == null || !evidence.covers(current.manifest.requiredTestIds)) {
+                return reject(CapabilityRejection.TESTS_NOT_PASSED, "declared tests have not all passed")
+            }
+            if (!current.manifest.source.isTrustedByDefault && !current.reviewed) {
+                return reject(CapabilityRejection.UNTRUSTED_SOURCE, "review the ${current.manifest.source.name.lowercase()} manifest first")
+            }
+            val missing = current.manifest.permissions.filterNot { it in grantedPermissions || it.forbidden }
+            if (missing.isNotEmpty()) {
+                return reject(CapabilityRejection.PERMISSION_NOT_GRANTED, missing.joinToString { it.name })
+            }
+            return move(current, CapabilityState.ENABLED, actor)
+        }
+
+    /** Switches a capability off. Its tests stay on record, but re-enabling re-checks them. */
+    fun disable(
+        id: String,
+        actor: String = "user:disable",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            if (current.state != CapabilityState.ENABLED) {
+                return reject(CapabilityRejection.STATE_NOT_ALLOWED, "cannot disable from ${current.state.name}")
+            }
+            return move(current, CapabilityState.DISABLED, actor)
+        }
+
+    /** Removes a capability permanently. Final, by design. */
+    fun revoke(
+        id: String,
+        actor: String = "user:revoke",
+    ): CapabilityResult =
+        synchronized(lock) {
+            val current = capabilities[id] ?: return reject(CapabilityRejection.UNKNOWN_CAPABILITY, id)
+            if (current.state == CapabilityState.REVOKED) return CapabilityResult.Success(current)
+            return move(current, CapabilityState.REVOKED, actor)
+        }
+
+    fun get(id: String): RegisteredCapability? = synchronized(lock) { capabilities[id] }
+
+    /** Only the capabilities the agent is actually allowed to use right now. */
+    fun runnable(): List<RegisteredCapability> = synchronized(lock) { capabilities.values.filter { it.isRunnable } }
+
+    fun snapshot(): List<RegisteredCapability> = synchronized(lock) { capabilities.values.toList() }
+
+    fun events(): List<CapabilityEvent> = synchronized(lock) { events.toList() }
+
+    private fun move(
+        current: RegisteredCapability,
+        to: CapabilityState,
+        actor: String,
+    ): CapabilityResult {
+        val updated = current.copy(state = to)
+        capabilities[current.manifest.id] = updated
+        record(current.manifest.id, current.state, to, actor)
+        return CapabilityResult.Success(updated)
+    }
+
+    private fun record(
+        id: String,
+        from: CapabilityState?,
+        to: CapabilityState,
+        actor: String,
+    ) {
+        events.addLast(CapabilityEvent(clock(), id, from, to, actor))
+        while (events.size > MAX_EVENTS) events.removeFirst()
+    }
+
+    private fun reject(
+        reason: CapabilityRejection,
+        detail: String,
+    ) = CapabilityResult.Rejected(reason, detail)
+
+    companion object {
+        const val DEFAULT_MAX_CAPABILITIES = 50
+        const val MAX_EVENTS = 300
+    }
+}
