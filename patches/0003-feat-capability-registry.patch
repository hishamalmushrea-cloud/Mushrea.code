+package com.yugahashimoto.andcode.core.capability
+
+/**
+ * A dotted, monotonic version like `1.2.27`.
+ *
+ * Hand-rolled instead of a dependency: the app only needs to compare two versions ("is this capability
+ * newer than what the installed APK understands"), and pulling in a versioning library for that would be
+ * a build change this task explicitly asks not to make without need.
+ */
+data class SemVer(
+    val major: Int,
+    val minor: Int,
+    val patch: Int,
+) : Comparable<SemVer> {
+    override fun compareTo(other: SemVer): Int {
+        if (major != other.major) return major.compareTo(other.major)
+        if (minor != other.minor) return minor.compareTo(other.minor)
+        return patch.compareTo(other.patch)
+    }
+
+    override fun toString(): String = "$major.$minor.$patch"
+
+    companion object {
+        private val PATTERN = Regex("^(\\d{1,6})\\.(\\d{1,6})\\.(\\d{1,6})$")
+
+        /** Returns null for anything that is not a plain `major.minor.patch` triple. */
+        fun parseOrNull(raw: String): SemVer? {
+            val match = PATTERN.matchEntire(raw.trim()) ?: return null
+            return SemVer(
+                major = match.groupValues[1].toInt(),
+                minor = match.groupValues[2].toInt(),
+                patch = match.groupValues[3].toInt(),
+            )
+        }
+    }
+}
+
+/**
+ * What a capability is made of.
+ *
+ * The split decides whether enabling it needs a new APK: [DECLARATIVE_UI] and [WORKFLOW] compose existing
+ * tools and metadata, while [CORE_CHANGE] touches Kotlin, Gradle or Android permissions and therefore can
+ * never be "installed" as data.
+ */
+enum class CapabilityKind {
+    /** Screens built from known, allowed UI elements plus templates and reports. */
+    DECLARATIVE_UI,
+
+    /** A sequence of already-registered tools with declared input/output. */
+    WORKFLOW,
+
+    /** Work that runs on the user's own server or a remote workspace. */
+    REMOTE_SERVER,
+
+    /** Kotlin/Gradle/manifest changes. Ships in a new APK; listable here only as a description. */
+    CORE_CHANGE,
+    ;
+
+    /** True when this kind can be enabled without rebuilding the app. */
+    val installableAsData: Boolean get() = this != CORE_CHANGE
+}
+
+/** Where a capability came from. Anything not bundled with the APK is untrusted until reviewed. */
+enum class CapabilitySource {
+    BUNDLED,
+    WORKSPACE_FILE,
+    REMOTE_SERVER,
+    ;
+
+    val isTrustedByDefault: Boolean get() = this == BUNDLED
+}
+
+/**
+ * What a capability asks to be allowed to do.
+ *
+ * The [forbidden] entries exist because a capability that could disarm the policy, read credential
+ * material or write to a device would sit *above* the policy engine and defeat it. They are refused at
+ * validation time, so no manifest can request them whatever it claims to be.
+ */
+enum class CapabilityPermission(
+    val description: String,
+    val forbidden: Boolean = false,
+) {
+    READ_PROJECT_FILES("read files inside an approved workspace"),
+    WRITE_PROJECT_FILES("write files inside an approved workspace"),
+    RUN_SHELL_COMMAND("run a shell command through the task runner"),
+    NETWORK_EGRESS("contact a host the user allowlisted"),
+    INSTALL_DEPENDENCY("add or upgrade a dependency"),
+    MODIFY_APP_CONFIG("change one declared app setting"),
+    READ_CREDENTIALS("read credential material", forbidden = true),
+    DEVICE_FLASH("write to a device or partition", forbidden = true),
+    DISABLE_POLICY("turn the policy engine off", forbidden = true),
+}
+
+/** The value type a declared field carries. */
+enum class FieldType {
+    STRING,
+    NUMBER,
+    BOOLEAN,
+    PATH,
+    COMMAND,
+}
+
+/**
+ * One field in a declared input or output schema.
+ *
+ * [allowedValues] is a closed list rather than a free pattern on purpose: a manifest is untrusted input,
+ * and a small enum of accepted values is something the app can actually enforce.
+ */
+data class FieldSpec(
+    val name: String,
+    val type: FieldType,
+    val required: Boolean = true,
+    val allowedValues: List<String> = emptyList(),
+) {
+    val hasAllowedValues: Boolean get() = allowedValues.isNotEmpty()
+}
+
+/** Hard caps for one capability run, checked against [CapabilityLimits.HARD_CAPS] at validation. */
+data class CapabilityLimits(
+    val maxDurationMs: Long = DEFAULT_MAX_DURATION_MS,
+    val maxOutputBytes: Long = DEFAULT_MAX_OUTPUT_BYTES,
+) {
+    companion object {
+        const val DEFAULT_MAX_DURATION_MS = 120_000L
+        const val DEFAULT_MAX_OUTPUT_BYTES = 256L * 1024L
+
+        /** Ceilings the app refuses to exceed even when a manifest asks for more. */
+        val HARD_CAPS = CapabilityLimits(maxDurationMs = 600_000L, maxOutputBytes = 1024L * 1024L)
+    }
+}
+
+/** What the capability is allowed to call. Only names of already-registered tools belong here. */
+data class CapabilityDependencies(
+    val toolIds: List<String> = emptyList(),
+    /** Version of the capability contract this manifest was authored against. */
+    val contractVersion: Int = CONTRACT_VERSION,
+) {
+    companion object {
+        /** Bumped when the shape of [CapabilityManifest] changes incompatibly. */
+        const val CONTRACT_VERSION = 1
+    }
+}
+
+/**
+ * The exported description of one capability.
+ *
+ * Treated as untrusted input: [CapabilityValidator] checks it before anything is stored, and nothing here
+ * is a grant - a manifest asking for a permission does not get it, [CapabilityRegistry.enable] does.
+ */
+data class CapabilityManifest(
+    val id: String,
+    val name: String,
+    val version: SemVer,
+    val kind: CapabilityKind,
+    val source: CapabilitySource,
+    val description: String = "",
+    /** Minimum app version that understands this manifest, e.g. `1.2.27`. */
+    val minimumAppVersion: SemVer,
+    val permissions: Set<CapabilityPermission> = emptySet(),
+    val inputs: List<FieldSpec> = emptyList(),
+    val outputs: List<FieldSpec> = emptyList(),
+    val dependencies: CapabilityDependencies = CapabilityDependencies(),
+    val limits: CapabilityLimits = CapabilityLimits(),
+    /** Ids of the tests that have to pass before the capability may be enabled. */
+    val requiredTestIds: List<String> = emptyList(),
+) {
+    /** Stable line for the audit log and the capability screen. */
+    val summary: String get() = "$id@$version (${kind.name.lowercase()}, ${source.name.lowercase()})"
+}
+
+/** Recorded evidence that a capability's declared tests ran. Filled in by the app, not by the manifest. */
+data class CapabilityTestEvidence(
+    val passedTestIds: Set<String> = emptySet(),
+    val failedTestIds: Set<String> = emptySet(),
+    val ranAtMs: Long = 0,
+) {
+    fun covers(
+        requiredTestIds: List<String>,
+    ): Boolean = requiredTestIds.isNotEmpty() && requiredTestIds.all { it in passedTestIds } && failedTestIds.isEmpty()
+}
