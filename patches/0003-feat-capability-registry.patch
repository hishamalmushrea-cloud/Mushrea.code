@@ -0,0 +1,147 @@
+package com.yugahashimoto.andcode.core.capability
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CapabilityValidatorTest {
+    private val context =
+        CapabilityValidationContext(
+            appVersion = SemVer(1, 2, 27),
+            registeredToolIds = setOf("read_file", "write_file", "run_command"),
+        )
+
+    private fun manifest(
+        id: String = "andcode.release-notes",
+        kind: CapabilityKind = CapabilityKind.WORKFLOW,
+        source: CapabilitySource = CapabilitySource.BUNDLED,
+        permissions: Set<CapabilityPermission> = setOf(CapabilityPermission.READ_PROJECT_FILES),
+        inputs: List<FieldSpec> = emptyList(),
+        outputs: List<FieldSpec> = emptyList(),
+        toolIds: List<String> = listOf("read_file"),
+        limits: CapabilityLimits = CapabilityLimits(),
+        minimumAppVersion: SemVer = SemVer(1, 0, 0),
+        contractVersion: Int = CapabilityDependencies.CONTRACT_VERSION,
+        description: String = "summarises what changed",
+        name: String = "Release notes",
+        testIds: List<String> = listOf("works-on-sample-repo"),
+    ) = CapabilityManifest(
+        id = id,
+        name = name,
+        version = SemVer(1, 0, 0),
+        kind = kind,
+        source = source,
+        description = description,
+        minimumAppVersion = minimumAppVersion,
+        permissions = permissions,
+        inputs = inputs,
+        outputs = outputs,
+        dependencies = CapabilityDependencies(toolIds = toolIds, contractVersion = contractVersion),
+        limits = limits,
+        requiredTestIds = testIds,
+    )
+
+    private fun codes(m: CapabilityManifest) = CapabilityValidator.validate(m, context).map { it.code }
+
+    @Test
+    fun `a well formed capability has no issues`() {
+        assertEquals(emptyList<CapabilityIssueCode>(), codes(manifest()))
+    }
+
+    @Test
+    fun `an id has to be dotted lowercase`() {
+        assertTrue(CapabilityIssueCode.INVALID_ID in codes(manifest(id = "ReleaseNotes")))
+        assertTrue(CapabilityIssueCode.INVALID_ID in codes(manifest(id = "andcode")))
+        assertTrue(CapabilityIssueCode.INVALID_ID in codes(manifest(id = "andcode.release.notes.extra.deep.x")))
+    }
+
+    @Test
+    fun `a duplicate id is refused`() {
+        val withExisting = context.copy(existingIds = setOf("andcode.release-notes"))
+        val issues = CapabilityValidator.validate(manifest(), withExisting).map { it.code }
+        assertTrue(CapabilityIssueCode.DUPLICATE_ID in issues)
+    }
+
+    @Test
+    fun `a forbidden permission is refused outright`() {
+        val codes = codes(manifest(permissions = setOf(CapabilityPermission.DISABLE_POLICY)))
+        assertTrue(CapabilityIssueCode.FORBIDDEN_PERMISSION in codes)
+    }
+
+    @Test
+    fun `a capability written for a newer app is refused`() {
+        assertTrue(CapabilityIssueCode.APP_VERSION_TOO_OLD in codes(manifest(minimumAppVersion = SemVer(1, 3, 0))))
+    }
+
+    @Test
+    fun `an unknown contract version is refused`() {
+        assertTrue(CapabilityIssueCode.CONTRACT_VERSION_UNSUPPORTED in codes(manifest(contractVersion = 99)))
+    }
+
+    @Test
+    fun `a command field requires the shell permission`() {
+        val field = FieldSpec("cmd", FieldType.COMMAND)
+        assertTrue(CapabilityIssueCode.FIELD_NEEDS_PERMISSION in codes(manifest(inputs = listOf(field))))
+
+        val allowed = manifest(inputs = listOf(field), permissions = setOf(CapabilityPermission.RUN_SHELL_COMMAND))
+        assertEquals(emptyList<CapabilityIssueCode>(), codes(allowed))
+    }
+
+    @Test
+    fun `a path field requires a file permission`() {
+        val field = FieldSpec("target", FieldType.PATH)
+        val noPermission = manifest(inputs = listOf(field), permissions = emptySet())
+        assertTrue(CapabilityIssueCode.FIELD_NEEDS_PERMISSION in codes(noPermission))
+        assertTrue(CapabilityIssueCode.FIELD_NEEDS_PERMISSION !in codes(manifest(inputs = listOf(field))))
+    }
+
+    @Test
+    fun `a closed list of paths is refused`() {
+        val field = FieldSpec("target", FieldType.PATH, allowedValues = listOf("/workspace/a.kt"))
+        assertTrue(CapabilityIssueCode.FIELD_NEEDS_PERMISSION in codes(manifest(inputs = listOf(field))))
+    }
+
+    @Test
+    fun `duplicate and malformed field names are reported`() {
+        val inputs = listOf(FieldSpec("mode", FieldType.STRING), FieldSpec("mode", FieldType.STRING))
+        assertTrue(CapabilityIssueCode.DUPLICATE_FIELD in codes(manifest(inputs = inputs)))
+
+        val bad = listOf(FieldSpec("2mode", FieldType.STRING))
+        assertTrue(CapabilityIssueCode.INVALID_FIELD_NAME in codes(manifest(inputs = bad)))
+    }
+
+    @Test
+    fun `limits above the hard cap are refused`() {
+        val huge = CapabilityLimits(maxDurationMs = CapabilityLimits.HARD_CAPS.maxDurationMs + 1)
+        assertTrue(CapabilityIssueCode.LIMITS_ABOVE_HARD_CAP in codes(manifest(limits = huge)))
+    }
+
+    @Test
+    fun `a workflow has to name registered tools`() {
+        assertTrue(CapabilityIssueCode.WORKFLOW_HAS_NO_TOOLS in codes(manifest(toolIds = emptyList())))
+        assertTrue(CapabilityIssueCode.UNKNOWN_TOOL in codes(manifest(toolIds = listOf("not_a_tool"))))
+    }
+
+    @Test
+    fun `a non-bundled capability is flagged as unreviewed`() {
+        val codes = codes(manifest(source = CapabilitySource.WORKSPACE_FILE))
+        assertTrue(CapabilityIssueCode.UNTRUSTED_SOURCE in codes)
+    }
+
+    @Test
+    fun `a core change cannot arrive as data`() {
+        val codes = codes(manifest(kind = CapabilityKind.CORE_CHANGE, source = CapabilitySource.REMOTE_SERVER))
+        assertTrue(CapabilityIssueCode.CORE_CHANGE_CANNOT_BE_INSTALLED in codes)
+    }
+
+    @Test
+    fun `a capability with no declared tests is refused`() {
+        assertTrue(CapabilityIssueCode.NO_REQUIRED_TESTS in codes(manifest(testIds = emptyList())))
+    }
+
+    @Test
+    fun `an empty description or name is refused`() {
+        assertTrue(CapabilityIssueCode.EMPTY_DESCRIPTION in codes(manifest(description = "  ")))
+        assertTrue(CapabilityIssueCode.INVALID_NAME in codes(manifest(name = "")))
+    }
+}
