@@ -0,0 +1,202 @@
+package com.yugahashimoto.andcode.core.capability
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CapabilityRegistryTest {
+    private val context =
+        CapabilityValidationContext(
+            appVersion = SemVer(1, 2, 27),
+            registeredToolIds = setOf("read_file", "write_file"),
+        )
+    private val granted = setOf(CapabilityPermission.READ_PROJECT_FILES)
+
+    private fun manifest(
+        id: String = "andcode.release-notes",
+        source: CapabilitySource = CapabilitySource.BUNDLED,
+        permissions: Set<CapabilityPermission> = setOf(CapabilityPermission.READ_PROJECT_FILES),
+        testIds: List<String> = listOf("works-on-sample-repo"),
+    ) = CapabilityManifest(
+        id = id,
+        name = "Release notes",
+        version = SemVer(1, 0, 0),
+        kind = CapabilityKind.WORKFLOW,
+        source = source,
+        description = "summarises what changed",
+        minimumAppVersion = SemVer(1, 0, 0),
+        permissions = permissions,
+        dependencies = CapabilityDependencies(toolIds = listOf("read_file")),
+        requiredTestIds = testIds,
+    )
+
+    /** Draft + validate + test, the three steps every capability needs before it can be enabled. */
+    private fun prepared(
+        registry: CapabilityRegistry,
+        m: CapabilityManifest = manifest(),
+    ): CapabilityRegistry {
+        assertTrue(registry.draft(m, context).accepted)
+        assertTrue(registry.validate(m.id, context).accepted)
+        val evidence = CapabilityTestEvidence(passedTestIds = m.requiredTestIds.toSet(), ranAtMs = 1)
+        assertTrue(registry.recordTests(m.id, evidence).accepted)
+        return registry
+    }
+
+    @Test
+    fun `a capability cannot be enabled straight from a draft`() {
+        val registry = CapabilityRegistry()
+        registry.draft(manifest(), context)
+        val result = registry.enable("andcode.release-notes", granted)
+        assertEquals(CapabilityRejection.STATE_NOT_ALLOWED, (result as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `the full path reaches enabled and runnable`() {
+        val registry = prepared(CapabilityRegistry())
+        val result = registry.enable("andcode.release-notes", granted)
+
+        assertTrue(result.accepted)
+        assertEquals(CapabilityState.ENABLED, (result as CapabilityResult.Success).capability.state)
+        assertEquals(listOf("andcode.release-notes"), registry.runnable().map { it.manifest.id })
+        assertTrue(registry.events().any { it.to == CapabilityState.ENABLED })
+    }
+
+    @Test
+    fun `declared tests are required before enabling`() {
+        val registry = CapabilityRegistry()
+        registry.draft(manifest(), context)
+        registry.validate("andcode.release-notes", context)
+
+        val result = registry.enable("andcode.release-notes", granted)
+        assertEquals(CapabilityRejection.STATE_NOT_ALLOWED, (result as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `a failing test run keeps the capability out of service`() {
+        val registry = CapabilityRegistry()
+        val m = manifest()
+        registry.draft(m, context)
+        registry.validate(m.id, context)
+
+        val evidence = CapabilityTestEvidence(failedTestIds = setOf("works-on-sample-repo"), ranAtMs = 1)
+        val result = registry.recordTests(m.id, evidence)
+        assertEquals(CapabilityRejection.TESTS_NOT_PASSED, (result as CapabilityResult.Rejected).reason)
+        assertEquals(CapabilityState.VALIDATED, registry.get(m.id)?.state)
+    }
+
+    @Test
+    fun `a permission the user did not grant blocks the enable`() {
+        val registry = prepared(CapabilityRegistry())
+        val result = registry.enable("andcode.release-notes", grantedPermissions = emptySet())
+
+        assertEquals(CapabilityRejection.PERMISSION_NOT_GRANTED, (result as CapabilityResult.Rejected).reason)
+        assertTrue(registry.runnable().isEmpty())
+    }
+
+    @Test
+    fun `a non-bundled capability needs an explicit review`() {
+        val registry = prepared(CapabilityRegistry(), manifest(source = CapabilitySource.WORKSPACE_FILE))
+        val blocked = registry.enable("andcode.release-notes", granted)
+        assertEquals(CapabilityRejection.UNTRUSTED_SOURCE, (blocked as CapabilityResult.Rejected).reason)
+
+        registry.review("andcode.release-notes")
+        assertTrue(registry.enable("andcode.release-notes", granted).accepted)
+    }
+
+    @Test
+    fun `validation issues block the enable even after tests`() {
+        val registry = CapabilityRegistry()
+        // A workflow naming a tool this app does not have: draft stores it with the issue attached.
+        val broken = manifest().copy(dependencies = CapabilityDependencies(toolIds = listOf("ghost_tool")))
+        registry.draft(broken, context)
+        val validateResult = registry.validate(broken.id, context)
+
+        assertTrue((validateResult as CapabilityResult.Success).capability.issues.isNotEmpty())
+        assertEquals(CapabilityState.DRAFT, registry.get(broken.id)?.state)
+        val result = registry.enable(broken.id, granted)
+        assertEquals(CapabilityRejection.STATE_NOT_ALLOWED, (result as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `disabling stops it running and enabling again works`() {
+        val registry = prepared(CapabilityRegistry())
+        registry.enable("andcode.release-notes", granted)
+
+        assertTrue(registry.disable("andcode.release-notes").accepted)
+        assertTrue(registry.runnable().isEmpty())
+
+        assertTrue(registry.enable("andcode.release-notes", granted).accepted)
+        assertEquals(1, registry.runnable().size)
+    }
+
+    @Test
+    fun `revoking is final`() {
+        val registry = prepared(CapabilityRegistry())
+        registry.enable("andcode.release-notes", granted)
+        assertTrue(registry.revoke("andcode.release-notes").accepted)
+
+        val result = registry.enable("andcode.release-notes", granted)
+        assertEquals(CapabilityRejection.REVOKED, (result as CapabilityResult.Rejected).reason)
+        assertTrue(registry.runnable().isEmpty())
+    }
+
+    @Test
+    fun `a revoking of an unknown capability is reported not thrown`() {
+        val result = CapabilityRegistry().revoke("andcode.missing")
+        assertEquals(CapabilityRejection.UNKNOWN_CAPABILITY, (result as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `a duplicate draft is refused`() {
+        val registry = CapabilityRegistry()
+        registry.draft(manifest(), context)
+        val again = registry.draft(manifest(), context)
+        assertEquals(CapabilityRejection.STATE_NOT_ALLOWED, (again as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `the capability count is bounded`() {
+        val registry = CapabilityRegistry(maxCapabilities = 1)
+        registry.draft(manifest(), context)
+        val second = registry.draft(manifest(id = "andcode.second"), context)
+        assertEquals(CapabilityRejection.STATE_NOT_ALLOWED, (second as CapabilityResult.Rejected).reason)
+    }
+
+    @Test
+    fun `only enabled capabilities are exposed as runnable`() {
+        val registry = CapabilityRegistry()
+        registry.draft(manifest(id = "andcode.a"), context)
+        registry.draft(manifest(id = "andcode.b"), context)
+        prepared(registry, manifest(id = "andcode.c"))
+        registry.enable("andcode.c", granted)
+
+        assertEquals(listOf("andcode.c"), registry.runnable().map { it.manifest.id })
+        assertEquals(3, registry.snapshot().size)
+    }
+
+    @Test
+    fun `every transition is recorded with the actor`() {
+        val registry = CapabilityRegistry()
+        registry.draft(manifest(), context)
+        registry.validate("andcode.release-notes", context)
+
+        val states = registry.events().map { it.to }
+        assertEquals(listOf(CapabilityState.DRAFT, CapabilityState.VALIDATED), states)
+        assertTrue(registry.events().all { it.capabilityId == "andcode.release-notes" })
+        assertFalse(registry.events().any { it.actor.isBlank() })
+    }
+
+    @Test
+    fun `a forbidden permission never becomes an enabled capability`() {
+        val registry = CapabilityRegistry()
+        val hostile = manifest(permissions = setOf(CapabilityPermission.DISABLE_POLICY))
+        registry.draft(hostile, context)
+        registry.validate(hostile.id, context)
+        registry.recordTests(hostile.id, CapabilityTestEvidence(passedTestIds = setOf("works-on-sample-repo")))
+
+        val result = registry.enable(hostile.id, granted + CapabilityPermission.DISABLE_POLICY)
+        assertFalse(result.accepted)
+        assertTrue(registry.runnable().isEmpty())
+    }
+}
