+package com.yugahashimoto.andcode.core.task
+
+import com.yugahashimoto.andcode.core.buildcheck.CheckCommand
+import com.yugahashimoto.andcode.core.buildcheck.CheckResult
+import com.yugahashimoto.andcode.core.buildcheck.FailureClass
+import com.yugahashimoto.andcode.core.policy.InMemoryPolicyAuditLog
+import com.yugahashimoto.andcode.core.policy.OperationKind
+import com.yugahashimoto.andcode.core.policy.PolicyConfig
+import com.yugahashimoto.andcode.core.policy.PolicyDecision
+import com.yugahashimoto.andcode.core.policy.PolicyOperation
+import com.yugahashimoto.andcode.core.policy.RiskAssessment
+import com.yugahashimoto.andcode.core.policy.RiskEngine
+import com.yugahashimoto.andcode.core.policy.RiskLevel
+
+/** One step of a plan: what it says it does, and the operation the policy engine judges. */
+data class PlannedStep(
+    val id: String,
+    val title: String,
+    val operation: PolicyOperation,
+    /**
+     * Whether repeating it after an interruption is safe. Writing, deleting, pushing, releasing and running
+     * a command are all treated as unsafe to repeat, because the previous attempt may already have landed.
+     */
+    val sideEffecting: Boolean = operation.kind in DEFAULT_SIDE_EFFECTING,
+) {
+    companion object {
+        val DEFAULT_SIDE_EFFECTING =
+            setOf(
+                OperationKind.WRITE_FILE,
+                OperationKind.DELETE_FILE,
+                OperationKind.RUN_COMMAND,
+                OperationKind.VCS_PUSH,
+                OperationKind.RELEASE,
+                OperationKind.DEVICE_FLASH,
+                OperationKind.INSTALL_DEPENDENCY,
+                OperationKind.POLICY_OVERRIDE,
+            )
+    }
+}
+
+/** What happened when a step was actually attempted. */
+sealed interface StepOutcome {
+    data object Succeeded : StepOutcome
+
+    data class Failed(
+        val message: String,
+        val retryable: Boolean = false,
+    ) : StepOutcome
+}
+
+/** What the user is being asked to approve, with everything needed to decide. */
+data class ApprovalRequest(
+    val taskId: String,
+    val title: String,
+    val level: RiskLevel,
+    val reasons: List<String>,
+)
+
+/**
+ * Everything the runner needs from the outside world.
+ *
+ * Deliberately a set of functions rather than a concrete service: the orchestration stays pure and unit
+ * testable with fakes, and this is the seam where the Android implementation (real approvals, the runtime's
+ * tool calls, the terminal's process runner) plugs in without `core` depending on Android.
+ */
+interface TaskPorts {
+    /** Asks the user. Returning false means "do not run this", and the runner stops the task. */
+    fun approve(request: ApprovalRequest): Boolean
+
+    /** Runs one step. Called only after the policy engine allowed it and, if needed, the user approved. */
+    fun execute(step: PlannedStep): StepOutcome
+
+    /** Runs one bounded check command and returns its classified result. */
+    fun runCheck(command: CheckCommand): CheckResult
+}
+
+/** A task to run: the request text, the plan, and the checks that have to pass before it counts. */
+data class TaskRequest(
+    val id: String,
+    val description: String,
+    val plan: List<PlannedStep>,
+    val checks: List<CheckCommand> = emptyList(),
+    /** True when the change only fully takes effect with a new build (Kotlin, Gradle, manifest). */
+    val requiresNewApk: Boolean = false,
+)
+
+/** Result of a run: where the task ended up, the report for the user, and the risk verdicts taken. */
+data class TaskRun(
+    val progress: TaskProgress,
+    val report: TaskReport,
+    val resumed: Boolean,
+    val assessments: List<RiskAssessment>,
+)
+
+/**
+ * Drives one task through its lifecycle, and is the only thing that decides what the user is told.
+ *
+ * It uses the rules built in the earlier slices, in the order the task document asks for: assess with
+ * `core/policy` → ask if needed → execute → verify with `core/buildcheck` → report. Nothing here trusts a
+ * step's claim of success: the verdict comes from [TaskReportBuilder], which answers VERIFIED only when the
+ * required checks actually ran and passed.
+ *
+ * Limits are enforced here rather than by the caller: attempts, wall clock, and - via [TaskResume] - the
+ * rule that an interrupted side-effecting step is never repeated without confirmation.
+ */
+class TaskRunner(
+    private val ports: TaskPorts,
+    private val config: PolicyConfig = PolicyConfig(),
+    private val limits: TaskLimits = TaskLimits(),
+    private val audit: InMemoryPolicyAuditLog = InMemoryPolicyAuditLog(),
+    private val clock: () -> Long = { System.currentTimeMillis() },
+) {
+    fun run(
+        request: TaskRequest,
+        previous: TaskProgress? = null,
+    ): TaskRun {
+        val startedAt = clock()
+        val resumed = previous != null
+        if (previous == null) return drive(request, freshProgress(request, startedAt), startedAt, resumed = false)
+
+        val progress = previous
+        val plan = TaskResume.plan(progress, startedAt, limits)
+        if (plan is ResumePlan.Blocked) {
+            return finish(
+                request = request,
+                progress = progress,
+                startedAt = startedAt,
+                resumed = true,
+                assessments = emptyList(),
+                refused = false,
+                cancelled = false,
+                limitations = listOf("cannot resume: ${plan.detail}"),
+            )
+        }
+        val confirmed = confirmSideEffects(request, progress, plan as ResumePlan.Resumable)
+        val begun = TaskResume.begin(confirmed, plan)
+        if (!begun.resumed) {
+            return finish(
+            request,
+            confirmed,
+            startedAt,
+            resumed = true,
+            assessments = emptyList(),
+            refused = false,
+            cancelled = false,
+            limitations = listOf("task is not in a resumable state"),
+        )
+        }
+        return drive(request, begun.progress, startedAt, resumed = true)
+    }
+
+    /** Plans, assesses, asks, executes and verifies - or stops at the first thing that says no. */
+    private fun drive(
+        request: TaskRequest,
+        start: TaskProgress,
+        startedAt: Long,
+        resumed: Boolean,
+    ): TaskRun {
+        if (request.plan.isEmpty()) {
+            return finish(
+                request, start, startedAt, resumed, emptyList(), refused = false, cancelled = false,
+                limitations = listOf("the plan has no steps, so there is nothing to verify"),
+            )
+        }
+        var progress = start
+        if (progress.state == TaskState.DRAFT) {
+            progress = advance(progress, TaskState.INSPECTING, TaskFacts()) ?: return unstarted(request, progress, startedAt, resumed)
+            progress = advance(progress, TaskState.PLANNED, TaskFacts()) ?: return unstarted(request, progress, startedAt, resumed)
+        }
+
+        val assessments =
+            request.plan.map { step ->
+                RiskEngine.assess(step.operation, config).also { audit.record(step.operation, it) }
+            }
+        if (assessments.any { it.decision == PolicyDecision.DENY }) {
+            return finish(request, progress.copy(state = TaskState.FAILED), startedAt, resumed, assessments, true, false)
+        }
+
+        if (progress.state == TaskState.PLANNED) {
+            if (assessments.any { it.requiresAttention }) {
+                progress = advance(progress, TaskState.AWAITING_APPROVAL, TaskFacts())
+                    ?: return unstarted(request, progress, startedAt, resumed)
+                if (!ports.approve(approvalFor(request, assessments))) {
+                    return finish(request, progress.copy(state = TaskState.CANCELLED), startedAt, resumed, assessments, false, true)
+                }
+            }
+            progress = advance(progress, TaskState.READY, TaskFacts(approved = true))
+                ?: return unstarted(request, progress, startedAt, resumed)
+            progress = advance(progress, TaskState.RUNNING, TaskFacts(approved = true))
+                ?: return unstarted(request, progress, startedAt, resumed)
+        }
+        if (progress.state != TaskState.RUNNING) return unstarted(request, progress, startedAt, resumed)
+
+        val executed = executeSteps(request, progress, startedAt, resumed, assessments)
+        if (executed.terminal != null) return executed.terminal
+        return verify(request, executed.progress, startedAt, resumed, assessments)
+    }
+
+    private data class ExecutionStage(
+        val progress: TaskProgress,
+        val terminal: TaskRun?,
+    )
+
+    private fun executeSteps(
+        request: TaskRequest,
+        start: TaskProgress,
+        startedAt: Long,
+        resumed: Boolean,
+        assessments: List<RiskAssessment>,
+    ): ExecutionStage {
+        var progress = start
+        var attempts = progress.attempts
+        for (step in request.plan) {
+            val current = progress.steps.firstOrNull { it.id == step.id }
+            if (current == null || current.state == StepState.DONE || current.state == StepState.SKIPPED) continue
+            if (clock() - progress.startedAtMs > limits.maxWallClockMs) {
+                val expired = failedProgress(progress, step.id, "wall clock budget exhausted")
+                val terminal =
+                    finish(
+                        request,
+                        expired,
+                        startedAt,
+                        resumed,
+                        assessments,
+                        refused = false,
+                        cancelled = false,
+                        timeExhausted = true,
+                    )
+                return ExecutionStage(expired, terminal)
+            }
+            val outcome = attempt(step, progress, budget = limits.maxAttempts)
+            attempts += outcome.attemptsUsed
+            progress = outcome.progress.copy(attempts = attempts)
+            if (outcome.failure != null) {
+                val state = progress.copy(state = TaskState.FAILED)
+                return ExecutionStage(
+                    state,
+                    finish(
+                        request,
+                        state,
+                        startedAt,
+                        resumed,
+                        assessments,
+                        refused = false,
+                        cancelled = false,
+                        retryExhausted = outcome.failure.retryable,
+                    ),
+                )
+            }
+        }
+        return ExecutionStage(progress, null)
+    }
+
+    private data class AttemptResult(
+        val progress: TaskProgress,
+        val failure: StepOutcome.Failed?,
+        val attemptsUsed: Int,
+    )
+
+    /** Executes one step until it succeeds, fails for good, or the retry budget is gone. */
+    private fun attempt(
+        step: PlannedStep,
+        start: TaskProgress,
+        budget: Int,
+    ): AttemptResult {
+        var progress = start
+        var spent = 0
+        while (spent < budget) {
+            spent++
+            progress =
+                progress.withStep(
+                    progress.step(step.id).copy(state = StepState.RUNNING, attempts = spent, startedAtMs = clock(), failure = null),
+                )
+            when (val outcome = ports.execute(step)) {
+                is StepOutcome.Succeeded -> {
+                    progress = progress.withStep(progress.step(step.id).copy(state = StepState.DONE, finishedAtMs = clock()))
+                    return AttemptResult(progress, null, spent)
+                }
+                is StepOutcome.Failed -> {
+                    progress = progress.withStep(
+                        progress.step(step.id).copy(state = StepState.FAILED, failure = outcome.message, finishedAtMs = clock()),
+                    )
+                    if (!outcome.retryable) return AttemptResult(progress, outcome, spent)
+                }
+            }
+        }
+        // Every attempt exhausted the budget, so the run is reported as a retry exhaustion rather than as a
+        // plain failure: a retry *could* have helped, we simply were not allowed another one.
+        return AttemptResult(progress, StepOutcome.Failed("retry budget exhausted", retryable = true), spent)
+    }
+
+    private fun verify(
+        request: TaskRequest,
+        start: TaskProgress,
+        startedAt: Long,
+        resumed: Boolean,
+        assessments: List<RiskAssessment>,
+    ): TaskRun {
+        val verifying = advance(start, TaskState.VERIFYING, TaskFacts(approved = true))
+            ?: return unstarted(request, start, startedAt, resumed)
+        val results = request.checks.map { ports.runCheck(it) }
+        val green = results.isNotEmpty() && results.all { it.passed }
+        val facts = TaskFacts(approved = true, checksGreen = green)
+        val next =
+            advance(verifying, if (green) TaskState.CHECKS_PASSED else TaskState.FAILED, facts)
+                ?: verifying.copy(state = TaskState.FAILED)
+        val limitations =
+            results
+                .filter { !it.passed && it.failure == FailureClass.ENVIRONMENT }
+                .map { "${it.command.display} could not run in this environment: ${it.failureEvidence ?: "no detail"}" }
+        return finish(
+            request = request,
+            progress = next,
+            startedAt = startedAt,
+            resumed = resumed,
+            assessments = assessments,
+            refused = false,
+            cancelled = false,
+            limitations = limitations,
+            checkResults = results,
+        )
+    }
+
+    /**
+     * Asks about every interrupted side-effecting step. Confirming means "it did not land, run it again";
+     * declining means "assume it landed", and the step is skipped instead of repeated.
+     */
+    private fun confirmSideEffects(
+        request: TaskRequest,
+        progress: TaskProgress,
+        plan: ResumePlan.Resumable,
+    ): TaskProgress {
+        var current = progress
+        for (stepId in plan.stepsNeedingConfirmation) {
+            val approved =
+                ports.approve(
+                    ApprovalRequest(
+                        taskId = request.id,
+                        title = "step '$stepId' was running when the task stopped",
+                        level = RiskLevel.HIGH,
+                        reasons = listOf("it may already have taken effect; confirm before it runs again"),
+                    ),
+                )
+            current = if (approved) TaskResume.confirmSideEffect(current, stepId) else TaskResume.abandonSideEffect(current, stepId)
+        }
+        return current
+    }
+
+    private fun TaskProgress.step(id: String): TaskStep = steps.first { it.id == id }
+
+    private fun advance(
+        progress: TaskProgress,
+        to: TaskState,
+        facts: TaskFacts,
+    ): TaskProgress? =
+        if (TaskStateMachine.transition(progress.state, to, facts) is TransitionResult.Allowed) {
+            progress.copy(state = to)
+        } else {
+            null
+        }
+
+    private fun approvalFor(
+        request: TaskRequest,
+        assessments: List<RiskAssessment>,
+    ): ApprovalRequest {
+        val worst = RiskLevel.worstOf(assessments.map { it.level })
+        val reasons =
+            request.plan.zip(assessments)
+                .flatMap { (step, assessment) -> assessment.reasons.map { "${step.id}: ${it.code.name} - ${it.detail}" } }
+                .distinct()
+                .take(MAX_APPROVAL_REASONS)
+        return ApprovalRequest(request.id, request.description, worst, reasons)
+    }
+
+    private fun freshProgress(
+        request: TaskRequest,
+        startedAt: Long,
+    ): TaskProgress =
+        TaskProgress(
+            state = TaskState.DRAFT,
+            steps = request.plan.map { TaskStep(it.id, sideEffecting = it.sideEffecting) },
+            startedAtMs = startedAt,
+        )
+
+    private fun failedProgress(
+        progress: TaskProgress,
+        stepId: String,
+        message: String,
+    ): TaskProgress {
+        val step = progress.steps.firstOrNull { it.id == stepId } ?: return progress
+        return progress.copy(
+            state = TaskState.FAILED,
+            steps = progress.steps.map { if (it.id == stepId) step.copy(state = StepState.FAILED, failure = message) else it },
+        )
+    }
+
+    /** The state machine refused a transition. Reported instead of thrown, so the user sees it. */
+    private fun unstarted(
+        request: TaskRequest,
+        progress: TaskProgress,
+        startedAt: Long,
+        resumed: Boolean,
+    ) = finish(
+        request = request,
+        progress = progress,
+        startedAt = startedAt,
+        resumed = resumed,
+        assessments = emptyList(),
+        refused = false,
+        cancelled = false,
+        limitations = listOf("the task could not move out of ${progress.state.name}"),
+    )
+
+    private fun finish(
+        request: TaskRequest,
+        progress: TaskProgress,
+        startedAt: Long,
+        resumed: Boolean,
+        assessments: List<RiskAssessment>,
+        refused: Boolean,
+        cancelled: Boolean,
+        limitations: List<String> = emptyList(),
+        checkResults: List<CheckResult> = emptyList(),
+        timeExhausted: Boolean = false,
+        retryExhausted: Boolean = false,
+    ): TaskRun {
+        val records =
+            request.plan.map { step ->
+                val state = progress.steps.firstOrNull { it.id == step.id }
+                StepRecord(
+                    stepId = step.id,
+                    title = step.title,
+                    state = state?.state ?: StepState.PENDING,
+                    paths = step.operation.paths,
+                    failure = state?.failure,
+                    attempts = state?.attempts ?: 0,
+                )
+            }
+        val report =
+            TaskReportBuilder.build(
+                TaskReportInput(
+                    taskId = request.id,
+                    request = request.description,
+                    state = progress.state,
+                    steps = records,
+                    checks = checkResults,
+                    policyDecisions = audit.snapshot(),
+                    coreChange = request.requiresNewApk,
+                    limitations = limitations,
+                    cancelledByUser = cancelled,
+                    refusedByPolicy = refused,
+                    timeBudgetExhausted = timeExhausted,
+                    retryBudgetExhausted = retryExhausted,
+                    durationMs = clock() - startedAt,
+                ),
+            )
+        return TaskRun(progress, report, resumed, assessments)
+    }
+
+    private companion object {
+        const val MAX_APPROVAL_REASONS = 8
+    }
+}
