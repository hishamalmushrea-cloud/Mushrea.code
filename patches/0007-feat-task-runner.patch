+package com.yugahashimoto.andcode.core.task
+
+import com.yugahashimoto.andcode.core.buildcheck.CheckCategory
+import com.yugahashimoto.andcode.core.buildcheck.CheckCommand
+import com.yugahashimoto.andcode.core.buildcheck.CheckResult
+import com.yugahashimoto.andcode.core.buildcheck.FailureClass
+import com.yugahashimoto.andcode.core.buildcheck.FailureClassifier
+import com.yugahashimoto.andcode.core.policy.OperationKind
+import com.yugahashimoto.andcode.core.policy.InMemoryPolicyAuditLog
+import com.yugahashimoto.andcode.core.policy.PolicyConfig
+import com.yugahashimoto.andcode.core.policy.PolicyOperation
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TaskRunnerTest {
+    private var now = 1_000_000L
+    private val clock = { now }
+
+    private val unitTest =
+        CheckCommand("test", "./gradlew", listOf("test"), CheckCategory.UNIT_TEST)
+
+    private fun readStep(id: String = "read", path: String = "/workspace/app/A.kt") =
+        PlannedStep(id, "read A.kt", PolicyOperation(tool = "read", kind = OperationKind.READ_FILE, paths = listOf(path)))
+
+    private fun editStep(id: String = "edit") =
+        PlannedStep(
+            id,
+            "edit A.kt",
+            PolicyOperation(tool = "edit", kind = OperationKind.WRITE_FILE, paths = listOf("/workspace/app/A.kt")),
+        )
+
+    private fun shellStep(id: String = "shell", command: String = "./gradlew test") =
+        PlannedStep(id, "run $command", PolicyOperation(tool = "bash", kind = OperationKind.RUN_COMMAND, command = command))
+
+    /** Records what the runner asked, so tests can assert on the conversation with the user. */
+    private class FakePorts(
+        private val approval: Boolean = true,
+        private val outcomes: List<StepOutcome> = emptyList(),
+        private val checkResult: (CheckCommand) -> CheckResult = { command ->
+            FailureClassifier.result(command, 0, false, "BUILD SUCCESSFUL")
+        },
+    ) : TaskPorts {
+        val approvals = mutableListOf<ApprovalRequest>()
+        val executed = mutableListOf<String>()
+        private var outcomeIndex = 0
+
+        override fun approve(request: ApprovalRequest): Boolean {
+            approvals += request
+            return approval
+        }
+
+        override fun execute(step: PlannedStep): StepOutcome {
+            executed += step.id
+            val outcome = outcomes.getOrNull(outcomeIndex) ?: StepOutcome.Succeeded
+            outcomeIndex++
+            return outcome
+        }
+
+        override fun runCheck(command: CheckCommand): CheckResult = checkResult(command)
+    }
+
+    @Test
+    fun `a clean plan with passing checks is verified`() {
+        val ports = FakePorts()
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "add a helper", listOf(editStep()), listOf(unitTest)))
+
+        assertEquals(TaskState.CHECKS_PASSED, run.progress.state)
+        assertEquals(TaskVerdict.VERIFIED, run.report.verdict)
+        assertEquals(listOf("edit"), ports.executed)
+        assertEquals(emptyList<Any>(), run.report.caveats)
+        assertTrue(run.report.render().contains("VERIFIED"))
+    }
+
+    @Test
+    fun `a workspace edit needs no approval but a shell command does`() {
+        val editPorts = FakePorts()
+        TaskRunner(editPorts, clock = clock).run(TaskRequest("t1", "edit", listOf(editStep()), listOf(unitTest)))
+        assertTrue(editPorts.approvals.isEmpty())
+
+        val shellPorts = FakePorts()
+        TaskRunner(shellPorts, clock = clock).run(TaskRequest("t2", "run", listOf(shellStep()), listOf(unitTest)))
+        assertEquals(1, shellPorts.approvals.size)
+        assertTrue(shellPorts.approvals.single().reasons.any { it.contains("shell") })
+    }
+
+    @Test
+    fun `refusing the approval cancels instead of running anything`() {
+        val ports = FakePorts(approval = false)
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "run", listOf(shellStep()), listOf(unitTest)))
+
+        assertEquals(TaskState.CANCELLED, run.progress.state)
+        assertEquals(TaskVerdict.CANCELLED, run.report.verdict)
+        assertTrue(ports.executed.isEmpty())
+    }
+
+    @Test
+    fun `a denied operation never executes and is reported as refused`() {
+        val ports = FakePorts()
+        val destructive = shellStep("wipe", "rm -rf /")
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "wipe", listOf(destructive), listOf(unitTest)))
+
+        assertEquals(TaskState.FAILED, run.progress.state)
+        assertEquals(TaskVerdict.CANCELLED, run.report.verdict)
+        assertTrue(run.report.caveats.contains(ReportCaveat.REFUSED_BY_POLICY))
+        assertTrue(ports.executed.isEmpty())
+        assertTrue(ports.approvals.isEmpty())
+    }
+
+    @Test
+    fun `a failing step stops the task and never claims success`() {
+        val ports = FakePorts(outcomes = listOf(StepOutcome.Failed("compile broke")))
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "edit", listOf(editStep()), listOf(unitTest)))
+
+        assertEquals(TaskState.FAILED, run.progress.state)
+        assertEquals(TaskVerdict.FAILED, run.report.verdict)
+        assertEquals("compile broke", run.report.steps.single().failure)
+    }
+
+    @Test
+    fun `a retryable failure is retried within the budget and then succeeds`() {
+        val ports = FakePorts(outcomes = listOf(StepOutcome.Failed("flaky", retryable = true), StepOutcome.Succeeded))
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "run", listOf(shellStep()), listOf(unitTest)))
+
+        assertEquals(TaskState.CHECKS_PASSED, run.progress.state)
+        assertEquals(listOf("shell", "shell"), ports.executed)
+        assertEquals(2, run.report.steps.single().attempts)
+    }
+
+    @Test
+    fun `a retry budget that runs out fails the task with the retry caveat`() {
+        val ports = FakePorts(outcomes = List(5) { StepOutcome.Failed("still flaky", retryable = true) })
+        val run = TaskRunner(ports, clock = clock, limits = TaskLimits(maxAttempts = 2)).run(
+            TaskRequest("t1", "run", listOf(shellStep()), listOf(unitTest)),
+        )
+
+        assertEquals(TaskState.FAILED, run.progress.state)
+        assertTrue(run.report.caveats.contains(ReportCaveat.RETRY_BUDGET_EXHAUSTED))
+        assertEquals(2, ports.executed.size)
+    }
+
+    @Test
+    fun `a check that fails makes the verdict FAILED even though the steps ran`() {
+        val ports =
+            FakePorts(
+                checkResult = { command -> FailureClassifier.result(command, 1, false, "There were failing tests.") },
+            )
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "edit", listOf(editStep()), listOf(unitTest)))
+
+        assertEquals(TaskState.FAILED, run.progress.state)
+        assertEquals(TaskVerdict.FAILED, run.report.verdict)
+        assertEquals(FailureClass.TEST, run.report.failedChecks.single().failure)
+    }
+
+    @Test
+    fun `a plan with no checks is never verified`() {
+        val ports = FakePorts()
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "edit", listOf(editStep()), checks = emptyList()))
+
+        assertEquals(TaskVerdict.NOT_VERIFIED, run.report.verdict)
+        assertTrue(run.report.caveats.contains(ReportCaveat.NO_CHECKS_RUN))
+    }
+
+    @Test
+    fun `a check blocked by the environment is reported as a limitation, not as broken code`() {
+        val ports =
+            FakePorts(
+                checkResult = { command ->
+                    FailureClassifier.result(command, 1, false, "SDK location not found. Define ANDROID_HOME")
+                },
+            )
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "edit", listOf(editStep()), listOf(unitTest)))
+
+        assertEquals(FailureClass.ENVIRONMENT, run.report.failedChecks.single().failure)
+        assertTrue(run.report.caveats.contains(ReportCaveat.CHECK_NOT_RUN_FOR_FAILURE_CLASS))
+        assertTrue(run.report.limitations.single().contains("could not run in this environment"))
+    }
+
+    @Test
+    fun `the wall clock budget stops the run`() {
+        val ports = FakePorts()
+        var ticks = 0
+        val slowClock = {
+            ticks++
+            now + if (ticks > 2) TaskLimits.DEFAULT_MAX_WALL_CLOCK_MS + 1 else 0
+        }
+        val run = TaskRunner(ports, clock = slowClock).run(
+            TaskRequest("t1", "edit", listOf(editStep(), editStep("edit2")), listOf(unitTest)),
+        )
+
+        assertEquals(TaskState.FAILED, run.progress.state)
+        assertTrue(run.report.caveats.contains(ReportCaveat.TIME_BUDGET_EXHAUSTED))
+    }
+
+    @Test
+    fun `the report lists changed paths, decisions and whether a new apk is needed`() {
+        val ports = FakePorts()
+        val run = TaskRunner(ports, clock = clock).run(
+            TaskRequest("t1", "edit", listOf(editStep()), listOf(unitTest), requiresNewApk = true),
+        )
+
+        assertEquals(listOf("/workspace/app/A.kt"), run.report.changedPaths)
+        assertTrue(run.report.needsNewApk)
+        assertEquals(1, run.report.policyDecisions.size)
+        assertTrue(run.report.render().contains("new apk needed: yes"))
+    }
+
+    @Test
+    fun `resuming a paused task re-runs only the open steps`() {
+        val ports = FakePorts()
+        val paused =
+            TaskProgress(
+                state = TaskState.PAUSED,
+                steps =
+                    listOf(
+                        TaskStep("edit", StepState.DONE, sideEffecting = true, finishedAtMs = now),
+                        TaskStep("edit2", StepState.PENDING, sideEffecting = true),
+                    ),
+                startedAtMs = now,
+            )
+        val run = TaskRunner(ports, clock = clock).run(
+            TaskRequest("t1", "edit", listOf(editStep("edit"), editStep("edit2")), listOf(unitTest)),
+            previous = paused,
+        )
+
+        assertTrue(run.resumed)
+        assertEquals(listOf("edit2"), ports.executed)
+        assertEquals(TaskVerdict.VERIFIED, run.report.verdict)
+    }
+
+    @Test
+    fun `resuming never silently repeats an interrupted side effect`() {
+        val ports = FakePorts(approval = false)
+        val interrupted =
+            TaskProgress(
+                state = TaskState.RUNNING,
+                steps = listOf(TaskStep("edit", StepState.RUNNING, sideEffecting = true)),
+                startedAtMs = now,
+            )
+        val run = TaskRunner(ports, clock = clock).run(
+            TaskRequest("t1", "edit", listOf(editStep("edit")), listOf(unitTest)),
+            previous = interrupted,
+        )
+
+        // The user declined, so the step is skipped rather than run again; it was asked about explicitly.
+        assertTrue(ports.approvals.single().title.contains("was running when the task stopped"))
+        assertTrue(ports.executed.isEmpty())
+        assertEquals(StepState.SKIPPED, run.progress.steps.single().state)
+    }
+
+    @Test
+    fun `a terminal task cannot be resumed`() {
+        val ports = FakePorts()
+        val shipped = TaskProgress(state = TaskState.SHIPPED, steps = listOf(TaskStep("edit")), startedAtMs = now)
+        val run = TaskRunner(ports, clock = clock).run(
+            TaskRequest("t1", "edit", listOf(editStep("edit")), listOf(unitTest)),
+            previous = shipped,
+        )
+
+        assertFalse(run.resumed && run.progress.state == TaskState.CHECKS_PASSED)
+        assertTrue(ports.executed.isEmpty())
+        assertEquals(TaskState.SHIPPED, run.progress.state)
+        assertTrue(run.report.limitations.single().startsWith("cannot resume"))
+    }
+
+    @Test
+    fun `every assessed operation is written to the audit trail`() {
+        val audit = InMemoryPolicyAuditLog()
+        val ports = FakePorts()
+        TaskRunner(ports, clock = clock, audit = audit).run(
+            TaskRequest("t1", "edit", listOf(editStep(), shellStep()), listOf(unitTest)),
+        )
+        assertEquals(2, audit.size)
+        assertTrue(audit.snapshot().all { it.actor.startsWith("agent:") })
+    }
+
+    @Test
+    fun `a permissive config still cannot auto approve a denial`() {
+        val ports = FakePorts()
+        val run = TaskRunner(ports, config = PolicyConfig.permissive(), clock = clock).run(
+            TaskRequest("t1", "wipe", listOf(shellStep("wipe", "rm -rf /")), listOf(unitTest)),
+        )
+        assertEquals(TaskVerdict.CANCELLED, run.report.verdict)
+        assertTrue(ports.executed.isEmpty())
+    }
+
+    @Test
+    fun `an empty plan is reported as not verified rather than done`() {
+        val ports = FakePorts()
+        val run = TaskRunner(ports, clock = clock).run(TaskRequest("t1", "nothing", emptyList(), listOf(unitTest)))
+        assertEquals(TaskVerdict.NOT_VERIFIED, run.report.verdict)
+    }
+}
