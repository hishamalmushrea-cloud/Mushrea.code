@@ -0,0 +1,140 @@
+package com.yugahashimoto.andcode.core.task
+
+import com.yugahashimoto.andcode.core.buildcheck.CheckCategory
+import com.yugahashimoto.andcode.core.buildcheck.CheckCommand
+import com.yugahashimoto.andcode.core.buildcheck.FailureClass
+import com.yugahashimoto.andcode.core.buildcheck.FailureClassifier
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TaskReportBuilderTest {
+    private val command = CheckCommand("test", "./gradlew", listOf("test"), CheckCategory.UNIT_TEST)
+    private val passing = FailureClassifier.result(command, 0, false, "BUILD SUCCESSFUL")
+    private val failing = FailureClassifier.result(command, 1, false, "There were failing tests.")
+    private val blocked = FailureClassifier.result(command, 1, false, "SDK location not found. Define ANDROID_HOME")
+
+    private fun input(
+        state: TaskState = TaskState.CHECKS_PASSED,
+        steps: List<StepRecord> = listOf(StepRecord("edit", "edit A.kt", StepState.DONE)),
+        checks: List<com.yugahashimoto.andcode.core.buildcheck.CheckResult> = listOf(passing),
+        cancelled: Boolean = false,
+        refused: Boolean = false,
+    ) = TaskReportInput(
+        taskId = "t1",
+        request = "add a helper",
+        state = state,
+        steps = steps,
+        checks = checks,
+        cancelledByUser = cancelled,
+        refusedByPolicy = refused,
+        durationMs = 1_500,
+    )
+
+    @Test
+    fun `green checks in a success state are verified`() {
+        assertEquals(TaskVerdict.VERIFIED, TaskReportBuilder.build(input()).verdict)
+    }
+
+    @Test
+    fun `each success-looking state counts only with green checks`() {
+        for (state in listOf(TaskState.CHECKS_PASSED, TaskState.READY_FOR_REVIEW, TaskState.READY_TO_SHIP, TaskState.SHIPPED)) {
+            assertEquals("$state", TaskVerdict.VERIFIED, TaskReportBuilder.build(input(state = state)).verdict)
+            val withoutChecks = TaskReportBuilder.build(input(state = state, checks = emptyList()))
+            assertEquals("$state without checks", TaskVerdict.NOT_VERIFIED, withoutChecks.verdict)
+        }
+    }
+
+    @Test
+    fun `a state short of the success states is not verified even with green checks`() {
+        assertEquals(TaskVerdict.NOT_VERIFIED, TaskReportBuilder.build(input(state = TaskState.RUNNING)).verdict)
+        assertEquals(TaskVerdict.NOT_VERIFIED, TaskReportBuilder.build(input(state = TaskState.AWAITING_APPROVAL)).verdict)
+    }
+
+    @Test
+    fun `no checks means not verified, with a caveat that says so`() {
+        val report = TaskReportBuilder.build(input(checks = emptyList()))
+        assertEquals(TaskVerdict.NOT_VERIFIED, report.verdict)
+        assertTrue(report.caveats.contains(ReportCaveat.NO_CHECKS_RUN))
+        assertTrue(report.caveatLines().any { it.contains("no checks were run") })
+    }
+
+    @Test
+    fun `a failed step is a failure even if the checks passed`() {
+        val steps = listOf(StepRecord("edit", "edit A.kt", StepState.FAILED, failure = "compile broke"))
+        val report = TaskReportBuilder.build(input(steps = steps))
+        assertEquals(TaskVerdict.FAILED, report.verdict)
+        assertTrue(report.caveats.contains(ReportCaveat.STEP_FAILED))
+    }
+
+    @Test
+    fun `a failed check is a failure and names the check`() {
+        val report = TaskReportBuilder.build(input(state = TaskState.FAILED, checks = listOf(passing, failing)))
+        assertEquals(TaskVerdict.FAILED, report.verdict)
+        assertEquals(1, report.failedChecks.size)
+        assertEquals(FailureClass.TEST, report.failedChecks.single().failure)
+        assertTrue(report.render().contains("FAIL"))
+    }
+
+    @Test
+    fun `a check the environment could not run is not called broken code`() {
+        val report = TaskReportBuilder.build(input(state = TaskState.FAILED, checks = listOf(blocked)))
+        assertTrue(report.caveats.contains(ReportCaveat.CHECK_NOT_RUN_FOR_FAILURE_CLASS))
+        assertTrue(report.caveatLines().any { it.contains("could not run in this environment") })
+    }
+
+    @Test
+    fun `cancellation wins over everything else`() {
+        val report = TaskReportBuilder.build(input(state = TaskState.CANCELLED, cancelled = true, checks = emptyList()))
+        assertEquals(TaskVerdict.CANCELLED, report.verdict)
+        assertTrue(report.caveats.contains(ReportCaveat.CANCELLED_BY_USER))
+        assertFalse(report.caveats.contains(ReportCaveat.NO_CHECKS_RUN))
+    }
+
+    @Test
+    fun `a policy refusal is reported as cancelled with the policy caveat`() {
+        val report = TaskReportBuilder.build(input(state = TaskState.FAILED, refused = true))
+        assertEquals(TaskVerdict.CANCELLED, report.verdict)
+        assertTrue(report.caveats.contains(ReportCaveat.REFUSED_BY_POLICY))
+    }
+
+    @Test
+    fun `changed paths are deduplicated and sorted`() {
+        val steps =
+            listOf(
+                StepRecord("a", "a", StepState.DONE, paths = listOf("/workspace/b.kt", "/workspace/a.kt")),
+                StepRecord("b", "b", StepState.DONE, paths = listOf("/workspace/a.kt")),
+            )
+        val report = TaskReportBuilder.build(input(steps = steps))
+        assertEquals(listOf("/workspace/a.kt", "/workspace/b.kt"), report.changedPaths)
+    }
+
+    @Test
+    fun `the render is a complete, readable report`() {
+        val report =
+            TaskReportBuilder.build(
+                input().copy(memoryFactIds = listOf("modules.chat"), limitations = listOf("no emulator available")),
+            )
+        val text = report.render()
+        assertTrue(text.startsWith("task t1: CHECKS_PASSED / VERIFIED"))
+        assertTrue(text.contains("request: add a helper"))
+        assertTrue(text.contains("duration: 1500ms"))
+        assertTrue(text.contains("memory facts recorded: modules.chat"))
+        assertTrue(text.contains("limitations:"))
+        assertTrue(text.contains("no emulator available"))
+    }
+
+    @Test
+    fun `a report with a caveat renders the not-verified section`() {
+        val text = TaskReportBuilder.build(input(checks = emptyList())).render()
+        assertTrue(text.contains("not verified:"))
+        assertTrue(text.contains("nothing is proven"))
+    }
+
+    @Test
+    fun `needs new apk follows the caller's classification`() {
+        assertTrue(TaskReportBuilder.build(input().copy(coreChange = true)).needsNewApk)
+        assertFalse(TaskReportBuilder.build(input()).needsNewApk)
+    }
+}
