+package com.yugahashimoto.andcode.core.task
+
+import com.yugahashimoto.andcode.core.buildcheck.CheckResult
+import com.yugahashimoto.andcode.core.buildcheck.FailureClass
+import com.yugahashimoto.andcode.core.policy.PolicyAuditEntry
+
+/** What actually happened to one step, as recorded for the report. */
+data class StepRecord(
+    val stepId: String,
+    val title: String,
+    val state: StepState,
+    /** Paths the step said it would touch, if any. */
+    val paths: List<String> = emptyList(),
+    /** Reason a failed step gave, already redacted by the policy layer. */
+    val failure: String? = null,
+    val attempts: Int = 0,
+)
+
+/**
+ * The verdict, which is not the same thing as the state.
+ *
+ * [VERIFIED] is the only value that means "the required checks ran and passed". A task that reached a
+ * success-looking state without running its checks is [NOT_VERIFIED], and the report says why - this is the
+ * rule from the task's rules: never show "completed successfully" when an acceptance condition failed or a
+ * required test did not run.
+ */
+enum class TaskVerdict {
+    /** Finished and every required check ran green. */
+    VERIFIED,
+
+    /** Finished, but something is missing or unproven: no checks, or checks that were not run. */
+    NOT_VERIFIED,
+
+    /** A step or a check failed. */
+    FAILED,
+
+    /** The user cancelled, or the task was refused by policy. */
+    CANCELLED,
+}
+
+/** Why a verdict is not [TaskVerdict.VERIFIED]. Shown to the user, so it has to be specific. */
+enum class ReportCaveat {
+    NO_CHECKS_RUN,
+    CHECK_FAILED,
+    CHECK_NOT_RUN_FOR_FAILURE_CLASS,
+    STEP_FAILED,
+    CANCELLED_BY_USER,
+    REFUSED_BY_POLICY,
+    TIME_BUDGET_EXHAUSTED,
+    RETRY_BUDGET_EXHAUSTED,
+    TASK_NOT_FINISHED,
+}
+
+/**
+ * The end-of-task report the task document requires (section 4.4): request, plan, files, checks and their
+ * results, what failed, the risk decisions taken, whether a new APK is needed, and what was not verified.
+ *
+ * Built by [TaskReportBuilder] from facts the runner already produced. It is data, not prose: every field is
+ * something the app observed, and [render] is a convenience view, not the source of truth.
+ */
+data class TaskReport(
+    val taskId: String,
+    val request: String,
+    val state: TaskState,
+    val verdict: TaskVerdict,
+    val steps: List<StepRecord>,
+    val checks: List<CheckResult>,
+    val policyDecisions: List<PolicyAuditEntry>,
+    val memoryFactIds: List<String>,
+    val caveats: List<ReportCaveat>,
+    val limitations: List<String>,
+    /** True when the work cannot take effect without installing a new build. */
+    val needsNewApk: Boolean,
+    val durationMs: Long,
+) {
+    val changedPaths: List<String> get() = steps.flatMap { it.paths }.distinct().sorted()
+
+    val failedChecks: List<CheckResult> get() = checks.filterNot { it.passed }
+
+    /** One line per caveat, in the order they were found. */
+    fun caveatLines(): List<String> =
+        caveats.map { caveat ->
+            when (caveat) {
+                ReportCaveat.NO_CHECKS_RUN -> "no checks were run, so nothing is proven about this change"
+                ReportCaveat.CHECK_FAILED -> "a required check failed"
+                ReportCaveat.CHECK_NOT_RUN_FOR_FAILURE_CLASS -> "a check could not run in this environment"
+                ReportCaveat.STEP_FAILED -> "a step failed"
+                ReportCaveat.CANCELLED_BY_USER -> "the user cancelled the task"
+                ReportCaveat.REFUSED_BY_POLICY -> "the policy engine refused part of the plan"
+                ReportCaveat.TIME_BUDGET_EXHAUSTED -> "the time budget ran out"
+                ReportCaveat.RETRY_BUDGET_EXHAUSTED -> "the retry budget ran out"
+                ReportCaveat.TASK_NOT_FINISHED -> "the task has not reached a verified state"
+            }
+        }
+
+    /** Plain-text rendering for a bug report, a PR body or the task screen's export action. */
+    fun render(): String =
+        buildString {
+            appendLine("task ${taskId}: ${state.name} / ${verdict.name}")
+            appendLine("request: $request")
+            appendLine("duration: ${durationMs}ms, new apk needed: ${if (needsNewApk) "yes" else "no"}")
+            appendLine("steps:")
+            steps.forEach { step ->
+                appendLine("  - ${step.stepId} [${step.state.name}] ${step.title}")
+                if (step.failure != null) appendLine("      failure: ${step.failure}")
+            }
+            appendLine("changed paths: ${if (changedPaths.isEmpty()) "none" else changedPaths.joinToString(", ")}")
+            appendLine("checks:")
+            if (checks.isEmpty()) appendLine("  - none")
+            checks.forEach { check ->
+                val outcome =
+                    when {
+                        check.passed -> "PASS"
+                        check.timedOut -> "TIMEOUT"
+                        else -> "${check.failure.name} exit=${check.exitCode}"
+                    }
+                appendLine("  - ${check.command.display}: $outcome")
+                check.failureEvidence?.let { appendLine("      $it") }
+            }
+            appendLine("policy decisions: ${if (policyDecisions.isEmpty()) "none" else policyDecisions.size.toString()}")
+            policyDecisions.forEach { appendLine("  - ${it.level.name}/${it.decision.name} ${it.codes.joinToString(",")}") }
+            if (memoryFactIds.isNotEmpty()) appendLine("memory facts recorded: ${memoryFactIds.joinToString(", ")}")
+            if (caveatLines().isNotEmpty()) {
+                appendLine("not verified:")
+                caveatLines().forEach { appendLine("  - $it") }
+            }
+            if (limitations.isNotEmpty()) {
+                appendLine("limitations:")
+                limitations.forEach { appendLine("  - $it") }
+            }
+        }.trimEnd()
+}
+
+/** Everything the report is built from. The runner fills this in as it goes. */
+data class TaskReportInput(
+    val taskId: String,
+    val request: String,
+    val state: TaskState,
+    val steps: List<StepRecord>,
+    val checks: List<CheckResult>,
+    val policyDecisions: List<PolicyAuditEntry> = emptyList(),
+    val memoryFactIds: List<String> = emptyList(),
+    /** The plan touched Kotlin, Gradle, the manifest or something the runner could not classify. */
+    val coreChange: Boolean = false,
+    /** Reasons a step or check could not run at all - missing toolchain, no device, and so on. */
+    val limitations: List<String> = emptyList(),
+    val cancelledByUser: Boolean = false,
+    val refusedByPolicy: Boolean = false,
+    val timeBudgetExhausted: Boolean = false,
+    val retryBudgetExhausted: Boolean = false,
+    val durationMs: Long = 0,
+)
+
+/**
+ * Turns the runner's notes into a [TaskReport] with a verdict that cannot be talked up.
+ *
+ * The rules, in order, and they are deliberately pessimistic:
+ * 1. cancelled or refused → `CANCELLED`;
+ * 2. any failed step or failed check → `FAILED`;
+ * 3. no checks at all → `NOT_VERIFIED` (with `NO_CHECKS_RUN`);
+ * 4. a check that never ran because the environment could not run it → `NOT_VERIFIED`;
+ * 5. a state that is not one of the success states → `NOT_VERIFIED`;
+ * 6. only then → `VERIFIED`.
+ */
+object TaskReportBuilder {
+    private val VERIFIED_STATES =
+        setOf(
+            TaskState.CHECKS_PASSED,
+            TaskState.READY_FOR_REVIEW,
+            TaskState.READY_TO_SHIP,
+            TaskState.SHIPPED,
+        )
+
+    fun build(input: TaskReportInput): TaskReport {
+        val caveats = mutableListOf<ReportCaveat>()
+        if (input.cancelledByUser) caveats += ReportCaveat.CANCELLED_BY_USER
+        if (input.refusedByPolicy) caveats += ReportCaveat.REFUSED_BY_POLICY
+        if (input.timeBudgetExhausted) caveats += ReportCaveat.TIME_BUDGET_EXHAUSTED
+        if (input.retryBudgetExhausted) caveats += ReportCaveat.RETRY_BUDGET_EXHAUSTED
+        if (input.steps.any { it.state == StepState.FAILED }) caveats += ReportCaveat.STEP_FAILED
+        if (input.checks.any { !it.passed }) caveats += ReportCaveat.CHECK_FAILED
+        if (input.checks.isEmpty() && input.state != TaskState.CANCELLED) caveats += ReportCaveat.NO_CHECKS_RUN
+        if (input.checks.any { !it.passed && it.failure == FailureClass.ENVIRONMENT }) {
+            caveats += ReportCaveat.CHECK_NOT_RUN_FOR_FAILURE_CLASS
+        }
+        if (input.state == TaskState.CANCELLED && input.checks.isEmpty()) {
+            caveats -= ReportCaveat.NO_CHECKS_RUN
+        }
+
+        val verdict = decide(input, caveats)
+        if (verdict == TaskVerdict.NOT_VERIFIED && ReportCaveat.TASK_NOT_FINISHED !in caveats) {
+            caveats += ReportCaveat.TASK_NOT_FINISHED
+        }
+        return TaskReport(
+            taskId = input.taskId,
+            request = input.request,
+            state = input.state,
+            verdict = verdict,
+            steps = input.steps,
+            checks = input.checks,
+            policyDecisions = input.policyDecisions,
+            memoryFactIds = input.memoryFactIds,
+            caveats = caveats.distinct(),
+            limitations = input.limitations,
+            needsNewApk = input.coreChange,
+            durationMs = input.durationMs,
+        )
+    }
+
+    private fun decide(
+        input: TaskReportInput,
+        caveats: List<ReportCaveat>,
+    ): TaskVerdict =
+        when {
+            ReportCaveat.CANCELLED_BY_USER in caveats || ReportCaveat.REFUSED_BY_POLICY in caveats -> TaskVerdict.CANCELLED
+            ReportCaveat.STEP_FAILED in caveats || ReportCaveat.CHECK_FAILED in caveats -> TaskVerdict.FAILED
+            ReportCaveat.NO_CHECKS_RUN in caveats -> TaskVerdict.NOT_VERIFIED
+            ReportCaveat.CHECK_NOT_RUN_FOR_FAILURE_CLASS in caveats -> TaskVerdict.NOT_VERIFIED
+            input.state !in VERIFIED_STATES -> TaskVerdict.NOT_VERIFIED
+            else -> TaskVerdict.VERIFIED
+        }
+}
