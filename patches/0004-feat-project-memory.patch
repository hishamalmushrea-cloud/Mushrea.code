@@ -0,0 +1,135 @@
+package com.yugahashimoto.andcode.core.memory
+
+/**
+ * Where a fact came from, which decides how much it can be trusted before it is used again.
+ *
+ * The ordering matters more than the list: a fact read out of the source tree today outranks anything a
+ * model wrote about that tree in a previous session, and the task is explicit that a summary is not a
+ * substitute for checking the current source.
+ */
+enum class FactSource {
+    /** Read from the checked-out source. Re-cheap to re-verify, so it ages quickly but safely. */
+    SOURCE_CODE,
+
+    /** Produced by an actual build or test run. */
+    BUILD_OUTPUT,
+
+    /** Stated by the user. */
+    USER,
+
+    /** Documented in a tracked file (README, ADR, this repo's docs). Reviewable in Git. */
+    REPO_DOC,
+
+    /**
+     * Written by an agent from memory or summary. Never treated as verified on its own - it is a hint
+     * that says "look here", not an answer.
+     */
+    AGENT_SUMMARY,
+    ;
+
+    /** Only these can be trusted without a fresh look at the code. */
+    val selfVerifying: Boolean get() = this != AGENT_SUMMARY
+}
+
+/** What the fact is about, so retrieval can be scoped instead of dumping everything. */
+enum class FactKind {
+    MODULE_MAP,
+    DEPENDENCY,
+    BUILD_COMMAND,
+    TEST_COMMAND,
+    ARCHITECTURE_DECISION,
+    KNOWN_ISSUE,
+    CONSTRAINT,
+    RECENT_CHANGE,
+    FEATURE_STATUS,
+}
+
+/**
+ * One engineering fact about the project.
+ *
+ * [commitRef] and [recordedAtMs] are both kept: the commit says *what* the fact was true of, the clock
+ * says how long ago that was. A fact with neither cannot be judged, so [record] refuses it.
+ */
+data class MemoryFact(
+    val id: String,
+    val kind: FactKind,
+    val source: FactSource,
+    val text: String,
+    val recordedAtMs: Long,
+    val commitRef: String? = null,
+    val verifiedAtMs: Long? = null,
+    /** Free-form tags used by retrieval; lowercased on construction. */
+    val tags: Set<String> = emptySet(),
+) {
+    val isVerified: Boolean get() = verifiedAtMs != null
+
+    /** True when this fact may be repeated to a user or used for a decision without checking again. */
+    fun trustedAt(
+        nowMs: Long,
+        currentCommit: String?,
+        maxAgeMs: Long,
+    ): Boolean {
+        if (source == FactSource.AGENT_SUMMARY) return false
+        if (currentCommit != null && commitRef != null && commitRef != currentCommit) return false
+        val verified = verifiedAtMs ?: return false
+        return nowMs - verified <= maxAgeMs
+    }
+}
+
+/** A fact as handed to the caller, with the reason it may not be usable yet. */
+data class RetrievedFact(
+    val fact: MemoryFact,
+    val needsVerification: Boolean,
+    val reason: String,
+) {
+    /** What to show: the text, plus a marker when it still has to be checked. */
+    fun render(): String = if (needsVerification) "${fact.text} [unverified: $reason]" else fact.text
+}
+
+/** Result of a retrieval: bounded, ranked, and explicit about what was left out. */
+data class MemoryRetrieval(
+    val facts: List<RetrievedFact>,
+    val omittedCount: Int,
+    val usedChars: Int,
+) {
+    val allVerified: Boolean get() = facts.none { it.needsVerification }
+}
+
+/** Why a fact was refused at write time. */
+enum class MemoryRejection {
+    /** The text matched a credential pattern; secrets never enter the project memory. */
+    CONTAINS_SECRET,
+
+    /** Longer than [MemoryLimits.maxFactChars]; a wall of text is not a fact. */
+    TOO_LONG,
+
+    /** Empty or blank. */
+    EMPTY,
+
+    /** Duplicate id with different content, so the caller has to decide explicitly. */
+    ID_CONFLICT,
+}
+
+/** Limits that keep the memory useful instead of becoming a second copy of the repo. */
+data class MemoryLimits(
+    val maxFacts: Int = DEFAULT_MAX_FACTS,
+    val maxFactChars: Int = DEFAULT_MAX_FACT_CHARS,
+    val maxRetrievalChars: Int = DEFAULT_MAX_RETRIEVAL_CHARS,
+    /** After this long, even a verified fact has to be looked at again. */
+    val maxAgeMs: Long = DEFAULT_MAX_AGE_MS,
+) {
+    init {
+        require(maxFacts > 0) { "maxFacts must be positive" }
+        require(maxFactChars > 0) { "maxFactChars must be positive" }
+        require(maxRetrievalChars > 0) { "maxRetrievalChars must be positive" }
+        require(maxAgeMs > 0) { "maxAgeMs must be positive" }
+    }
+
+    companion object {
+        const val DEFAULT_MAX_FACTS = 400
+        const val DEFAULT_MAX_FACT_CHARS = 400
+        const val DEFAULT_MAX_RETRIEVAL_CHARS = 4_000
+        /** Two weeks: long enough to be useful across sessions, short enough to be re-checked. */
+        const val DEFAULT_MAX_AGE_MS = 14L * 24L * 60L * 60L * 1000L
+    }
+}
