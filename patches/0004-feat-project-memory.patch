+package com.yugahashimoto.andcode.core.memory
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/** Outcome of writing a fact. */
+sealed interface MemoryWriteResult {
+    data class Stored(val fact: MemoryFact) : MemoryWriteResult
+
+    data class Rejected(
+        val reason: MemoryRejection,
+        val detail: String,
+    ) : MemoryWriteResult
+
+    val accepted: Boolean get() = this is Stored
+}
+
+/**
+ * The project's engineering memory.
+ *
+ * Three rules from the task are enforced here rather than hoped for:
+ *
+ * 1. **No secrets.** Every fact is screened before it is stored, using the same [SecretRedaction]
+ *    patterns the crash reporter uses; a fact whose text contains a credential is refused, not scrubbed,
+ *    because a partially redacted credential is still a leak waiting for the next regex gap.
+ * 2. **A summary is not the source.** Facts from [FactSource.AGENT_SUMMARY] are always returned as
+ *    unverified; facts from the code or a build are only trusted while their commit and age still match.
+ * 3. **Relevant context only.** [recall] ranks and truncates to a character budget instead of sending the
+ *    whole memory, and says how many facts it left out.
+ *
+ * In-memory for now: architectural knowledge that belongs in Git stays in Git, and the operational store
+ * is a separate change. Nothing here persists across process death yet.
+ */
+class ProjectMemory(
+    private val limits: MemoryLimits = MemoryLimits(),
+    private val clock: () -> Long = { System.currentTimeMillis() },
+) {
+    private val lock = Any()
+    private val facts = linkedMapOf<String, MemoryFact>()
+
+    /**
+     * Records a fact. Re-recording the same id with identical text refreshes its verification instead of
+     * duplicating it; different text under the same id is refused so the caller has to be explicit.
+     */
+    fun record(
+        id: String,
+        kind: FactKind,
+        source: FactSource,
+        text: String,
+        commitRef: String? = null,
+        tags: Set<String> = emptySet(),
+    ): MemoryWriteResult {
+        val trimmed = text.trim()
+        if (trimmed.isEmpty()) return MemoryWriteResult.Rejected(MemoryRejection.EMPTY, id)
+        if (trimmed.length > limits.maxFactChars) {
+            return MemoryWriteResult.Rejected(
+                MemoryRejection.TOO_LONG,
+                "${trimmed.length} > ${limits.maxFactChars} characters",
+            )
+        }
+        if (looksLikeSecret(trimmed)) {
+            // Deliberately silent about which pattern matched: saying so would echo the secret back.
+            return MemoryWriteResult.Rejected(MemoryRejection.CONTAINS_SECRET, "fact text contains a credential")
+        }
+
+        synchronized(lock) {
+            val existing = facts[id]
+            if (existing != null && existing.text != trimmed) {
+                return MemoryWriteResult.Rejected(MemoryRejection.ID_CONFLICT, "id '$id' already holds different text")
+            }
+            val now = clock()
+            val fact =
+                MemoryFact(
+                    id = id,
+                    kind = kind,
+                    source = source,
+                    text = trimmed,
+                    recordedAtMs = existing?.recordedAtMs ?: now,
+                    commitRef = commitRef ?: existing?.commitRef,
+                    verifiedAtMs = if (source.selfVerifying) now else null,
+                    tags = tags.map { it.lowercase() }.toSet(),
+                )
+            store(fact)
+            return MemoryWriteResult.Stored(fact)
+        }
+    }
+
+    /** Marks a fact as checked against the current source. The only way a summary becomes trusted. */
+    fun markVerified(
+        id: String,
+        currentCommit: String?,
+    ): MemoryWriteResult =
+        synchronized(lock) {
+            val existing = facts[id] ?: return MemoryWriteResult.Rejected(MemoryRejection.ID_CONFLICT, "unknown id '$id'")
+            val refreshed = existing.copy(verifiedAtMs = clock(), commitRef = currentCommit ?: existing.commitRef)
+            store(refreshed)
+            MemoryWriteResult.Stored(refreshed)
+        }
+
+    /** Returns a fact with its verdict, without going through ranking. */
+    fun get(
+        id: String,
+        nowMs: Long = clock(),
+        currentCommit: String? = null,
+    ): RetrievedFact? {
+        val fact = synchronized(lock) { facts[id] } ?: return null
+        return judge(fact, nowMs, currentCommit)
+    }
+
+    /**
+     * Selects the facts relevant to [query], best first, until the character budget runs out.
+     *
+     * Scoring is keyword overlap over the text and tags; a fact that matches nothing is only included when
+     * it is a `CONSTRAINT` (the rules an agent must not break are worth the space even when the query does
+     * not name them).
+     */
+    fun recall(
+        query: String,
+        kind: FactKind? = null,
+        nowMs: Long = clock(),
+        currentCommit: String? = null,
+    ): MemoryRetrieval {
+        val terms = tokenise(query)
+        val candidates =
+            synchronized(lock) {
+                facts.values.filter { kind == null || it.kind == kind }
+            }
+
+        val scored =
+            candidates.mapNotNull { fact ->
+                val score = score(fact, terms)
+                when {
+                    score > 0 -> fact to score
+                    fact.kind == FactKind.CONSTRAINT -> fact to 1
+                    else -> null
+                }
+            }.sortedWith(compareByDescending<Pair<MemoryFact, Int>> { it.second }.thenByDescending { it.first.verifiedAtMs ?: 0 })
+
+        val selected = mutableListOf<RetrievedFact>()
+        var used = 0
+        var omitted = 0
+        for ((fact, _) in scored) {
+            val candidate = judge(fact, nowMs, currentCommit)
+            val cost = candidate.fact.text.length
+            if (used + cost > limits.maxRetrievalChars) {
+                omitted++
+                continue
+            }
+            selected += candidate
+            used += cost
+        }
+        return MemoryRetrieval(selected, omitted + (candidates.size - scored.size), used)
+    }
+
+    fun size(): Int = synchronized(lock) { facts.size }
+
+    fun snapshot(): List<MemoryFact> = synchronized(lock) { facts.values.toList() }
+
+    /** Drops facts whose commit no longer matches or that are older than the limit. */
+    fun pruneStale(
+        currentCommit: String?,
+        nowMs: Long = clock(),
+    ): Int =
+        synchronized(lock) {
+            val before = facts.size
+            facts.entries.removeAll { (_, fact) ->
+                val wrongCommit = currentCommit != null && fact.commitRef != null && fact.commitRef != currentCommit
+                val tooOld = nowMs - (fact.verifiedAtMs ?: fact.recordedAtMs) > limits.maxAgeMs
+                wrongCommit || tooOld
+            }
+            before - facts.size
+        }
+
+    private fun store(fact: MemoryFact) {
+        facts[fact.id] = fact
+        // Oldest unverified facts go first: they are the least useful thing to keep.
+        while (facts.size > limits.maxFacts) {
+            val victim =
+                facts.values.minWithOrNull(
+                    compareBy<MemoryFact> { it.verifiedAtMs ?: it.recordedAtMs }.thenBy { it.id },
+                ) ?: break
+            facts.remove(victim.id)
+        }
+    }
+
+    private fun judge(
+        fact: MemoryFact,
+        nowMs: Long,
+        currentCommit: String?,
+    ): RetrievedFact =
+        when {
+            fact.source == FactSource.AGENT_SUMMARY && !fact.isVerified ->
+                RetrievedFact(fact, needsVerification = true, reason = "agent summary, not checked against the source")
+            fact.commitRef != null && currentCommit != null && fact.commitRef != currentCommit ->
+                RetrievedFact(
+                    fact,
+                    needsVerification = true,
+                    reason = "recorded at ${fact.commitRef.take(7)}, head is ${currentCommit.take(7)}",
+                )
+            fact.verifiedAtMs == null ->
+                RetrievedFact(fact, needsVerification = true, reason = "never verified")
+            nowMs - fact.verifiedAtMs > limits.maxAgeMs ->
+                RetrievedFact(
+                    fact,
+                    needsVerification = true,
+                    reason = "verified ${(nowMs - fact.verifiedAtMs) / DAY_MS} days ago",
+                )
+            else ->
+                RetrievedFact(
+                    fact,
+                    needsVerification = false,
+                    reason = "verified at ${fact.commitRef?.take(7) ?: "current head"}",
+                )
+        }
+
+    private fun score(
+        fact: MemoryFact,
+        terms: Set<String>,
+    ): Int {
+        if (terms.isEmpty()) return 0
+        val haystack = (fact.text + " " + fact.tags.joinToString(" ")).lowercase()
+        return terms.count { haystack.contains(it) }
+    }
+
+    private fun tokenise(query: String): Set<String> =
+        query.lowercase()
+            .split(NON_WORD)
+            .filter { it.length >= 3 && it !in STOP_WORDS }
+            .toSet()
+
+    private fun looksLikeSecret(text: String): Boolean {
+        // If redaction changes the text, something in it looked like a credential.
+        if (SecretRedaction.redact(text) != text) return true
+        return PRIVATE_KEY_HEADER.containsMatchIn(text)
+    }
+
+    private companion object {
+        const val DAY_MS = 24L * 60L * 60L * 1000L
+        val NON_WORD = Regex("[^a-z0-9_.\\-/]+")
+        val PRIVATE_KEY_HEADER = Regex("-----BEGIN [A-Z ]*PRIVATE KEY-----")
+        val STOP_WORDS = setOf("the", "and", "for", "with", "that", "this", "from", "what", "how", "why", "does", "are", "was")
+    }
+}
