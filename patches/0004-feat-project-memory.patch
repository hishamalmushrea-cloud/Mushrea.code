+package com.yugahashimoto.andcode.core.memory
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectMemoryTest {
+    private val now = 1_700_000_000_000L
+    private val head = "414c780abcdef"
+
+    private fun memory(limits: MemoryLimits = MemoryLimits()) = ProjectMemory(limits) { now }
+
+    private fun ProjectMemory.put(
+        id: String,
+        text: String,
+        kind: FactKind = FactKind.MODULE_MAP,
+        source: FactSource = FactSource.SOURCE_CODE,
+        commit: String? = head,
+        tags: Set<String> = emptySet(),
+    ) = record(id, kind, source, text, commit, tags)
+
+    @Test
+    fun `a fact read from source is verified immediately`() {
+        val memory = memory()
+        val stored = memory.put("modules.chat", "chat lives in feature/chat") as MemoryWriteResult.Stored
+        assertTrue(stored.fact.isVerified)
+
+        val retrieved = memory.get("modules.chat", now, head)!!
+        assertFalse(retrieved.needsVerification)
+    }
+
+    @Test
+    fun `an agent summary is never trusted on its own`() {
+        val memory = memory()
+        memory.put("mods", "the app is probably a single Gradle module", source = FactSource.AGENT_SUMMARY)
+
+        val retrieved = memory.get("mods", now, head)!!
+        assertTrue(retrieved.needsVerification)
+        assertTrue(retrieved.render().contains("unverified"))
+    }
+
+    @Test
+    fun `verifying a summary against the source makes it trusted`() {
+        val memory = memory()
+        memory.put("mods", "single Gradle module", source = FactSource.AGENT_SUMMARY)
+        memory.markVerified("mods", head)
+
+        assertFalse(memory.get("mods", now, head)!!.needsVerification)
+    }
+
+    @Test
+    fun `a fact recorded at another commit is stale`() {
+        val memory = memory()
+        memory.put("mods", "module layout", commit = "oldcommit")
+
+        val retrieved = memory.get("mods", now, head)!!
+        assertTrue(retrieved.needsVerification)
+        assertTrue(retrieved.reason.contains("head is"))
+    }
+
+    @Test
+    fun `an old verification is stale even at the same commit`() {
+        val memory = memory()
+        memory.put("mods", "module layout")
+        val later = now + MemoryLimits.DEFAULT_MAX_AGE_MS + 1
+
+        assertTrue(memory.get("mods", later, head)!!.needsVerification)
+    }
+
+    @Test
+    fun `a credential is refused instead of stored`() {
+        val memory = memory()
+        val result = memory.record("secret", FactKind.CONSTRAINT, FactSource.USER, "deploy uses sk-proj-abcdefghijklmnop")
+        assertEquals(MemoryRejection.CONTAINS_SECRET, (result as MemoryWriteResult.Rejected).reason)
+        assertEquals(0, memory.size())
+    }
+
+    @Test
+    fun `a private key block is refused`() {
+        val memory = memory()
+        val result = memory.record("key", FactKind.CONSTRAINT, FactSource.USER, "-----BEGIN RSA PRIVATE KEY-----")
+        assertEquals(MemoryRejection.CONTAINS_SECRET, (result as MemoryWriteResult.Rejected).reason)
+    }
+
+    @Test
+    fun `over long and empty facts are refused`() {
+        val memory = memory(MemoryLimits(maxFactChars = 20))
+        assertEquals(MemoryRejection.TOO_LONG, (memory.put("long", "x".repeat(21)) as MemoryWriteResult.Rejected).reason)
+        assertEquals(MemoryRejection.EMPTY, (memory.put("empty", "   ") as MemoryWriteResult.Rejected).reason)
+    }
+
+    @Test
+    fun `re-recording identical text refreshes, different text conflicts`() {
+        val memory = memory()
+        memory.put("mods", "single module")
+        assertTrue(memory.put("mods", "single module").accepted)
+
+        val conflict = memory.put("mods", "actually two modules")
+        assertEquals(MemoryRejection.ID_CONFLICT, (conflict as MemoryWriteResult.Rejected).reason)
+        assertEquals(1, memory.size())
+    }
+
+    @Test
+    fun `recall ranks by overlap and skips unrelated facts`() {
+        val memory = memory()
+        memory.put("chat", "chat streaming lives in ChatViewModel", tags = setOf("chat", "streaming"))
+        memory.put("build", "gradle wrapper is 8.9")
+        memory.put("rust", "no rust in this project")
+
+        val retrieval = memory.recall("how does chat streaming work", null, now, head)
+        assertEquals("chat", retrieval.facts.first().fact.id)
+        assertFalse(retrieval.facts.any { it.fact.id == "rust" })
+    }
+
+    @Test
+    fun `constraints are recalled even when the query does not name them`() {
+        val memory = memory()
+        memory.put("no-flutter", "never add Flutter or NDK", kind = FactKind.CONSTRAINT)
+
+        val retrieval = memory.recall("why does the build fail", null, now, head)
+        assertTrue(retrieval.facts.any { it.fact.id == "no-flutter" })
+    }
+
+    @Test
+    fun `recall respects the character budget and reports what it dropped`() {
+        val memory = memory(MemoryLimits(maxRetrievalChars = 40))
+        repeat(4) { index -> memory.put("fact$index", "gradle module $index detail") }
+
+        val retrieval = memory.recall("gradle module", null, now, head)
+        assertTrue(retrieval.usedChars <= 40)
+        assertTrue(retrieval.omittedCount > 0)
+    }
+
+    @Test
+    fun `pruning drops facts from another commit and keeps current ones`() {
+        val memory = memory()
+        memory.put("old", "from an old commit", commit = "old")
+        memory.put("new", "from head", commit = head)
+
+        assertEquals(1, memory.pruneStale(head, now))
+        assertEquals(listOf("new"), memory.snapshot().map { it.id })
+    }
+
+    @Test
+    fun `the store is bounded and drops the least recently verified`() {
+        val memory = memory(MemoryLimits(maxFacts = 2))
+        memory.put("a", "first fact")
+        memory.put("b", "second fact")
+        memory.put("c", "third fact")
+
+        assertEquals(2, memory.size())
+        assertFalse(memory.snapshot().any { it.id == "a" })
+    }
+
+    @Test
+    fun `recording is safe to call concurrently`() {
+        val memory = memory()
+        val threads =
+            (0 until 8).map { index ->
+                Thread { memory.put("f$index", "gradle detail $index") }
+            }
+        threads.forEach { it.start() }
+        threads.forEach { it.join() }
+
+        assertEquals(8, memory.size())
+    }
+}
