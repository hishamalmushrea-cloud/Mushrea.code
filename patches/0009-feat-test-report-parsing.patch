+package com.yugahashimoto.andcode.core.buildcheck
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TestReportParserTest {
+    private val junitXml =
+        """
+        <?xml version="1.0" encoding="UTF-8"?>
+        <testsuite name="com.example.FooTest" tests="3" skipped="1" failures="1" errors="0" time="0.2">
+          <testcase name="passes" classname="com.example.FooTest" time="0.01"/>
+          <testcase name="fails" classname="com.example.FooTest" time="0.02">
+            <failure message="expected:&lt;1&gt; but was:&lt;2&gt;">at FooTest.kt:12</failure>
+          </testcase>
+          <testcase name="skipped" classname="com.example.FooTest">
+            <skipped/>
+          </testcase>
+        </testsuite>
+        """.trimIndent()
+
+    @Test
+    fun `a JUnit XML report gives totals and names the failing test`() {
+        val report = TestReportParser.parse(junitXml)
+
+        assertEquals(TestReportSource.JUNIT_XML, report.source)
+        assertEquals(3, report.total)
+        assertEquals(1, report.passed)
+        assertEquals(1, report.failed)
+        assertEquals(1, report.skipped)
+        assertEquals(1, report.failures.size)
+        assertEquals("fails", report.failures[0].name)
+        assertEquals("com.example.FooTest > fails", report.failures[0].display)
+        assertFalse(report.countsDisagree)
+    }
+
+    @Test
+    fun `an XML failure message is unescaped so it reads like the assertion`() {
+        val message = TestReportParser.parse(junitXml).failures[0].message
+
+        assertEquals("expected:<1> but was:<2>", message)
+    }
+
+    @Test
+    fun `XML totals win when the output was cut and fewer cases survived`() {
+        val cut = junitXml.lines().take(5).joinToString("\n").replace("tests=\"3\"", "tests=\"9\"")
+
+        val report = TestReportParser.parse(cut)
+
+        assertEquals(9, report.total)
+        assertTrue(report.countsDisagree)
+    }
+
+    @Test
+    fun `an XML suite with no tests is evidence of zero tests, not a pass`() {
+        val report = TestReportParser.parse("""<testsuite name="X" tests="0" failures="0" errors="0" skipped="0"/>""")
+
+        assertEquals(TestReportSource.JUNIT_XML, report.source)
+        assertEquals(0, report.total)
+        assertFalse(report.isEmpty)
+        assertTrue(report.summaryLines().isNotEmpty())
+    }
+
+    @Test
+    fun `an XML error counts as a failure`() {
+        val xml =
+            """
+            <testsuite name="X" tests="2" failures="0" errors="1">
+              <testcase name="a" classname="X"/>
+              <testcase name="b" classname="X"><error message="boom"/></testcase>
+            </testsuite>
+            """.trimIndent()
+
+        val report = TestReportParser.parse(xml)
+
+        assertEquals(1, report.failed)
+        assertEquals("boom", report.failures[0].message)
+        assertFalse(report.countsDisagree)
+    }
+
+    @Test
+    fun `Gradle's per-test console lines are read with the first line of the trace`() {
+        val output =
+            """
+            com.example.FooTest > passes PASSED
+            com.example.FooTest > fails FAILED
+            	at FooTest.kt:12
+            	at Runner.kt:3
+            2 tests completed, 1 failed
+            """.trimIndent()
+
+        val report = TestReportParser.parse(output)
+
+        assertEquals(TestReportSource.GRADLE_CONSOLE, report.source)
+        assertEquals(2, report.total)
+        assertEquals(1, report.passed)
+        assertEquals(1, report.failed)
+        assertEquals("at FooTest.kt:12", report.failures[0].message)
+        assertFalse(report.countsDisagree)
+    }
+
+    @Test
+    fun `console lines without a summary still give honest totals`() {
+        val report = TestReportParser.parse("a.Test > one SKIPPED\na.Test > two PASSED")
+
+        assertEquals(2, report.total)
+        assertEquals(1, report.passed)
+        assertEquals(1, report.skipped)
+        assertEquals(0, report.failed)
+    }
+
+    @Test
+    fun `a summary line alone gives the counts but no names`() {
+        val report = TestReportParser.parse("12 tests completed, 2 failed, 1 skipped\nBUILD FAILED")
+
+        assertEquals(TestReportSource.SUMMARY_LINE, report.source)
+        assertEquals(12, report.total)
+        assertEquals(9, report.passed)
+        assertEquals(2, report.failed)
+        assertEquals(1, report.skipped)
+        assertTrue(report.failures.isEmpty())
+    }
+
+    @Test
+    fun `a failed-only summary is read as failures rather than inventing passes`() {
+        val report = TestReportParser.parse("2 tests failed")
+
+        assertEquals(2, report.total)
+        assertEquals(2, report.failed)
+        assertEquals(0, report.passed)
+    }
+
+    @Test
+    fun `a successful build with no test report claims nothing`() {
+        val report = TestReportParser.parse("BUILD SUCCESSFUL in 3s\n10 actionable tasks: 10 executed")
+
+        assertEquals(TestReportSource.NONE, report.source)
+        assertEquals(0, report.total)
+        assertTrue(report.isEmpty)
+        assertTrue(report.summaryLines().isEmpty())
+    }
+
+    @Test
+    fun `blank output is not a pass`() {
+        val report = TestReportParser.parse("   \n\n")
+
+        assertTrue(report.isEmpty)
+        assertEquals(0, report.total)
+    }
+
+    @Test
+    fun `a credential in a failure message never reaches the report`() {
+        val xml =
+            """
+            <testsuite name="X" tests="1" failures="1">
+              <testcase name="calls the api" classname="X">
+                <failure message="auth failed token=abcd1234secret"/>
+              </testcase>
+            </testsuite>
+            """.trimIndent()
+
+        val message = TestReportParser.parse(xml).failures[0].message.orEmpty()
+
+        assertFalse(message.contains("abcd1234secret"))
+        assertTrue(message.contains("<redacted>"))
+    }
+
+    @Test
+    fun `a stack trace is flattened into one bounded line`() {
+        val long = "boom ".repeat(400)
+        val xml = """<testsuite tests="1" failures="1"><testcase name="n"><failure message="$long"/></testcase></testsuite>"""
+
+        val message = TestReportParser.parse(xml).failures[0].message.orEmpty()
+
+        assertFalse(message.contains("\n"))
+        assertTrue(message.length <= TestReportParser.MAX_MESSAGE_LENGTH)
+    }
+
+    @Test
+    fun `a long test name is bounded so one report line cannot be unbounded`() {
+        val name = "n".repeat(300)
+        val xml = """<testsuite tests="1" failures="1"><testcase name="$name"><failure message="x"/></testcase></testsuite>"""
+
+        val parsed = TestReportParser.parse(xml).failures[0].name
+
+        assertEquals(200, parsed.length)
+    }
+
+    @Test
+    fun `the failure list is capped and says so`() {
+        val output = (1..60).joinToString("\n") { "a.Test > t$it FAILED" }
+
+        val report = TestReportParser.parse(output)
+
+        assertEquals(60, report.failed)
+        assertEquals(TestReportParser.MAX_FAILURES, report.failures.size)
+        assertTrue(report.failuresTruncated)
+        assertTrue(report.summaryLines().any { it.contains("only the first 50") })
+    }
+
+    @Test
+    fun `a truncated log tail is still parsed`() {
+        val filler = "noise ".repeat(TestReportParser.MAX_SCAN_CHARS / 6 + 100)
+        val output = filler + "\n" + "a.Test > t FAILED\n1 test completed, 1 failed"
+
+        val report = TestReportParser.parse(output)
+
+        assertEquals(TestReportSource.GRADLE_CONSOLE, report.source)
+        assertEquals(1, report.failed)
+    }
+
+    @Test
+    fun `a check carries its own report without re-running anything`() {
+        val command =
+            CheckCommand(
+                id = "jvm.test",
+                executable = "gradlew",
+                args = listOf("test"),
+                category = CheckCategory.UNIT_TEST,
+            )
+        val result =
+            CheckResult(
+                command = command,
+                exitCode = 1,
+                timedOut = false,
+                output = "a.Test > t FAILED\n1 test completed, 1 failed",
+                failure = FailureClass.TEST,
+                failureEvidence = null,
+            )
+
+        val report = result.testReport()
+
+        assertEquals(1, report.total)
+        assertEquals(1, report.failed)
+    }
+
+    @Test
+    fun `a passing check with no report is still no evidence`() {
+        val command = CheckCommand("node.test", "npm", listOf("test"), CheckCategory.UNIT_TEST)
+        val result =
+            CheckResult(
+                command = command,
+                exitCode = 0,
+                timedOut = false,
+                output = "ok",
+                failure = FailureClass.UNKNOWN,
+                failureEvidence = null,
+            )
+
+        assertTrue(result.testReport().isEmpty)
+        assertNull(result.testReport().failures.firstOrNull())
+    }
+}
