+package com.yugahashimoto.andcode.core.buildcheck
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/** How one test ended. */
+enum class TestStatus {
+    PASSED,
+    FAILED,
+    SKIPPED,
+}
+
+/** Where the numbers in a [TestReport] came from, so a reader knows how far to trust them. */
+enum class TestReportSource {
+    /** JUnit XML (Gradle writes it under `build/test-results/…`). The strongest evidence. */
+    JUNIT_XML,
+
+    /** The console lines Gradle prints per test (`com.example.FooTest > name FAILED`). */
+    GRADLE_CONSOLE,
+
+    /** Only a summary line (`12 tests completed, 2 failed`). The count is real, the names are not. */
+    SUMMARY_LINE,
+
+    /** Nothing recognisable in the output. Never read this as "everything passed". */
+    NONE,
+}
+
+/**
+ * One test, as the report names it. [message] is a redacted single line: a stack trace would fill the
+ * report and could carry captured values.
+ */
+data class TestCaseResult(
+    val name: String,
+    val suite: String? = null,
+    val status: TestStatus,
+    val message: String? = null,
+) {
+    /** `suite > name`, or just the name when the format does not name a suite. */
+    val display: String get() = if (suite.isNullOrBlank()) name else "$suite > $name"
+}
+
+/**
+ * Per-test results parsed out of a check's output.
+ *
+ * This exists because "the check failed" is not actionable: the report has to name the test that failed.
+ * Parsing is done here, in app code, from text the app already holds - nothing is executed and no test
+ * framework is linked in.
+ *
+ * Two rules keep the numbers honest:
+ * - [source] is [TestReportSource.NONE] when nothing was recognised, and [total] stays 0. A green exit code
+ *   with no recognisable report does not become "all tests passed".
+ * - When the declared totals (the `tests="…"` attribute, or the summary line) and the enumerated cases
+ *   disagree, [countsDisagree] is set. That happens on truncated output, and the reader is told rather than
+ *   shown a confident wrong number.
+ */
+data class TestReport(
+    val total: Int,
+    val passed: Int,
+    val failed: Int,
+    val skipped: Int,
+    /** Failed cases only, bounded by [TestReportParser.MAX_FAILURES]. */
+    val failures: List<TestCaseResult>,
+    val source: TestReportSource,
+    val countsDisagree: Boolean = false,
+    /** More tests failed than [failures] lists. */
+    val failuresTruncated: Boolean = false,
+) {
+    /** True when the parser found no test evidence at all. */
+    val isEmpty: Boolean get() = source == TestReportSource.NONE
+
+    val hasFailures: Boolean get() = failed > 0
+
+    /** One line per fact, for the task report. Empty for an [isEmpty] report. */
+    fun summaryLines(): List<String> {
+        if (isEmpty) return emptyList()
+        val lines = mutableListOf<String>()
+        lines += "$total tests: $passed passed, $failed failed, $skipped skipped (${source.name})"
+        failures.forEach { failure -> lines += "failed: ${failure.display}${failure.message?.let { " - $it" } ?: ""}" }
+        if (failuresTruncated) lines += "only the first ${failures.size} failures are listed"
+        if (countsDisagree) lines += "the declared totals disagree with the tests that could be read; output truncated?"
+        return lines
+    }
+}
+
+/**
+ * Reads JUnit XML, Gradle's per-test console lines, or a summary line out of a check's output.
+ *
+ * A hand-written scanner rather than an XML library: the input is already truncated to the tail of a log,
+ * may be cut mid-tag, and a real parser would throw on that instead of reporting what it could read. The
+ * scan is bounded ([MAX_SCAN_CHARS], [MAX_CASES]) because the input comes from a subprocess.
+ */
+object TestReportParser {
+    const val MAX_SCAN_CHARS = 512 * 1024
+    const val MAX_CASES = 5_000
+    const val MAX_FAILURES = 50
+    const val MAX_MESSAGE_LENGTH = 300
+
+    private val CONSOLE_LINE = Regex("""^(\S.*?)\s+>\s+(.+?)\s+(PASSED|FAILED|SKIPPED)\s*$""")
+
+    private val SUMMARY_COMPLETED =
+        Regex(
+            """(\d+)\s+tests?\s+completed(?:,\s*(\d+)\s+failed)?(?:,\s*(\d+)\s+skipped)?""",
+            RegexOption.IGNORE_CASE,
+        )
+    private val SUMMARY_FAILED = Regex("""(\d+)\s+tests?\s+failed""", RegexOption.IGNORE_CASE)
+
+    /** Parses whatever is recognisable. Never throws, never runs anything. */
+    fun parse(output: String): TestReport {
+        if (output.isBlank()) return empty()
+        val text = if (output.length > MAX_SCAN_CHARS) output.takeLast(MAX_SCAN_CHARS) else output
+        parseJUnitXml(text)?.let { return it }
+        parseConsole(text)?.let { return it }
+        return parseSummary(text) ?: empty()
+    }
+
+    private fun empty() =
+        TestReport(
+            total = 0,
+            passed = 0,
+            failed = 0,
+            skipped = 0,
+            failures = emptyList(),
+            source = TestReportSource.NONE,
+        )
+
+    // --- JUnit XML -------------------------------------------------------------------------------
+
+    private data class DeclaredTotals(
+        val total: Int,
+        val failed: Int,
+        val skipped: Int,
+    )
+
+    private fun parseJUnitXml(text: String): TestReport? {
+        if (!text.contains("<testcase") && !text.contains("<testsuite")) return null
+        val cases = mutableListOf<TestCaseResult>()
+        var cursor = text.indexOf("<testcase")
+        while (cursor >= 0 && cases.size < MAX_CASES) {
+            val tagEnd = text.indexOf('>', cursor)
+            if (tagEnd < 0) break
+            val attributes = text.substring(cursor + "<testcase".length, tagEnd)
+            val selfClosing = attributes.trimEnd().endsWith("/")
+            val name = cleanName(attribute(attributes, "name")) ?: "unnamed"
+            val suite = cleanName(attribute(attributes, "classname")) ?: cleanName(attribute(attributes, "class"))
+            var next = tagEnd + 1
+            var status = TestStatus.PASSED
+            var message: String? = null
+            if (!selfClosing) {
+                val close = text.indexOf("</testcase>", tagEnd)
+                val body = text.substring(tagEnd + 1, if (close >= 0) close else text.length)
+                if (close >= 0) next = close + "</testcase>".length
+                val failureTag = elementAttributes(body, "failure") ?: elementAttributes(body, "error")
+                when {
+                    failureTag != null -> {
+                        status = TestStatus.FAILED
+                        message = cleanMessage(attribute(failureTag, "message") ?: elementText(body, "failure"))
+                    }
+                    body.contains("<skipped") -> status = TestStatus.SKIPPED
+                }
+            }
+            cases += TestCaseResult(name = name, suite = suite, status = status, message = message)
+            cursor = text.indexOf("<testcase", next)
+        }
+        val declared = declaredTotals(text)
+        if (cases.isEmpty() && declared == null) return null
+
+        val enumeratedFailures = cases.filter { it.status == TestStatus.FAILED }
+        val unknownTail = cases.size >= MAX_CASES
+        val total = declared?.total ?: cases.size
+        val failed = declared?.failed ?: enumeratedFailures.size
+        val skipped = declared?.skipped ?: cases.count { it.status == TestStatus.SKIPPED }
+        val disagree =
+            declared != null &&
+                !unknownTail &&
+                (declared.total != cases.size || declared.failed != enumeratedFailures.size)
+        return TestReport(
+            total = total,
+            passed = (total - failed - skipped).coerceAtLeast(0),
+            failed = failed,
+            skipped = skipped,
+            failures = enumeratedFailures.take(MAX_FAILURES),
+            source = TestReportSource.JUNIT_XML,
+            countsDisagree = disagree,
+            failuresTruncated = enumeratedFailures.size > MAX_FAILURES,
+        )
+    }
+
+    private fun declaredTotals(text: String): DeclaredTotals? {
+        val attributes = elementAttributes(text, "testsuite") ?: return null
+        val total = attribute(attributes, "tests")?.toIntOrNull() ?: return null
+        val failures = attribute(attributes, "failures")?.toIntOrNull() ?: 0
+        val errors = attribute(attributes, "errors")?.toIntOrNull() ?: 0
+        val skipped =
+            (attribute(attributes, "skipped")?.toIntOrNull() ?: 0) +
+                (attribute(attributes, "disabled")?.toIntOrNull() ?: 0)
+        return DeclaredTotals(total = total, failed = failures + errors, skipped = skipped)
+    }
+
+    /** The attributes of the first `<name …>` after [from], or null when the element is absent. */
+    private fun elementAttributes(
+        text: String,
+        name: String,
+    ): String? {
+        val start = text.indexOf("<$name")
+        if (start < 0) return null
+        val end = text.indexOf('>', start)
+        if (end < 0) return null
+        return text.substring(start + name.length + 1, end)
+    }
+
+    /** The text of the first `<name …>…</name>`, unescaped and flattened. */
+    private fun elementText(
+        text: String,
+        name: String,
+    ): String? {
+        val start = text.indexOf("<$name")
+        if (start < 0) return null
+        val open = text.indexOf('>', start)
+        if (open < 0) return null
+        val close = text.indexOf("</$name>", open)
+        if (close < 0) return null
+        return text.substring(open + 1, close)
+    }
+
+    private fun attribute(
+        attributes: String,
+        name: String,
+    ): String? {
+        val match = Regex("""\b$name\s*=\s*"([^"]*)"""").find(attributes) ?: return null
+        return match.groupValues[1]
+    }
+
+    // --- Gradle console --------------------------------------------------------------------------
+
+    private fun parseConsole(text: String): TestReport? {
+        val lines = text.lines()
+        val cases = mutableListOf<TestCaseResult>()
+        var index = 0
+        while (index < lines.size && cases.size < MAX_CASES) {
+            val match = CONSOLE_LINE.matchEntire(lines[index].trim())
+            if (match == null) {
+                index++
+                continue
+            }
+            val suite = cleanName(match.groupValues[1])
+            val name = cleanName(match.groupValues[2]) ?: "unnamed"
+            val status =
+                when (match.groupValues[3]) {
+                    "FAILED" -> TestStatus.FAILED
+                    "SKIPPED" -> TestStatus.SKIPPED
+                    else -> TestStatus.PASSED
+                }
+            val detail = if (status == TestStatus.FAILED) firstIndentedLine(lines, index + 1) else null
+            cases += TestCaseResult(name = name, suite = suite, status = status, message = detail)
+            index++
+        }
+        if (cases.isEmpty()) return null
+
+        val failures = cases.filter { it.status == TestStatus.FAILED }
+        val skipped = cases.count { it.status == TestStatus.SKIPPED }
+        val total = cases.size
+        val summary = summaryTotals(text)
+        val disagree = summary != null && summary.total != total
+        return TestReport(
+            total = total,
+            passed = (total - failures.size - skipped).coerceAtLeast(0),
+            failed = failures.size,
+            skipped = skipped,
+            failures = failures.take(MAX_FAILURES),
+            source = TestReportSource.GRADLE_CONSOLE,
+            countsDisagree = disagree,
+            failuresTruncated = failures.size > MAX_FAILURES,
+        )
+    }
+
+    private fun firstIndentedLine(
+        lines: List<String>,
+        from: Int,
+    ): String? {
+        for (index in from until minOf(from + 4, lines.size)) {
+            val line = lines[index]
+            if (line.isBlank()) continue
+            if (!line.first().isWhitespace()) return null
+            cleanMessage(line)?.let { return it }
+        }
+        return null
+    }
+
+    // --- Summary line ----------------------------------------------------------------------------
+
+    private data class SummaryTotals(
+        val total: Int,
+        val failed: Int,
+        val skipped: Int,
+    )
+
+    private fun summaryTotals(text: String): SummaryTotals? {
+        SUMMARY_COMPLETED.findAll(text).lastOrNull()?.let { match ->
+            val total = match.groupValues[1].toIntOrNull() ?: return@let
+            val failed = match.groupValues[2].toIntOrNull() ?: 0
+            val skipped = match.groupValues[3].toIntOrNull() ?: 0
+            return SummaryTotals(total = total, failed = failed, skipped = skipped)
+        }
+        SUMMARY_FAILED.findAll(text).lastOrNull()?.let { match ->
+            val failed = match.groupValues[1].toIntOrNull() ?: return@let
+            return SummaryTotals(total = failed, failed = failed, skipped = 0)
+        }
+        return null
+    }
+
+    private fun parseSummary(text: String): TestReport? {
+        val summary = summaryTotals(text) ?: return null
+        return TestReport(
+            total = summary.total,
+            passed = (summary.total - summary.failed - summary.skipped).coerceAtLeast(0),
+            failed = summary.failed,
+            skipped = summary.skipped,
+            failures = emptyList(),
+            source = TestReportSource.SUMMARY_LINE,
+        )
+    }
+
+    // --- Text handling ---------------------------------------------------------------------------
+
+    /** A test name is shown in the report, so it is flattened and bounded like any other scraped text. */
+    private fun cleanName(raw: String?): String? {
+        val value = raw?.let { unescape(it) }?.replace('\n', ' ')?.replace('\r', ' ')?.trim()
+        return value?.takeIf { it.isNotEmpty() }?.take(200)
+    }
+
+    /** A failure message is one redacted line: stack traces and captured values do not belong in a report. */
+    private fun cleanMessage(raw: String?): String? {
+        if (raw == null) return null
+        val flattened = unescape(raw).replace('\n', ' ').replace('\r', ' ').replace(Regex("""\s+"""), " ").trim()
+        if (flattened.isEmpty()) return null
+        return SecretRedaction.redact(flattened).take(MAX_MESSAGE_LENGTH)
+    }
+
+    /** The five XML entities the test frameworks actually emit; anything else is left alone. */
+    private fun unescape(text: String): String =
+        text
+            .replace("&lt;", "<")
+            .replace("&gt;", ">")
+            .replace("&quot;", "\"")
+            .replace("&apos;", "'")
+            .replace("&amp;", "&")
+}
+
+/** Convenience: the per-test report for a finished check, computed from the output it already carries. */
+fun CheckResult.testReport(): TestReport = TestReportParser.parse(output)
