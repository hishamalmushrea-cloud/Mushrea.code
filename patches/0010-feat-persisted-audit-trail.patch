@@ -0,0 +1,277 @@
+package com.yugahashimoto.andcode.core.policy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PolicyAuditFileTest {
+    private fun entry(
+        timestampMs: Long,
+        operation: String = "write src/A.kt",
+        actor: String = "agent:write_file",
+        level: RiskLevel = RiskLevel.LOW,
+        decision: PolicyDecision = PolicyDecision.ALLOW,
+        codes: List<PolicyReasonCode> = listOf(PolicyReasonCode.INSIDE_WORKSPACE),
+    ) = PolicyAuditEntry(
+        timestampMs = timestampMs,
+        actor = actor,
+        operation = operation,
+        level = level,
+        decision = decision,
+        codes = codes,
+    )
+
+    private fun decoded(text: String): AuditDecodeResult.Decoded =
+        PolicyAuditFile.decode(text) as AuditDecodeResult.Decoded
+
+    @Test
+    fun `a trail survives a write and a read unchanged`() {
+        val original =
+            listOf(
+                entry(1, decision = PolicyDecision.REQUIRE_APPROVAL, level = RiskLevel.HIGH),
+                entry(2, operation = "rm -rf /", decision = PolicyDecision.DENY, level = RiskLevel.CRITICAL),
+            )
+
+        val result = decoded(PolicyAuditFile.encode(original))
+
+        assertEquals(original, result.entries)
+        assertEquals(0, result.skippedLines)
+        assertFalse(result.truncated)
+    }
+
+    @Test
+    fun `the file names its format and version on the first line`() {
+        val text = PolicyAuditFile.encode(listOf(entry(1)))
+
+        assertEquals("andcode-audit 1", text.lines().first())
+    }
+
+    @Test
+    fun `the newest entries are written when the trail is over the limit`() {
+        val entries = (1..PolicyAuditFile.MAX_ENTRIES + 5L).map { timestamp -> entry(timestamp) }
+
+        val result = decoded(PolicyAuditFile.encode(entries))
+
+        assertEquals(PolicyAuditFile.MAX_ENTRIES, result.entries.size)
+        assertEquals(PolicyAuditFile.MAX_ENTRIES + 5L, result.entries.last().timestampMs)
+        assertFalse(result.truncated)
+    }
+
+    @Test
+    fun `a file with more entries than the reader keeps reports the truncation`() {
+        val text =
+            buildString {
+                appendLine("andcode-audit 1")
+                repeat(PolicyAuditFile.MAX_ENTRIES + 2) { index -> appendLine(PolicyAuditFile.encodeLine(entry(index.toLong()))) }
+            }
+
+        val result = decoded(text)
+
+        assertEquals(PolicyAuditFile.MAX_ENTRIES, result.entries.size)
+        assertTrue(result.truncated)
+        assertEquals(PolicyAuditFile.MAX_ENTRIES + 1L, result.entries.last().timestampMs)
+    }
+
+    @Test
+    fun `a pipe in the operation does not split the record`() {
+        val original = entry(7, operation = "run cat a.txt | tee b.txt")
+
+        val result = decoded(PolicyAuditFile.encode(listOf(original)))
+
+        assertEquals(1, result.entries.size)
+        assertEquals("run cat a.txt | tee b.txt", result.entries[0].operation)
+    }
+
+    @Test
+    fun `a newline and a backslash in the operation survive`() {
+        val messy = "line1\\path\nline2\rline3"
+        val original = entry(9, operation = messy)
+
+        val result = decoded(PolicyAuditFile.encode(listOf(original)))
+
+        assertEquals(messy, result.entries[0].operation)
+        assertEquals(1, result.entries.size)
+    }
+
+    @Test
+    fun `a credential is redacted on the way in and on the way out`() {
+        val written = PolicyAuditFile.encode(listOf(entry(1, operation = "curl -H 'Authorization: Bearer abcdefghijkl'")))
+        assertFalse(written.contains("abcdefghijkl"))
+
+        val handEdited = "andcode-audit 1\n1|agent:bash|HIGH|DENY|SECRET_PATH|curl --token sk-proj-abcdefghijklmnop\n"
+        val read = decoded(handEdited)
+
+        assertEquals(1, read.entries.size)
+        assertFalse(read.entries[0].operation.contains("sk-proj-abcdefghijklmnop"))
+    }
+
+    @Test
+    fun `an empty file is rejected as empty`() {
+        val result = PolicyAuditFile.decode("  \n\n")
+
+        assertEquals(AuditRejection.EMPTY, (result as AuditDecodeResult.Rejected).reason)
+    }
+
+    @Test
+    fun `a wrong header is rejected instead of guessed at`() {
+        val result = PolicyAuditFile.decode("something-else 1\n1|a|LOW|ALLOW||x")
+
+        assertEquals(AuditRejection.BAD_HEADER, (result as AuditDecodeResult.Rejected).reason)
+    }
+
+    @Test
+    fun `a newer file version is refused rather than half read`() {
+        val result = PolicyAuditFile.decode("andcode-audit 2\n1|a|LOW|ALLOW||x")
+
+        val rejected = result as AuditDecodeResult.Rejected
+        assertEquals(AuditRejection.UNSUPPORTED_VERSION, rejected.reason)
+        assertTrue(rejected.detail!!.contains("2"))
+    }
+
+    @Test
+    fun `an oversized file is refused without being scanned`() {
+        val text = "andcode-audit 1\n" + "x".repeat(PolicyAuditFile.MAX_BYTES)
+
+        val result = PolicyAuditFile.decode(text)
+
+        assertEquals(AuditRejection.TOO_LARGE, (result as AuditDecodeResult.Rejected).reason)
+    }
+
+    @Test
+    fun `a torn last line is skipped and counted, and the rest is kept`() {
+        val text =
+            "andcode-audit 1\n" +
+                PolicyAuditFile.encodeLine(entry(1)) + "\n" +
+                "2|agent:bash|HIGH|DENY|SECRET"
+
+        val result = decoded(text)
+
+        assertEquals(1, result.entries.size)
+        assertEquals(1, result.skippedLines)
+    }
+
+    @Test
+    fun `a line with an unknown level is skipped instead of being shown as something else`() {
+        val text =
+            "andcode-audit 1\n" +
+                "1|agent:bash|LOUD|DENY|SECRET_PATH|x\n" +
+                PolicyAuditFile.encodeLine(entry(2))
+
+        val result = decoded(text)
+
+        assertEquals(1, result.entries.size)
+        assertEquals(2L, result.entries[0].timestampMs)
+        assertEquals(1, result.skippedLines)
+    }
+
+    @Test
+    fun `a line with an unknown reason code is skipped`() {
+        val text = "andcode-audit 1\n1|agent:bash|LOW|ALLOW|NOT_A_CODE|x"
+
+        val result = decoded(text)
+
+        assertTrue(result.entries.isEmpty())
+        assertEquals(1, result.skippedLines)
+    }
+
+    @Test
+    fun `blank lines around the records are ignored, not counted as damage`() {
+        val text = "\nandcode-audit 1\n\n" + PolicyAuditFile.encodeLine(entry(1)) + "\n\n"
+
+        val result = decoded(text)
+
+        assertEquals(1, result.entries.size)
+        assertEquals(0, result.skippedLines)
+    }
+
+    @Test
+    fun `an entry without reason codes is read back as such`() {
+        val text = "andcode-audit 1\n1|agent:bash|LOW|ALLOW||no codes here"
+
+        val result = decoded(text)
+
+        assertTrue(result.entries[0].codes.isEmpty())
+        assertEquals("no codes here", result.entries[0].operation)
+    }
+
+    @Test
+    fun `the in-memory log exports and restores its trail`() {
+        val operation =
+            PolicyOperation(tool = "bash", kind = OperationKind.RUN_COMMAND, command = "cat /workspace/.env")
+        val assessment = RiskEngine.assess(operation, PolicyConfig())
+        val log = InMemoryPolicyAuditLog()
+        log.record(operation, assessment, timestampMs = 1)
+        log.record(operation, assessment, timestampMs = 2)
+
+        val next = InMemoryPolicyAuditLog()
+        val result = next.restore(log.exportText())
+
+        assertTrue(result is AuditDecodeResult.Decoded)
+        assertEquals(2, next.size)
+        assertEquals(log.snapshot(), next.snapshot())
+    }
+
+    @Test
+    fun `a restored trail is trimmed to the log's own limit`() {
+        val text = PolicyAuditFile.encode((1..5L).map { timestamp -> entry(timestamp) })
+        val log = InMemoryPolicyAuditLog(maxEntries = 2)
+
+        log.restore(text)
+
+        assertEquals(listOf(4L, 5L), log.snapshot().map { it.timestampMs })
+    }
+
+    @Test
+    fun `a rejected file leaves the current trail untouched`() {
+        val operation = PolicyOperation(tool = "bash", kind = OperationKind.RUN_COMMAND, command = "rm -rf /")
+        val log = InMemoryPolicyAuditLog()
+        log.record(operation, RiskEngine.assess(operation, PolicyConfig()), timestampMs = 1)
+
+        val result = log.restore("not our file")
+
+        assertTrue(result is AuditDecodeResult.Rejected)
+        assertEquals(1, log.size)
+    }
+
+    @Test
+    fun `a file whose every line is unreadable does not wipe the trail`() {
+        val operation = PolicyOperation(tool = "bash", kind = OperationKind.RUN_COMMAND, command = "rm -rf /")
+        val log = InMemoryPolicyAuditLog()
+        log.record(operation, RiskEngine.assess(operation, PolicyConfig()), timestampMs = 1)
+
+        val result = log.restore("andcode-audit 1\ngarbage\nalso garbage\n")
+
+        assertEquals(2, (result as AuditDecodeResult.Decoded).skippedLines)
+        assertEquals(1, log.size)
+    }
+
+    @Test
+    fun `a denied decision keeps its decision and codes through the file`() {
+        val original =
+            entry(
+                3,
+                operation = "fastboot flash boot boot.img",
+                actor = "agent:bash",
+                level = RiskLevel.CRITICAL,
+                decision = PolicyDecision.DENY,
+                codes = listOf(PolicyReasonCode.DEVICE_OPERATION, PolicyReasonCode.ELEVATED_COMMAND),
+            )
+
+        val restored = decoded(PolicyAuditFile.encode(listOf(original))).entries.single()
+
+        assertEquals(PolicyDecision.DENY, restored.decision)
+        assertEquals(RiskLevel.CRITICAL, restored.level)
+        assertEquals(listOf(PolicyReasonCode.DEVICE_OPERATION, PolicyReasonCode.ELEVATED_COMMAND), restored.codes)
+    }
+
+    @Test
+    fun `an actor that carries a separator survives`() {
+        val original = entry(4, actor = "user:ask|confirm")
+
+        val restored = decoded(PolicyAuditFile.encode(listOf(original))).entries.single()
+
+        assertEquals("user:ask|confirm", restored.actor)
+        assertEquals(original, restored)
+    }
+}
