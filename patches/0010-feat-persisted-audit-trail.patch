 class InMemoryPolicyAuditLog(
     private val maxEntries: Int = DEFAULT_MAX_ENTRIES,
@@ -70,6 +71,32 @@ class InMemoryPolicyAuditLog(
     /** Oldest first. A copy, so callers cannot mutate the trail by accident. */
     fun snapshot(): List<PolicyAuditEntry> = synchronized(lock) { entries.toList() }
 
+    /**
+     * The trail in the format [PolicyAuditFile] reads back, for storage that outlives the process. Kept as
+     * a separate call rather than a side effect of [record]: the log has no file to write to, and hiding
+     * disk access inside a `record` would make every decision a potential IO failure.
+     */
+    fun exportText(): String = PolicyAuditFile.encode(snapshot())
+
+    /**
+     * Replaces the trail with a saved one, oldest first, trimmed to [maxEntries].
+     *
+     * A rejected file changes nothing, and so does a file whose lines were all unreadable: losing the
+     * decisions currently in memory because the stored copy is torn would be the worst of both. The
+     * result is returned so the caller can tell the user how many lines were dropped.
+     */
+    fun restore(text: String): AuditDecodeResult {
+        val result = PolicyAuditFile.decode(text)
+        if (result is AuditDecodeResult.Decoded && (result.entries.isNotEmpty() || result.skippedLines == 0)) {
+            synchronized(lock) {
+                entries.clear()
+                result.entries.forEach { entry -> entries.addLast(entry) }
+                while (entries.size > maxEntries) entries.removeFirst()
+            }
+        }
+        return result
+    }
+
     val size: Int get() = synchronized(lock) { entries.size }
 
     companion object {
diff --git a/app/src/test/java/com/yugahashimoto/andcode/core/policy/PolicyAuditFileTest.kt b/app/src/test/java/com/yugahashimoto/andcode/core/policy/PolicyAuditFileTest.kt
