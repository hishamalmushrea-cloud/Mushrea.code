+package com.yugahashimoto.andcode.core.policy
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/** Why a saved audit trail could not be read. Data, not an exception: a corrupt file is expected. */
+enum class AuditRejection {
+    /** Nothing to read. */
+    EMPTY,
+
+    /** The first line is not `andcode-audit <version>`. */
+    BAD_HEADER,
+
+    /** Written by a newer app; refusing beats guessing at fields. */
+    UNSUPPORTED_VERSION,
+
+    /** Bigger than [PolicyAuditFile.MAX_BYTES]. */
+    TOO_LARGE,
+}
+
+/** The outcome of reading a saved trail. */
+sealed interface AuditDecodeResult {
+    /**
+     * [entries] are oldest first. [skippedLines] counts lines that could not be read: a trail is appended
+     * to while the app runs, so a torn last line after a crash is normal and must not make the rest
+     * unreadable - but it is reported, never hidden. [truncated] means the file held more than
+     * [PolicyAuditFile.MAX_ENTRIES] and only the newest were kept.
+     */
+    data class Decoded(
+        val entries: List<PolicyAuditEntry>,
+        val skippedLines: Int = 0,
+        val truncated: Boolean = false,
+    ) : AuditDecodeResult
+
+    data class Rejected(
+        val reason: AuditRejection,
+        val detail: String? = null,
+    ) : AuditDecodeResult
+}
+
+/**
+ * The file form of the policy audit trail.
+ *
+ * Why a file at all: a `DENY` that is forgotten when the process dies is not an audit trail. The in-memory
+ * log stays the source of truth while the app runs; this is only the format storage writes at the end of a
+ * session and reads at the start of the next one.
+ *
+ * Design constraints, all of them from the fact that this is a security record:
+ * - **Line-based and versioned** (`andcode-audit 1`), so an unreadable file is a visible refusal rather
+ *   than a wrong interpretation.
+ * - **Append friendly**: [encodeLine] produces one line, so a storage layer can append instead of
+ *   rewriting the whole file. [encode] writes header plus the newest [MAX_ENTRIES] lines.
+ * - **Torn lines are counted, not fatal.** Each bad line is skipped and counted in
+ *   [AuditDecodeResult.Decoded.skippedLines]; a bad header or a newer version rejects the whole file.
+ * - **No raw commands.** Only the redacted [PolicyAuditEntry.operation], the reason codes and the actor are
+ *   stored; [SecretRedaction] is applied again on both encode and decode, because a hand-edited file can
+ *   carry anything.
+ * - **Bounded.** [MAX_BYTES] and [MAX_ENTRIES] keep a long-lived file from growing without limit.
+ */
+object PolicyAuditFile {
+    const val MAGIC = "andcode-audit"
+    const val VERSION = 1
+    const val MAX_BYTES = 256 * 1024
+    const val MAX_ENTRIES = 500
+
+    private const val SEPARATOR = '|'
+    private const val FIELD_COUNT = 6
+
+    /** A whole file: the header followed by the newest [MAX_ENTRIES] entries, oldest first. */
+    fun encode(entries: List<PolicyAuditEntry>): String =
+        buildString {
+            append(MAGIC).append(' ').append(VERSION).append('\n')
+            entries.takeLast(MAX_ENTRIES).forEach { entry -> append(encodeLine(entry)).append('\n') }
+        }
+
+    /** One record, for an append-only file that already has a header. */
+    fun encodeLine(entry: PolicyAuditEntry): String =
+        listOf(
+            entry.timestampMs.toString(),
+            escape(entry.actor),
+            entry.level.name,
+            entry.decision.name,
+            entry.codes.joinToString(",") { code -> code.name },
+            escape(SecretRedaction.redact(entry.operation)),
+        ).joinToString(SEPARATOR.toString())
+
+    fun decode(text: String): AuditDecodeResult {
+        if (text.isBlank()) return AuditDecodeResult.Rejected(AuditRejection.EMPTY)
+        if (text.length > MAX_BYTES) {
+            return AuditDecodeResult.Rejected(AuditRejection.TOO_LARGE, "${text.length} characters")
+        }
+
+        val lines = text.split('\n').map { line -> line.trimEnd('\r') }
+        val headerIndex = lines.indexOfFirst { line -> line.isNotBlank() }
+        if (headerIndex < 0) return AuditDecodeResult.Rejected(AuditRejection.EMPTY)
+        val header = lines[headerIndex].trim()
+        val parts = header.split(' ')
+        if (parts.size != 2 || parts[0] != MAGIC) {
+            return AuditDecodeResult.Rejected(AuditRejection.BAD_HEADER, header.take(MAX_DETAIL_LENGTH))
+        }
+        val version = parts[1].toIntOrNull()
+        if (version == null) {
+            return AuditDecodeResult.Rejected(AuditRejection.BAD_HEADER, header.take(MAX_DETAIL_LENGTH))
+        }
+        if (version != VERSION) {
+            return AuditDecodeResult.Rejected(
+                AuditRejection.UNSUPPORTED_VERSION,
+                "file version $version, this app reads $VERSION",
+            )
+        }
+
+        val entries = mutableListOf<PolicyAuditEntry>()
+        var skipped = 0
+        for (index in headerIndex + 1 until lines.size) {
+            val line = lines[index]
+            if (line.isBlank()) continue
+            val entry = parseLine(line)
+            if (entry == null) skipped++ else entries += entry
+        }
+        val truncated = entries.size > MAX_ENTRIES
+        return AuditDecodeResult.Decoded(
+            entries = entries.takeLast(MAX_ENTRIES),
+            skippedLines = skipped,
+            truncated = truncated,
+        )
+    }
+
+    /** Splits one record, or null when it cannot be read as one. Reasons stay internal: the count is the report. */
+    private fun parseLine(line: String): PolicyAuditEntry? {
+        val fields = splitEscaped(line) ?: return null
+        if (fields.size != FIELD_COUNT) return null
+        val timestamp = fields[0].toLongOrNull() ?: return null
+        val actor = fields[1].takeIf { it.isNotBlank() } ?: return null
+        val level = RiskLevel.entries.firstOrNull { it.name == fields[2] } ?: return null
+        val decision = PolicyDecision.entries.firstOrNull { it.name == fields[3] } ?: return null
+        val codes =
+            if (fields[4].isBlank()) {
+                emptyList()
+            } else {
+                fields[4].split(',').map { name ->
+                    PolicyReasonCode.entries.firstOrNull { it.name == name } ?: return null
+                }
+            }
+        val operation = SecretRedaction.redact(fields[5])
+        return PolicyAuditEntry(
+            timestampMs = timestamp,
+            actor = actor,
+            operation = operation,
+            level = level,
+            decision = decision,
+            codes = codes,
+        )
+    }
+
+    // --- Escaping ---------------------------------------------------------------------------------
+
+    private fun escape(value: String): String =
+        buildString(value.length) {
+            value.forEach { char ->
+                when (char) {
+                    '\\' -> append("\\\\")
+                    SEPARATOR -> append("\\p")
+                    '\n' -> append("\\n")
+                    '\r' -> append("\\r")
+                    else -> append(char)
+                }
+            }
+        }
+
+    /** Null when a value ends in a dangling backslash, which means the line was cut. */
+    private fun splitEscaped(line: String): List<String>? {
+        val fields = mutableListOf<String>()
+        val current = StringBuilder()
+        var index = 0
+        while (index < line.length) {
+            val char = line[index]
+            when {
+                char == '\\' -> {
+                    val next = line.getOrNull(index + 1) ?: return null
+                    when (next) {
+                        '\\' -> current.append('\\')
+                        'p' -> current.append(SEPARATOR)
+                        'n' -> current.append('\n')
+                        'r' -> current.append('\r')
+                        else -> current.append(next)
+                    }
+                    index += 2
+                    continue
+                }
+                char == SEPARATOR -> {
+                    fields += current.toString()
+                    current.clear()
+                }
+                else -> current.append(char)
+            }
+            index++
+        }
+        fields += current.toString()
+        return fields
+    }
+
+    private const val MAX_DETAIL_LENGTH = 80
+}
