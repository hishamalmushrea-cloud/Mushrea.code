--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/ToolCallMapper.kt
@@ -0,0 +1,102 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * A tool call reduced to what the policy engine needs: a name and flat string arguments.
+ *
+ * Deliberately not the runtime's own model. Each backend (OpenCode's `PermissionRequest`, the Claude
+ * Code permission hook, Antigravity, Codex) shapes its payload differently, so the CLI-specific part
+ * of the wiring is one adapter per backend that produces this type - and this package stays free of
+ * their JSON and their naming.
+ */
+data class ToolCall(
+    val name: String,
+    /** Flat arguments; nested structures are up to the adapter to flatten. */
+    val input: Map<String, String> = emptyMap(),
+)
+
+/**
+ * Maps a [ToolCall] to a [PolicyOperation] using the tool name and a handful of conventional argument
+ * keys.
+ *
+ * This is a heuristic and is documented as one: an unrecognised tool becomes
+ * [OperationKind.UNKNOWN], which the engine treats as `MEDIUM` (ask the user) rather than letting it
+ * through. Being wrong in the unknown direction costs a prompt; being wrong in the permissive direction
+ * costs a wiped directory.
+ */
+object ToolCallMapper {
+    private val COMMAND_TOKENS = setOf("bash", "shell", "sh", "exec", "execute", "command", "terminal", "run", "script")
+    private val READ_TOKENS = setOf("read", "view", "cat", "head", "tail", "glob", "grep", "list", "ls")
+    private val WRITE_TOKENS = setOf("write", "edit", "patch", "create", "apply", "append", "replace", "multiedit")
+    private val DELETE_TOKENS = setOf("delete", "remove", "rm", "unlink", "rmdir")
+    private val NETWORK_TOKENS = setOf("fetch", "webfetch", "http", "url", "web", "browser", "curl")
+    private val PUSH_TOKENS = setOf("push", "pr", "pull", "request", "merge")
+    private val RELEASE_TOKENS = setOf("publish", "release", "deploy", "ship")
+    private val INSTALL_TOKENS = setOf("install", "dependency", "dependencies", "deps", "package")
+    private val DEVICE_TOKENS = setOf("fastboot", "flash", "adb", "sideload", "unlock")
+    private val POLICY_TOKENS = setOf("policy", "permission", "permissions", "approval", "approve", "sandbox")
+
+    private val COMMAND_KEYS = listOf("command", "cmd", "script", "shell", "input")
+    private val PATH_KEYS = listOf("path", "filePath", "file_path", "file", "filename", "target", "paths", "files")
+    private val URL_KEYS = listOf("url", "uri", "endpoint", "href")
+    private val COUNT_KEYS = listOf("fileCount", "file_count", "count", "numFiles")
+
+    fun toOperation(call: ToolCall): PolicyOperation {
+        val tokens = tokensOf(call.name)
+        val kind = kindOf(tokens)
+        val url = call.input.firstValue(URL_KEYS)
+        return PolicyOperation(
+            tool = call.name,
+            kind = kind,
+            paths = if (kind == OperationKind.RUN_COMMAND) emptyList() else pathValues(call.input),
+            command = call.input.firstValue(COMMAND_KEYS).takeIf { kind == OperationKind.RUN_COMMAND },
+            networkHosts = if (kind == OperationKind.NETWORK) listOfNotNull(url?.let(::hostOf)) else emptyList(),
+            fileCount = call.input.firstValue(COUNT_KEYS)?.toIntOrNull() ?: 0,
+        )
+    }
+
+    private fun kindOf(tokens: Set<String>): OperationKind =
+        when {
+            tokens.any { it in POLICY_TOKENS } -> OperationKind.POLICY_OVERRIDE
+            tokens.any { it in DEVICE_TOKENS } -> OperationKind.DEVICE_FLASH
+            tokens.any { it in RELEASE_TOKENS } -> OperationKind.RELEASE
+            tokens.any { it in PUSH_TOKENS } -> OperationKind.VCS_PUSH
+            tokens.any { it in INSTALL_TOKENS } -> OperationKind.INSTALL_DEPENDENCY
+            tokens.any { it in COMMAND_TOKENS } -> OperationKind.RUN_COMMAND
+            tokens.any { it in DELETE_TOKENS } -> OperationKind.DELETE_FILE
+            tokens.any { it in WRITE_TOKENS } -> OperationKind.WRITE_FILE
+            tokens.any { it in READ_TOKENS } -> OperationKind.READ_FILE
+            tokens.any { it in NETWORK_TOKENS } -> OperationKind.NETWORK
+            else -> OperationKind.UNKNOWN
+        }
+
+    /** `mcp__andcode__write_file` and `writeFile` both become `{mcp, andcode, write, file}`. */
+    private fun tokensOf(name: String): Set<String> =
+        // "$1 $2", not " ": replacing the whole match would eat the first letter of the next word
+        // ("writeFile" -> "write ile", which tokenises to nothing useful).
+        name.replace(CAMEL_BOUNDARY, "$1 $2")
+            .split(NON_LETTERS)
+            .filter { it.isNotBlank() }
+            .map { it.lowercase() }
+            .toSet()
+
+    private fun pathValues(input: Map<String, String>): List<String> =
+        PATH_KEYS.flatMap { key -> input[key]?.let(::splitPaths) ?: emptyList() }
+
+    private fun splitPaths(raw: String): List<String> =
+        raw.split('\n', ',')
+            .map { it.trim() }
+            .filter { it.isNotEmpty() }
+
+    private fun hostOf(url: String): String? {
+        val withoutScheme = url.substringAfter("://", url)
+        val authority = withoutScheme.substringBefore('/').substringBefore('?').substringBefore('#')
+        val host = authority.substringAfterLast('@').substringBefore(':')
+        return host.takeIf { it.isNotBlank() }
+    }
+
+    private fun Map<String, String>.firstValue(keys: List<String>): String? =
+        keys.firstNotNullOfOrNull { this[it]?.takeIf(String::isNotBlank) }
+
+    private val CAMEL_BOUNDARY = Regex("([a-z0-9])([A-Z])")
+    private val NON_LETTERS = Regex("[^A-Za-z0-9]+")
+}
