+package com.yugahashimoto.andcode.core.task
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TaskResumeTest {
+    private val start = 1_000_000L
+
+    private fun progress(
+        state: TaskState = TaskState.PAUSED,
+        steps: List<TaskStep> = emptyList(),
+        attempts: Int = 0,
+    ) = TaskProgress(state = state, steps = steps, attempts = attempts, startedAtMs = start)
+
+    private val editStep = TaskStep("edit-1", StepState.DONE, sideEffecting = true, finishedAtMs = start + 10)
+    private val testStep = TaskStep("test-1", StepState.PENDING)
+    private val inFlightWrite = TaskStep("write-1", StepState.RUNNING, sideEffecting = true, startedAtMs = start + 20)
+    private val inFlightRead = TaskStep("scan-1", StepState.RUNNING, sideEffecting = false, startedAtMs = start + 20)
+
+    @Test
+    fun `resuming reports what is done, what runs and what needs confirmation`() {
+        val plan = TaskResume.plan(progress(steps = listOf(editStep, testStep, inFlightWrite, inFlightRead)), start + 100, TaskLimits())
+
+        assertTrue(plan is ResumePlan.Resumable)
+        val resumable = plan as ResumePlan.Resumable
+        assertEquals(listOf("edit-1"), resumable.completedSteps)
+        assertEquals(listOf("test-1", "scan-1"), resumable.stepsToRun)
+        assertEquals(listOf("write-1"), resumable.stepsNeedingConfirmation)
+        assertFalse(resumable.runsWithoutConfirmation)
+        assertTrue(resumable.report().contains("awaiting confirmation"))
+    }
+
+    @Test
+    fun `an interrupted side effect is never re-run automatically`() {
+        val plan = TaskResume.plan(progress(steps = listOf(inFlightWrite)), start + 100, TaskLimits()) as ResumePlan.Resumable
+        assertFalse(plan.stepsToRun.contains("write-1"))
+        assertEquals(listOf("write-1"), plan.stepsNeedingConfirmation)
+    }
+
+    @Test
+    fun `confirming a side effect queues it and abandoning it skips it`() {
+        val current = progress(steps = listOf(inFlightWrite))
+        val confirmed = TaskResume.confirmSideEffect(current, "write-1")
+        assertEquals(StepState.PENDING, confirmed.steps.single().state)
+        assertEquals(null, confirmed.steps.single().finishedAtMs)
+
+        val abandoned = TaskResume.abandonSideEffect(current, "write-1")
+        assertEquals(StepState.SKIPPED, abandoned.steps.single().state)
+    }
+
+    @Test
+    fun `confirming a step that is not in flight changes nothing`() {
+        val current = progress(steps = listOf(testStep))
+        assertEquals(current, TaskResume.confirmSideEffect(current, "test-1"))
+        assertEquals(current, TaskResume.confirmSideEffect(current, "missing"))
+    }
+
+    @Test
+    fun `begin spends one attempt and resets only the repeatable steps`() {
+        val current = progress(steps = listOf(editStep, testStep, inFlightWrite, inFlightRead))
+        val plan = TaskResume.plan(current, start + 100, TaskLimits())
+        val outcome = TaskResume.begin(current, plan)
+
+        assertTrue(outcome.resumed)
+        assertEquals(TaskState.RUNNING, outcome.progress.state)
+        assertEquals(1, outcome.progress.attempts)
+        val byId = outcome.progress.steps.associateBy { it.id }
+        assertEquals(StepState.PENDING, byId.getValue("scan-1").state)
+        assertEquals(StepState.RUNNING, byId.getValue("write-1").state)
+        assertEquals(StepState.DONE, byId.getValue("edit-1").state)
+    }
+
+    @Test
+    fun `a finished task cannot be resumed`() {
+        val plan = TaskResume.plan(progress(state = TaskState.SHIPPED, steps = listOf(testStep)), start + 100, TaskLimits())
+        assertEquals(ResumeBlock.ALREADY_TERMINAL, (plan as ResumePlan.Blocked).reason)
+    }
+
+    @Test
+    fun `spent attempts block a resume`() {
+        val plan = TaskResume.plan(progress(steps = listOf(testStep), attempts = 3), start + 100, TaskLimits())
+        assertEquals(ResumeBlock.ATTEMPTS_EXHAUSTED, (plan as ResumePlan.Blocked).reason)
+    }
+
+    @Test
+    fun `pausing does not refill the wall clock budget`() {
+        val old = TaskProgress(state = TaskState.PAUSED, steps = listOf(testStep), startedAtMs = start, pausedAtMs = start + 5)
+        val plan = TaskResume.plan(old, start + TaskLimits.DEFAULT_MAX_WALL_CLOCK_MS + 1, TaskLimits())
+        assertEquals(ResumeBlock.EXPIRED, (plan as ResumePlan.Blocked).reason)
+    }
+
+    @Test
+    fun `a task with nothing left to run is not reported as resumable`() {
+        val plan = TaskResume.plan(progress(steps = listOf(editStep)), start + 100, TaskLimits())
+        assertEquals(ResumeBlock.NOTHING_TO_RUN, (plan as ResumePlan.Blocked).reason)
+    }
+
+    @Test
+    fun `a blocked plan leaves the progress untouched`() {
+        val current = progress(state = TaskState.CANCELLED, steps = listOf(testStep))
+        val plan = TaskResume.plan(current, start + 100, TaskLimits())
+        val outcome = TaskResume.begin(current, plan)
+        assertFalse(outcome.resumed)
+        assertEquals(current, outcome.progress)
+    }
+
+    @Test
+    fun `cancelling reports the steps the caller has to stop`() {
+        val current = progress(state = TaskState.RUNNING, steps = listOf(testStep, inFlightWrite, inFlightRead))
+        val outcome = TaskResume.cancel(current, start + 200) as CancelOutcome.Cancelled
+
+        assertEquals(listOf("write-1", "scan-1"), outcome.stepsToStop)
+        assertEquals(TaskState.CANCELLED, outcome.progress.state)
+        assertTrue(outcome.progress.steps.filter { it.id != "test-1" }.all { it.state == StepState.SKIPPED })
+        assertEquals(start + 200, outcome.progress.steps.first { it.id == "write-1" }.finishedAtMs)
+    }
+
+    @Test
+    fun `cancelling a terminal task is refused`() {
+        val outcome = TaskResume.cancel(progress(state = TaskState.SHIPPED, steps = listOf(testStep)), start + 200)
+        assertEquals(TransitionRejection.ILLEGAL_TRANSITION, (outcome as CancelOutcome.Refused).reason)
+    }
+
+    @Test
+    fun `recording steps respects the trail limit by keeping the newest`() {
+        val limits = TaskLimits(maxSteps = 2)
+        var current = progress(steps = emptyList())
+        repeat(3) { index -> current = current.withNewStep(TaskStep("s$index"), limits) }
+
+        assertEquals(listOf("s1", "s2"), current.steps.map { it.id })
+    }
+}
