+package com.yugahashimoto.andcode.core.policy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ToolCallMapperTest {
+    private fun map(
+        name: String,
+        vararg input: Pair<String, String>,
+    ): PolicyOperation = ToolCallMapper.toOperation(ToolCall(name, mapOf(*input)))
+
+    @Test
+    fun `a shell tool keeps its command`() {
+        val operation = map("bash", "command" to "git status")
+        assertEquals(OperationKind.RUN_COMMAND, operation.kind)
+        assertEquals("git status", operation.command)
+    }
+
+    @Test
+    fun `an mcp-prefixed write tool maps to a file write`() {
+        val operation = map("mcp__andcode__write_file", "filePath" to "/workspace/app/A.kt")
+        assertEquals(OperationKind.WRITE_FILE, operation.kind)
+        assertEquals(listOf("/workspace/app/A.kt"), operation.paths)
+        assertNull(operation.command)
+    }
+
+    @Test
+    fun `a camel case tool name is tokenised too`() {
+        assertEquals(OperationKind.WRITE_FILE, map("writeFile", "path" to "/workspace/a.kt").kind)
+        assertEquals(OperationKind.READ_FILE, map("readFile", "path" to "/workspace/a.kt").kind)
+    }
+
+    @Test
+    fun `newline separated paths are split`() {
+        val operation = map("write", "paths" to "/workspace/a.kt\n/workspace/b.kt")
+        assertEquals(listOf("/workspace/a.kt", "/workspace/b.kt"), operation.paths)
+    }
+
+    @Test
+    fun `deletes, pushes, releases and installs keep their kind`() {
+        assertEquals(OperationKind.DELETE_FILE, map("delete_file", "path" to "/workspace/x").kind)
+        assertEquals(OperationKind.VCS_PUSH, map("git_push", "command" to "git push").kind)
+        assertEquals(OperationKind.RELEASE, map("npm_publish").kind)
+        assertEquals(OperationKind.INSTALL_DEPENDENCY, map("add_dependency", "package" to "okhttp").kind)
+        assertEquals(OperationKind.DEVICE_FLASH, map("fastboot_flash").kind)
+        assertEquals(OperationKind.POLICY_OVERRIDE, map("update_permissions").kind)
+    }
+
+    @Test
+    fun `a network tool reports its host`() {
+        val operation = map("webfetch", "url" to "https://api.example.com:8443/v1?q=1")
+        assertEquals(OperationKind.NETWORK, operation.kind)
+        assertEquals(listOf("api.example.com"), operation.networkHosts)
+    }
+
+    @Test
+    fun `an unknown tool stays unknown`() {
+        assertEquals(OperationKind.UNKNOWN, map("mystery_tool", "whatever" to "x").kind)
+    }
+
+    @Test
+    fun `a file count hint is carried through`() {
+        val operation = map("write", "path" to "/workspace/a.kt", "fileCount" to "25")
+        assertEquals(25, operation.fileCount)
+        assertEquals(25, operation.touchedFileCount)
+    }
+
+    @Test
+    fun `mapping and assessment together refuse a destructive shell call`() {
+        val assessment = RiskEngine.assess(map("bash", "command" to "rm -rf /"), PolicyConfig())
+        assertEquals(PolicyDecision.DENY, assessment.decision)
+    }
+
