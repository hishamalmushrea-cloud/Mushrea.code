@@ -0,0 +1,29 @@
+package com.yugahashimoto.andcode.core.task
+
+/**
+ * The hard stops on a task.
+ *
+ * Every one of these exists because an agent loop without a stop condition is how a phone ends up
+ * burning a battery on a retry storm, or re-running a publish step someone already did. The values are
+ * per-task settings, not something a model can raise from inside the task it is running.
+ */
+data class TaskLimits(
+    /** Total attempts allowed for the task as a whole, retries included. */
+    val maxAttempts: Int = DEFAULT_MAX_ATTEMPTS,
+    /** Wall-clock budget for the task, measured from [TaskProgress.startedAtMs]. */
+    val maxWallClockMs: Long = DEFAULT_MAX_WALL_CLOCK_MS,
+    /** Steps recorded before the trail stops growing; the newest are kept. */
+    val maxSteps: Int = DEFAULT_MAX_STEPS,
+) {
+    init {
+        require(maxAttempts > 0) { "maxAttempts must be positive" }
+        require(maxWallClockMs > 0) { "maxWallClockMs must be positive" }
+        require(maxSteps > 0) { "maxSteps must be positive" }
+    }
+
+    companion object {
+        const val DEFAULT_MAX_ATTEMPTS = 3
+        const val DEFAULT_MAX_WALL_CLOCK_MS = 30L * 60L * 1000L
+        const val DEFAULT_MAX_STEPS = 200
+    }
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskProgress.kt b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskProgress.kt
new file mode 100644
index 0000000..b1ee0fc
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskProgress.kt
@@ -0,0 +1,67 @@
+package com.yugahashimoto.andcode.core.task
+
+/** Where one step of a task stands. */
+enum class StepState {
+    PENDING,
+    RUNNING,
+    DONE,
+    FAILED,
+    SKIPPED,
+}
+
+/**
+ * One unit of work in a task.
+ *
+ * [sideEffecting] is the field the resume rules pivot on: a step that writes files, pushes a branch or
+ * publishes something cannot simply be run again after the app died mid-flight, because the previous
+ * attempt may already have landed. Steps without side effects are safe to repeat, so they are.
+ */
+data class TaskStep(
+    val id: String,
+    val state: StepState = StepState.PENDING,
+    val sideEffecting: Boolean = false,
+    val attempts: Int = 0,
+    val startedAtMs: Long? = null,
+    val finishedAtMs: Long? = null,
+) {
+    /** Started and never finished: the process died, or the step is still in flight. */
+    val isInFlight: Boolean get() = state == StepState.RUNNING
+}
+
+/**
+ * Everything needed to resume a task after the app was closed, and to explain what already happened.
+ *
+ * Plain data with no Android or serialization dependency, so a repository can persist it however it
+ * likes (and so the rules below can be unit tested without one).
+ */
+data class TaskProgress(
+    val state: TaskState,
+    val steps: List<TaskStep> = emptyList(),
+    /** Attempts already spent, counted from the start of the task. */
+    val attempts: Int = 0,
+    val startedAtMs: Long,
+    /** When the task was paused, if it was; the clock for the expiry check. */
+    val pausedAtMs: Long? = null,
+) {
+    val completedSteps: List<TaskStep> get() = steps.filter { it.state == StepState.DONE }
+
+    val openSteps: List<TaskStep> get() = steps.filter { it.state == StepState.PENDING || it.state == StepState.FAILED }
+
+    val inFlightSteps: List<TaskStep> get() = steps.filter { it.isInFlight }
+
+    /** Steps whose in-flight state means "we do not know whether this landed". */
+    val unverifiedSideEffects: List<TaskStep> get() = steps.filter { it.isInFlight && it.sideEffecting }
+
+    /** Replaces [stepId] in place, appending nothing the trail does not already have. */
+    fun withStep(step: TaskStep): TaskProgress = copy(steps = steps.map { if (it.id == step.id) step else it })
+
+    /** Adds a step, trimming the oldest once [TaskLimits.maxSteps] would be exceeded. */
+    fun withNewStep(
+        step: TaskStep,
+        limits: TaskLimits,
+    ): TaskProgress {
+        val appended = steps + step
+        val trimmed = if (appended.size > limits.maxSteps) appended.takeLast(limits.maxSteps) else appended
+        return copy(steps = trimmed)
+    }
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskResume.kt b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskResume.kt
new file mode 100644
index 0000000..265f76b
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskResume.kt
@@ -0,0 +1,184 @@
+package com.yugahashimoto.andcode.core.task
+
+/** Why a saved task cannot simply be picked up again. */
+enum class ResumeBlock {
+    /** Nothing to resume: the task already shipped or was cancelled. */
+    ALREADY_TERMINAL,
+
+    /** [TaskLimits.maxAttempts] attempts are spent; the user has to raise it or start over. */
+    ATTEMPTS_EXHAUSTED,
+
+    /** [TaskLimits.maxWallClockMs] of wall clock is gone. */
+    EXPIRED,
+
+    /** Every step finished or was skipped, but the task never reached a success state. */
+    NOTHING_TO_RUN,
+}
+
+/**
+ * What resuming a task would do.
+ *
+ * [stepsNeedingConfirmation] is the point of the whole type: those steps were running when the app
+ * stopped and they have side effects, so the app cannot know whether the write, push or publish
+ * already landed. They are never re-run automatically; the user confirms or abandons each one.
+ */
+sealed interface ResumePlan {
+    data class Resumable(
+        val stepsToRun: List<String>,
+        val stepsNeedingConfirmation: List<String>,
+        val completedSteps: List<String>,
+    ) : ResumePlan {
+        /** True when resume can go ahead without asking anything. */
+        val runsWithoutConfirmation: Boolean get() = stepsNeedingConfirmation.isEmpty()
+
+        fun report(): String =
+            "${completedSteps.size} done, ${stepsToRun.size} to run, " +
+                "${stepsNeedingConfirmation.size} awaiting confirmation"
+    }
+
+    data class Blocked(
+        val reason: ResumeBlock,
+        val detail: String,
+    ) : ResumePlan
+}
+
+/** Result of asking to resume. [progress] is unchanged when the plan is [ResumePlan.Blocked]. */
+data class ResumeOutcome(
+    val plan: ResumePlan,
+    val progress: TaskProgress,
+) {
+    val resumed: Boolean get() = plan is ResumePlan.Resumable
+}
+
+/** Result of asking to cancel. */
+sealed interface CancelOutcome {
+    /** [stepsToStop] are the steps whose in-flight work the caller should actually kill. */
+    data class Cancelled(
+        val progress: TaskProgress,
+        val stepsToStop: List<String>,
+    ) : CancelOutcome
+
+    data class Refused(val reason: TransitionRejection) : CancelOutcome
+}
+
+/**
+ * Resume, confirmation and cancellation rules for a saved task.
+ *
+ * Kept beside [TaskStateMachine] rather than inside it: the machine answers "may this state change",
+ * this object answers "what does the saved file mean after a restart". Both are pure Kotlin.
+ *
+ * The wall-clock budget is counted from [TaskProgress.startedAtMs] and pausing does not refill it, so a
+ * task that has been alive for longer than [TaskLimits.maxWallClockMs] stays expired across restarts.
+ * That is deliberate: a budget that resets on resume is not a budget.
+ */
+object TaskResume {
+    fun plan(
+        progress: TaskProgress,
+        now: Long,
+        limits: TaskLimits = TaskLimits(),
+    ): ResumePlan {
+        if (progress.state.isTerminal) {
+            return ResumePlan.Blocked(ResumeBlock.ALREADY_TERMINAL, "task is ${progress.state.name}")
+        }
+        if (progress.attempts >= limits.maxAttempts) {
+            return ResumePlan.Blocked(
+                ResumeBlock.ATTEMPTS_EXHAUSTED,
+                "${progress.attempts}/${limits.maxAttempts} attempts used",
+            )
+        }
+        val elapsed = now - progress.startedAtMs
+        if (elapsed > limits.maxWallClockMs) {
+            return ResumePlan.Blocked(ResumeBlock.EXPIRED, "elapsed ${elapsed}ms of ${limits.maxWallClockMs}ms")
+        }
+
+        // A step with no side effects can be repeated, so an interrupted one simply runs again. A
+        // side-effecting one cannot: it waits for confirmSideEffect()/abandonSideEffect().
+        val toRun =
+            progress.steps
+                .filter { it.state == StepState.PENDING || it.state == StepState.FAILED || (it.isInFlight && !it.sideEffecting) }
+                .map { it.id }
+        val toConfirm = progress.unverifiedSideEffects.map { it.id }
+        if (toRun.isEmpty() && toConfirm.isEmpty()) {
+            return ResumePlan.Blocked(ResumeBlock.NOTHING_TO_RUN, "no open steps remain")
+        }
+        return ResumePlan.Resumable(
+            stepsToRun = toRun,
+            stepsNeedingConfirmation = toConfirm,
+            completedSteps = progress.completedSteps.map { it.id },
+        )
+    }
+
+    /**
+     * Applies a [ResumePlan.Resumable]: one attempt is spent, the task goes back to
+     * [TaskState.RUNNING], and interrupted non-side-effecting steps are reset so they run again.
+     *
+     * Returns the progress unchanged for a blocked plan, or when the state machine refuses the
+     * transition (a task that is not in a resumable state).
+     *
+     * [TaskFacts.approved] is passed as true on purpose: the only states that reach [TaskState.RUNNING]
+     * in the machine's table are READY, PAUSED and FAILED, and AWAITING_APPROVAL is not one of them - so
+     * approval was already granted before this task could be paused, failed or started.
+     */
+    fun begin(
+        progress: TaskProgress,
+        plan: ResumePlan,
+    ): ResumeOutcome {
+        if (plan !is ResumePlan.Resumable) return ResumeOutcome(plan, progress)
+        if (!TaskStateMachine.transition(progress.state, TaskState.RUNNING, TaskFacts(approved = true)).accepted) {
+            return ResumeOutcome(plan, progress)
+        }
+        val reset =
+            progress.steps.map { step ->
+                if (step.isInFlight && !step.sideEffecting) {
+                    step.copy(state = StepState.PENDING, finishedAtMs = null)
+                } else {
+                    step
+                }
+            }
+        return ResumeOutcome(plan, progress.copy(state = TaskState.RUNNING, attempts = progress.attempts + 1, steps = reset))
+    }
+
+    /** The user checked that a side-effecting step already landed (or wants it re-run): queue it again. */
+    fun confirmSideEffect(
+        progress: TaskProgress,
+        stepId: String,
+    ): TaskProgress = resetInflightSideEffect(progress, stepId, StepState.PENDING)
+
+    /** The user says the in-flight side effect should not be re-run: keep it out of the run. */
+    fun abandonSideEffect(
+        progress: TaskProgress,
+        stepId: String,
+    ): TaskProgress = resetInflightSideEffect(progress, stepId, StepState.SKIPPED)
+
+    /**
+     * Cancels the task, and reports which steps the caller has to actually stop.
+     *
+     * A cancellation that only hides the UI is not a cancellation, so the in-flight step ids come back
+     * with the result and are recorded as skipped here.
+     */
+    fun cancel(
+        progress: TaskProgress,
+        now: Long,
+    ): CancelOutcome {
+        val transition = TaskStateMachine.transition(progress.state, TaskState.CANCELLED)
+        if (transition !is TransitionResult.Allowed) {
+            return CancelOutcome.Refused((transition as TransitionResult.Rejected).reason)
+        }
+        val toStop = progress.inFlightSteps.map { it.id }
+        val stopped =
+            progress.steps.map { step ->
+                if (step.isInFlight) step.copy(state = StepState.SKIPPED, finishedAtMs = now) else step
+            }
+        return CancelOutcome.Cancelled(progress.copy(state = TaskState.CANCELLED, steps = stopped), toStop)
+    }
+
+    private fun resetInflightSideEffect(
+        progress: TaskProgress,
+        stepId: String,
+        to: StepState,
+    ): TaskProgress {
+        val step = progress.steps.firstOrNull { it.id == stepId }
+        if (step == null || !step.isInFlight) return progress
+        return progress.withStep(step.copy(state = to, startedAtMs = null, finishedAtMs = null))
+    }
+}
diff --git a/app/src/test/java/com/yugahashimoto/andcode/core/policy/ToolCallMapperTest.kt b/app/src/test/java/com/yugahashimoto/andcode/core/policy/ToolCallMapperTest.kt
