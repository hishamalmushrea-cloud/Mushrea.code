index 0000000..6725c9e
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyAuditLog.kt
@@ -0,0 +1,78 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * One decision the app made about one operation.
+ *
+ * Stores the redacted [PolicyOperation.summary] and the reason *codes*, never the raw command or the
+ * reason details: a code is enough to audit a decision later, and keeping free text out means a token
+ * that slipped into a command has no path into the log through this type.
+ */
+data class PolicyAuditEntry(
+    val timestampMs: Long,
+    /** `agent:<tool>` or `user:<action>` - who triggered the operation. */
+    val actor: String,
+    val operation: String,
+    val level: RiskLevel,
+    val decision: PolicyDecision,
+    val codes: List<PolicyReasonCode>,
+) {
+    /** Stable single-line form for a log file, a bug report or the task report. */
+    fun render(): String = "$timestampMs $actor ${level.name}/${decision.name} ${codes.joinToString(",")} $operation"
+}
+
+/**
+ * Bounded, in-memory audit trail of policy decisions.
+ *
+ * Bounded on purpose: a long agent session can ask thousands of times, and an unbounded list in a phone
+ * process is a leak. The oldest entry is dropped once [maxEntries] is reached, so whatever the user
+ * needs to review is always the recent past.
+ *
+ * This is not tamper-evident storage and does not survive process death; if the trail has to outlive
+ * the session it belongs in an append-only file, which is a separate, reviewed change.
+ */
+class InMemoryPolicyAuditLog(
+    private val maxEntries: Int = DEFAULT_MAX_ENTRIES,
+    private val clock: () -> Long = { System.currentTimeMillis() },
+) {
+    private val lock = Any()
+    private val entries = ArrayDeque<PolicyAuditEntry>()
+
+    init {
+        require(maxEntries > 0) { "maxEntries must be positive" }
+    }
+
+    /**
+     * Records the verdict for [operation]. Returns the stored entry so a caller that also reports to the
+     * user has the exact same value the log holds.
+     */
+    fun record(
+        operation: PolicyOperation,
+        assessment: RiskAssessment,
+        actor: String = "agent:${operation.tool}",
+        timestampMs: Long = clock(),
+    ): PolicyAuditEntry {
+        val entry =
+            PolicyAuditEntry(
+                timestampMs = timestampMs,
+                actor = actor,
+                operation = operation.summary,
+                level = assessment.level,
+                decision = assessment.decision,
+                codes = assessment.codes,
+            )
+        synchronized(lock) {
+            entries.addLast(entry)
+            while (entries.size > maxEntries) entries.removeFirst()
+        }
+        return entry
+    }
+
+    /** Oldest first. A copy, so callers cannot mutate the trail by accident. */
+    fun snapshot(): List<PolicyAuditEntry> = synchronized(lock) { entries.toList() }
+
+    val size: Int get() = synchronized(lock) { entries.size }
+
+    companion object {
+        const val DEFAULT_MAX_ENTRIES = 200
+    }
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyConfig.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyConfig.kt
new file mode 100644
index 0000000..ab85aa4
