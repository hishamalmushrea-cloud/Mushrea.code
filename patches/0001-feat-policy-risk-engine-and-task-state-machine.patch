@@ -35,6 +35,11 @@ object SecretRedaction {
                 "(?i)[A-Za-z0-9_-]*(?:api[_-]?key|access[_-]?token|refresh[_-]?token|auth[_-]?token|" +
                     "client[_-]?secret|secret|token|password)[\"']?\\s*[:=]\\s*[\"']?[^\\s,;}\"']+",
             ) to "<redacted>",
+            // CLI flag style (`--password value`, `--api-key value`), where no `:` or `=` joins the
+            // name to the value. The leading dashes keep it from firing on prose that merely contains
+            // the word "password"; tools that take credentials as arguments would otherwise echo them
+            // into a command line that the policy engine reports.
+            Regex("(?i)--?(?:password|passwd|token|secret|api[_-]?key|access[_-]?key)[\\s=]+[^\\s,;}\"']+") to "<redacted>",
             // URL userinfo (`https://user:pass@host/...`) has to be stripped before the query rule,
             // which otherwise leaves the credentials sitting in front of the host.
             Regex("(https?://)[^/@\\s:]+:[^/@\\s]+@") to "$1<redacted>@",
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskState.kt b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskState.kt
new file mode 100644
index 0000000..6b2b1dc
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskState.kt
@@ -0,0 +1,72 @@
+package com.yugahashimoto.andcode.core.task
+
+/**
+ * Where a development task stands.
+ *
+ * The set is the one the app shows in the task centre: a task that has not been inspected yet cannot
+ * look finished, and [CHECKS_PASSED] is the only state that means "the required checks actually ran and
+ * passed". Nothing here is inferred from the agent's own prose - see [TaskStateMachine] for the
+ * transitions and the facts they require.
+ */
+enum class TaskState {
+    /** Captured request, nothing read yet. */
+    DRAFT,
+
+    /** The agent (or the app) is reading the project to build context. */
+    INSPECTING,
+
+    /** A plan exists: files, risks, tests. */
+    PLANNED,
+
+    /** Waiting for the user to approve the plan or a high-risk step. */
+    AWAITING_APPROVAL,
+
+    /** Approved and able to run. */
+    READY,
+
+    /** Executing the plan. */
+    RUNNING,
+
+    /** Edits are done; the required checks are being run. */
+    VERIFYING,
+
+    /** A step failed. Retrying is allowed back into [INSPECTING] or [RUNNING] within the retry budget. */
+    FAILED,
+
+    /** Every required check ran and passed. */
+    CHECKS_PASSED,
+
+    /** The diff is ready for a human read. */
+    READY_FOR_REVIEW,
+
+    /** Reviewed and approved for release; shipping is a separate, explicit step. */
+    READY_TO_SHIP,
+
+    /** Shipped/merged/activated. Terminal. */
+    SHIPPED,
+
+    /** User cancelled. Terminal. */
+    CANCELLED,
+
+    /** Stopped, resumable from where it was. */
+    PAUSED,
+    ;
+
+    val isTerminal: Boolean get() = this == SHIPPED || this == CANCELLED
+}
+
+/**
+ * The facts a transition is allowed to depend on.
+ *
+ * Defaults are the conservative ones: nothing is approved and no check has passed, so a caller that
+ * forgets to fill this in cannot move a task into a success state. That is the whole point of keeping
+ * the guards here instead of trusting a summary the model wrote.
+ */
+data class TaskFacts(
+    /** Every check the plan requires has run and passed. */
+    val checksGreen: Boolean = false,
+    /** The user approved the plan or the pending high-risk step. */
+    val approved: Boolean = false,
+    /** At least one step failed since the last green check, so a "passed" claim is stale. */
+    val hasUnresolvedFailure: Boolean = false,
+)
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskStateMachine.kt b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskStateMachine.kt
new file mode 100644
index 0000000..f09f621
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/task/TaskStateMachine.kt
@@ -0,0 +1,113 @@
+package com.yugahashimoto.andcode.core.task
+
+/** Why a transition was refused. */
+enum class TransitionRejection {
+    /** The pair is not in the table: [TaskState.SHIPPED] cannot go anywhere, for example. */
+    ILLEGAL_TRANSITION,
+
+    /** Moving to [TaskState.CHECKS_PASSED] requires [TaskFacts.checksGreen]. */
+    CHECKS_NOT_GREEN,
+
+    /** Moving into execution or release requires [TaskFacts.approved]. */
+    NOT_APPROVED,
+
+    /** A previous failure has not been re-verified, so the success state would be a claim. */
+    STALE_FAILURE,
+}
+
+/** Outcome of asking for a transition. */
+sealed interface TransitionResult {
+    data class Allowed(val from: TaskState, val to: TaskState) : TransitionResult
+
+    data class Rejected(
+        val from: TaskState,
+        val to: TaskState,
+        val reason: TransitionRejection,
+    ) : TransitionResult
+
+    val accepted: Boolean get() = this is Allowed
+}
+
+/**
+ * The only place that decides whether a task may change state.
+ *
+ * Two families of rule:
+ *  1. a transition table, so a finished or cancelled task cannot be talked back into success;
+ *  2. guards on the facts, so "the checks passed" and "the user approved" have to be true *values*,
+ *     not sentences the agent produced. A task that failed and was never re-verified therefore cannot
+ *     reach [TaskState.CHECKS_PASSED] or [TaskState.SHIPPED] even if every step reports success.
+ *
+ * Pure Kotlin with no Android dependency so the rules can be unit tested without an emulator.
+ */
+object TaskStateMachine {
+    private val ALLOWED: Map<TaskState, Set<TaskState>> =
+        mapOf(
+            TaskState.DRAFT to setOf(TaskState.INSPECTING, TaskState.CANCELLED),
+            TaskState.INSPECTING to
+                setOf(TaskState.PLANNED, TaskState.FAILED, TaskState.PAUSED, TaskState.CANCELLED),
+            TaskState.PLANNED to
+                setOf(TaskState.AWAITING_APPROVAL, TaskState.READY, TaskState.CANCELLED),
+            TaskState.AWAITING_APPROVAL to
+                setOf(TaskState.READY, TaskState.FAILED, TaskState.PAUSED, TaskState.CANCELLED),
+            TaskState.READY to setOf(TaskState.RUNNING, TaskState.CANCELLED),
+            TaskState.RUNNING to
+                setOf(TaskState.VERIFYING, TaskState.FAILED, TaskState.PAUSED, TaskState.CANCELLED),
+            TaskState.VERIFYING to
+                setOf(TaskState.CHECKS_PASSED, TaskState.FAILED, TaskState.PAUSED, TaskState.CANCELLED),
+            TaskState.FAILED to setOf(TaskState.INSPECTING, TaskState.RUNNING, TaskState.CANCELLED),
+            TaskState.CHECKS_PASSED to setOf(TaskState.READY_FOR_REVIEW, TaskState.CANCELLED),
+            TaskState.READY_FOR_REVIEW to
+                setOf(TaskState.READY_TO_SHIP, TaskState.FAILED, TaskState.CANCELLED),
+            TaskState.READY_TO_SHIP to setOf(TaskState.SHIPPED, TaskState.CANCELLED),
+            TaskState.PAUSED to
+                setOf(TaskState.INSPECTING, TaskState.READY, TaskState.RUNNING, TaskState.CANCELLED),
+            TaskState.SHIPPED to emptySet(),
+            TaskState.CANCELLED to emptySet(),
+        )
+
+    fun transition(
+        from: TaskState,
+        to: TaskState,
+        facts: TaskFacts = TaskFacts(),
+    ): TransitionResult {
+        if (to !in ALLOWED.getValue(from)) return reject(from, to, TransitionRejection.ILLEGAL_TRANSITION)
+
+        val guardFailure = guardFailure(from, to, facts)
+        if (guardFailure != null) return reject(from, to, guardFailure)
+        return TransitionResult.Allowed(from, to)
+    }
+
+    private fun guardFailure(
+        from: TaskState,
+        to: TaskState,
+        facts: TaskFacts,
+    ): TransitionRejection? =
+        when (to) {
+            TaskState.CHECKS_PASSED ->
+                when {
+                    !facts.checksGreen -> TransitionRejection.CHECKS_NOT_GREEN
+                    facts.hasUnresolvedFailure -> TransitionRejection.STALE_FAILURE
+                    else -> null
+                }
+            // Leaving READY_FOR_REVIEW for release needs the same approval the plan needed, and a
+            // failure recorded after the last green run means the review was of stale code.
+            TaskState.READY_TO_SHIP -> if (facts.approved) null else TransitionRejection.NOT_APPROVED
+            TaskState.READY ->
+                when {
+                    // READY is the gate into execution, so it needs approval - except when the plan
+                    // itself only contained auto-approved (LOW) work, which the caller records as
+                    // approved = true after the policy engine said ALLOW.
+                    !facts.approved -> TransitionRejection.NOT_APPROVED
+                    from == TaskState.AWAITING_APPROVAL && facts.hasUnresolvedFailure -> TransitionRejection.STALE_FAILURE
+                    else -> null
+                }
+            TaskState.SHIPPED -> if (facts.approved) null else TransitionRejection.NOT_APPROVED
+            else -> null
+        }
+
+    private fun reject(
+        from: TaskState,
+        to: TaskState,
+        reason: TransitionRejection,
+    ) = TransitionResult.Rejected(from, to, reason)
+}
