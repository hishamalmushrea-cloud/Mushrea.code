+package com.yugahashimoto.andcode.core.task
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TaskStateMachineTest {
+    private val approved = TaskFacts(approved = true)
+    private val green = TaskFacts(approved = true, checksGreen = true)
+
+    @Test
+    fun `the full happy path is allowed`() {
+        val steps =
+            listOf(
+                TaskState.DRAFT to TaskState.INSPECTING,
+                TaskState.INSPECTING to TaskState.PLANNED,
+                TaskState.PLANNED to TaskState.AWAITING_APPROVAL,
+                TaskState.AWAITING_APPROVAL to TaskState.READY,
+                TaskState.READY to TaskState.RUNNING,
+                TaskState.RUNNING to TaskState.VERIFYING,
+                TaskState.VERIFYING to TaskState.CHECKS_PASSED,
+                TaskState.CHECKS_PASSED to TaskState.READY_FOR_REVIEW,
+                TaskState.READY_FOR_REVIEW to TaskState.READY_TO_SHIP,
+                TaskState.READY_TO_SHIP to TaskState.SHIPPED,
+            )
+        for ((from, to) in steps) {
+            val result = TaskStateMachine.transition(from, to, green)
+            assertTrue("$from -> $to should be allowed but was $result", result.accepted)
+        }
+    }
+
+    @Test
+    fun `a finished task cannot be restarted`() {
+        val result = TaskStateMachine.transition(TaskState.SHIPPED, TaskState.RUNNING, green)
+        assertFalse(result.accepted)
+        assertEquals(
+            TransitionRejection.ILLEGAL_TRANSITION,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `a cancelled task cannot report success`() {
+        assertFalse(TaskStateMachine.transition(TaskState.CANCELLED, TaskState.CHECKS_PASSED, green).accepted)
+        assertFalse(TaskStateMachine.transition(TaskState.CANCELLED, TaskState.SHIPPED, green).accepted)
+    }
+
+    @Test
+    fun `checks passed needs the checks to actually be green`() {
+        val result = TaskStateMachine.transition(TaskState.VERIFYING, TaskState.CHECKS_PASSED, approved)
+        assertEquals(
+            TransitionRejection.CHECKS_NOT_GREEN,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `a stale failure blocks the success claim even when checks look green`() {
+        val stale = TaskFacts(approved = true, checksGreen = true, hasUnresolvedFailure = true)
+        val result = TaskStateMachine.transition(TaskState.VERIFYING, TaskState.CHECKS_PASSED, stale)
+        assertEquals(
+            TransitionRejection.STALE_FAILURE,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `execution needs approval`() {
+        val result = TaskStateMachine.transition(TaskState.AWAITING_APPROVAL, TaskState.READY, TaskFacts())
+        assertEquals(
+            TransitionRejection.NOT_APPROVED,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `release needs approval even after a green review`() {
+        val result = TaskStateMachine.transition(TaskState.READY_FOR_REVIEW, TaskState.READY_TO_SHIP, TaskFacts(checksGreen = true))
+        assertEquals(
+            TransitionRejection.NOT_APPROVED,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `a failure can be retried from inspection or straight back into execution`() {
+        assertTrue(TaskStateMachine.transition(TaskState.FAILED, TaskState.INSPECTING, green).accepted)
+        assertTrue(TaskStateMachine.transition(TaskState.FAILED, TaskState.RUNNING, green).accepted)
+    }
+
+    @Test
+    fun `skipping verification to report success is illegal`() {
+        val result = TaskStateMachine.transition(TaskState.RUNNING, TaskState.CHECKS_PASSED, green)
+        assertEquals(
+            TransitionRejection.ILLEGAL_TRANSITION,
+            (result as TransitionResult.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `a paused task can resume into the work states`() {
+        assertTrue(TaskStateMachine.transition(TaskState.PAUSED, TaskState.RUNNING, green).accepted)
+        assertTrue(TaskStateMachine.transition(TaskState.PAUSED, TaskState.INSPECTING, green).accepted)
+        assertTrue(TaskStateMachine.transition(TaskState.PAUSED, TaskState.CANCELLED, green).accepted)
+    }
+
+    @Test
+    fun `terminal states are recognised`() {
+        assertTrue(TaskState.SHIPPED.isTerminal)
+        assertTrue(TaskState.CANCELLED.isTerminal)
+        assertFalse(TaskState.READY_FOR_REVIEW.isTerminal)
+    }
+}
