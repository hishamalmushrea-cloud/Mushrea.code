--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskLevel.kt
@@ -0,0 +1,21 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * How much damage an operation could do if the agent got it wrong.
+ *
+ * The levels are ordered, so the risk of a request that trips several rules is the highest level any
+ * single rule reported: [CRITICAL] > [HIGH] > [MEDIUM] > [LOW]. Rules live in [RiskEngine] and
+ * [CommandInspector]; nothing in this package consults a model to decide a level.
+ */
+enum class RiskLevel {
+    LOW,
+    MEDIUM,
+    HIGH,
+    CRITICAL,
+    ;
+
+    companion object {
+        /** The worst of the given levels, or [LOW] when there is nothing to compare. */
+        fun worstOf(levels: Iterable<RiskLevel>): RiskLevel = levels.maxOrNull() ?: LOW
+    }
+}
