+package com.yugahashimoto.andcode.core.policy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PolicyAuditLogTest {
+    private val operation =
+        PolicyOperation(
+            tool = "bash",
+            kind = OperationKind.RUN_COMMAND,
+            command = "cat /workspace/.env  --token sk-proj-abcdefghijklmnop",
+        )
+
+    @Test
+    fun `an entry keeps the codes and the redacted summary`() {
+        val assessment = RiskEngine.assess(operation, PolicyConfig())
+        val log = InMemoryPolicyAuditLog()
+        val entry = log.record(operation, assessment, timestampMs = 1_000)
+
+        assertEquals(1_000L, entry.timestampMs)
+        assertEquals("agent:bash", entry.actor)
+        assertEquals(assessment.decision, entry.decision)
+        assertEquals(assessment.codes, entry.codes)
+        assertFalse(entry.operation.contains("sk-proj-abcdefghijklmnop"))
+        assertFalse(entry.render().contains("sk-proj-abcdefghijklmnop"))
+    }
+
+    @Test
+    fun `the trail keeps only the newest entries`() {
+        val log = InMemoryPolicyAuditLog(maxEntries = 2)
+        val assessment = RiskEngine.assess(operation, PolicyConfig())
+        repeat(3) { index -> log.record(operation, assessment, timestampMs = index.toLong()) }
+
+        assertEquals(2, log.size)
+        assertEquals(listOf(1L, 2L), log.snapshot().map { it.timestampMs })
+    }
+
+    @Test
+    fun `snapshot is a copy`() {
+        val log = InMemoryPolicyAuditLog()
+        log.record(operation, RiskEngine.assess(operation, PolicyConfig()), timestampMs = 1)
+        val snapshot = log.snapshot().toMutableList()
+        snapshot.clear()
+        assertEquals(1, log.size)
+    }
+
+    @Test
+    fun `a non-positive capacity is refused`() {
+        val failure = runCatching { InMemoryPolicyAuditLog(maxEntries = 0) }.exceptionOrNull()
+        assertTrue(failure is IllegalArgumentException)
+    }
+}
