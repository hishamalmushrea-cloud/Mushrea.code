@@ -0,0 +1,262 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * Reads a shell line and reports the rules it trips before anything runs.
+ *
+ * This is a static, pattern-based inspection, not a shell parser: a determined command can always be
+ * written in a way it does not recognise (`printf '\\x72\\x6d' | sh`, a script on disk, an obfuscated
+ * base64 blob). It exists so the common destructive, privileged and publish-shaped commands are seen
+ * by the app instead of only by the model, and every known miss raises the level rather than lowering
+ * it. The real containment is still the runtime sandbox plus the approval prompt.
+ */
+internal object CommandInspector {
+    data class Finding(
+        val code: PolicyReasonCode,
+        val level: RiskLevel,
+        val deny: Boolean = false,
+        val detail: String,
+    )
+
+    data class Inspection(
+        val findings: List<Finding>,
+        /** True when every segment is a known read-only command with no redirection or substitution. */
+        val readOnly: Boolean,
+    )
+
+    private data class Rule(
+        val code: PolicyReasonCode,
+        val level: RiskLevel,
+        val deny: Boolean = false,
+        val regex: Regex,
+    )
+
+    /**
+     * Splits on shell separators without trying to honour quoting.
+     *
+     * A separator inside quotes therefore over-splits, which can only ever produce *more* findings for
+     * the same command - the direction an inspection wants to fail in.
+     */
+    private val SEPARATORS = Regex("(?:&&|\\|\\||;|\\||\\n)")
+
+    private val ELEVATION_PREFIXES = listOf("sudo ", "doas ", "pkexec ")
+
+    /**
+     * Read-only commands whose only effect is printing something already on disk. Anything that can
+     * write, delete or execute on its own is kept out of this list even when it is usually harmless:
+     * `find -delete` and `tar -x` are the obvious traps.
+     */
+    private val READ_ONLY_COMMANDS =
+        setOf(
+            "ls", "pwd", "cat", "head", "tail", "wc", "stat", "file", "grep", "egrep", "fgrep",
+            "rg", "tree", "which", "whoami", "id", "uname", "date", "du", "df", "echo", "true",
+        )
+
+    private val READ_ONLY_GIT_SUBCOMMANDS =
+        setOf("status", "diff", "log", "show", "branch", "remote", "rev-parse", "blame", "describe", "shortlog", "ls-files")
+
+    private val SECRET_READ_REGEX =
+        Regex(
+            "\\b(?:cat|less|more|head|tail|xxd|hexdump|base64|strings|cp|scp|rsync|tar|grep|rg)\\b[^;&|]*" +
+                "(?:\\.ssh/|id_rsa|id_ed25519|\\.git-credentials|\\.netrc|\\.npmrc|auth\\.json|" +
+                "\\.credentials\\.json|\\.gemini/|\\.codex/|\\.claude/|(?:^|[\\s/=])\\.env\\b)",
+        )
+
+    /**
+     * Segment rules. Matched against the segment lowercased with whitespace collapsed, so every
+     * pattern here has to be written in lowercase.
+     */
+    private val RULES =
+        listOf(
+            Rule(
+                PolicyReasonCode.POLICY_OVERRIDE,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("--dangerously-(skip|bypass)[a-z-]*"),
+            ),
+            Rule(
+                PolicyReasonCode.POLICY_OVERRIDE,
+                RiskLevel.HIGH,
+                regex = Regex("\\b(?:disable|bypass|turn\\s+off)\\b.{0,32}\\b(?:audit|approval|policy|sandbox)\\b"),
+            ),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.CRITICAL, deny = true, regex = Regex("\\bmkfs(?:\\.[a-z0-9]+)?\\b")),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.CRITICAL, deny = true, regex = Regex("\\bwipefs\\b")),
+            Rule(
+                PolicyReasonCode.DESTRUCTIVE_COMMAND,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("\\bdd\\b[^;&|]*\\bof=/dev/(?:sd|mmcblk|nvme|block|disk|mapper)"),
+            ),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.CRITICAL, deny = true, regex = Regex("\\bpm\\s+clear\\b")),
+            Rule(
+                PolicyReasonCode.DEVICE_OPERATION,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("\\bfastboot\\s+(?:flash|erase|oem\\s+unlock|flashing\\s+unlock|set_active)\\b"),
+            ),
+            Rule(
+                PolicyReasonCode.DEVICE_OPERATION,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("\\badb\\s+(?:reboot\\s+bootloader|sideload)\\b"),
+            ),
+            Rule(
+                PolicyReasonCode.DEVICE_OPERATION,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("\\bflashrom\\b"),
+            ),
+            Rule(PolicyReasonCode.SECRET_PATH, RiskLevel.HIGH, regex = SECRET_READ_REGEX),
+            Rule(
+                PolicyReasonCode.SECRET_PATH,
+                RiskLevel.HIGH,
+                regex = Regex("\\b(?:printenv)\\b|\\benv\\s*(?:$|[|;&])"),
+            ),
+            Rule(PolicyReasonCode.FORCE_PUSH, RiskLevel.HIGH, regex = Regex("\\bgit\\s+push\\b[^;&|]*\\s(?:-f|--force)(?:\\s|$)")),
+            Rule(
+                PolicyReasonCode.PROTECTED_BRANCH,
+                RiskLevel.HIGH,
+                regex = Regex("\\bgit\\s+push\\b[^;&|]*\\b(?:main|master)\\b"),
+            ),
+            Rule(
+                PolicyReasonCode.RELEASE_ACTION,
+                RiskLevel.HIGH,
+                regex = Regex("\\b(?:npm\\s+publish|gh\\s+release\\s+(?:create|upload)|bundletool\\b[^;&|]*\\bbuild-apks)\\b"),
+            ),
+            Rule(
+                PolicyReasonCode.RELEASE_ACTION,
+                RiskLevel.HIGH,
+                regex = Regex("\\bgradlew?\\b[^;&|]*\\b(?:assemblerelease|publish\\w*)\\b"),
+            ),
+            Rule(
+                PolicyReasonCode.RELEASE_ACTION,
+                RiskLevel.HIGH,
+                regex = Regex("\\bfastlane\\s+(?:supply|deploy|release)\\b"),
+            ),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.HIGH, regex = Regex("\\bgit\\s+reset\\s+--hard\\b")),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.HIGH, regex = Regex("\\bgit\\s+clean\\s+-[a-z]*f[a-z]*\\b")),
+            Rule(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.HIGH, regex = Regex("\\bshred\\b")),
+            Rule(
+                PolicyReasonCode.DEPENDENCY_CHANGE,
+                RiskLevel.MEDIUM,
+                regex =
+                    Regex(
+                        "\\b(?:pip3?|pipx)\\s+install\\b|\\bnpm\\s+(?:i|install|add)\\b|\\byarn\\s+add\\b|" +
+                            "\\bapt(?:-get)?\\s+(?:install|upgrade)\\b|\\bapk\\s+add\\b|\\bpkg\\s+install\\b|" +
+                            "\\bgo\\s+get\\b|\\bcargo\\s+install\\b",
+                    ),
+            ),
+            Rule(PolicyReasonCode.PERMISSION_CHANGE, RiskLevel.MEDIUM, regex = Regex("\\bchmod\\s+-R\\b")),
+            Rule(PolicyReasonCode.PERMISSION_CHANGE, RiskLevel.MEDIUM, regex = Regex("\\bchown\\s+-R\\b")),
+        )
+
+    /**
+     * Rules that only make sense on the whole line: `curl … | sh` is split into two innocuous segments
+     * by [SEPARATORS], so the pipe has to be matched before that split.
+     */
+    private val CROSS_SEGMENT_RULES =
+        listOf(
+            Rule(
+                PolicyReasonCode.DESTRUCTIVE_COMMAND,
+                RiskLevel.CRITICAL,
+                deny = true,
+                regex = Regex("\\b(?:curl|wget)\\b[^;&|]*\\|\\s*(?:sudo\\s+)?(?:ba|z|da|k)?sh\\b"),
+            ),
+        )
+
+    /** Recursive `rm` against a system directory: no approval can undo it, so it is refused. */
+    private val FATAL_RM_TARGETS =
+        setOf("/", "/system", "/data", "/dev", "/proc", "/sys", "/etc", "/usr", "/bin", "/sbin", "/boot", "/root", "/storage", "/sdcard")
+
+    private val URL_HOST = Regex("https?://([a-z0-9._-]+)")
+
+    fun inspect(
+        command: String,
+        allowedNetworkHosts: List<String> = emptyList(),
+    ): Inspection {
+        val trimmed = command.trim()
+        if (trimmed.isEmpty()) return Inspection(emptyList(), readOnly = false)
+
+        val findings = mutableListOf<Finding>()
+        val segments = trimmed.split(SEPARATORS).map { it.trim() }.filter { it.isNotEmpty() }
+        var allReadOnly = segments.isNotEmpty()
+
+        for (segment in segments) {
+            val lowered = segment.lowercase().replace(WHITESPACE, " ")
+            val (body, elevated) = stripElevation(lowered)
+            if (elevated) {
+                findings += Finding(PolicyReasonCode.ELEVATED_COMMAND, RiskLevel.HIGH, detail = describe(segment))
+            }
+            val segmentFindings = RULES.filter { it.regex.containsMatchIn(body) }.map { it.toFinding(segment) }.toMutableList()
+            rmFinding(body, segment)?.let { segmentFindings.plusAssign(it) }
+            findings += segmentFindings
+            if (elevated || segmentFindings.isNotEmpty() || !isReadOnly(body)) allReadOnly = false
+        }
+
+        val wholeLine = trimmed.lowercase().replace(WHITESPACE, " ")
+        for (rule in CROSS_SEGMENT_RULES) {
+            if (rule.regex.containsMatchIn(wholeLine) && findings.none { it.code == rule.code && it.deny }) {
+                findings += rule.toFinding(trimmed)
+            }
+        }
+        findings += networkFindings(trimmed, allowedNetworkHosts)
+        return Inspection(findings, readOnly = allReadOnly)
+    }
+
+    private fun Rule.toFinding(segment: String) = Finding(code, level, deny, describe(segment))
+
+    private fun stripElevation(lowered: String): Pair<String, Boolean> {
+        val prefix = ELEVATION_PREFIXES.firstOrNull { lowered.startsWith(it) } ?: return lowered to false
+        return lowered.removePrefix(prefix).trim() to true
+    }
+
+    private fun isReadOnly(lowered: String): Boolean {
+        if (lowered.contains('>') || lowered.contains('`') || lowered.contains("\$(")) return false
+        val tokens = lowered.split(' ').filter { it.isNotEmpty() }
+        val head = tokens.firstOrNull() ?: return false
+        if (head == "git") {
+            val sub = tokens.getOrNull(1)?.substringBefore(' ') ?: return false
+            return sub in READ_ONLY_GIT_SUBCOMMANDS
+        }
+        return head in READ_ONLY_COMMANDS
+    }
+
+    private fun rmFinding(
+        lowered: String,
+        segment: String,
+    ): Finding? {
+        val tokens = lowered.split(' ').filter { it.isNotEmpty() }
+        if (tokens.firstOrNull() != "rm") return null
+        val flags = tokens.drop(1).filter { it.startsWith("-") }
+        val recursive = flags.any { it.contains("--recursive") || it.drop(1).contains('r') }
+        if (!recursive) return null
+        val targets = tokens.drop(1).filterNot { it.startsWith("-") }.map { PolicyPaths.canonicalise(it) }
+        val fatal = targets.any { it in FATAL_RM_TARGETS }
+        return when {
+            fatal -> Finding(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.CRITICAL, deny = true, detail = describe(segment))
+            targets.any { !PolicyPaths.isInside(it, PolicyConfig.DEFAULT_WORKSPACE_ROOT) } ->
+                Finding(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.HIGH, detail = describe(segment))
+            else -> Finding(PolicyReasonCode.DESTRUCTIVE_COMMAND, RiskLevel.MEDIUM, detail = describe(segment))
+        }
+    }
+
+    private fun networkFindings(
+        command: String,
+        allowedNetworkHosts: List<String>,
+    ): List<Finding> =
+        URL_HOST.findAll(command.lowercase())
+            .map { it.groupValues[1] }
+            .filterNot { host -> allowedNetworkHosts.any { allowed -> host.allowsHost(allowed.lowercase()) } }
+            .distinct()
+            .map { Finding(PolicyReasonCode.UNKNOWN_NETWORK_HOST, RiskLevel.MEDIUM, detail = "egress to $it is not allowlisted") }
+            .toList()
+
+    private fun String.allowsHost(allowed: String): Boolean =
+        allowed.isNotBlank() && (this == allowed || endsWith(".$allowed"))
+
+    private fun describe(segment: String): String =
+        if (segment.length <= MAX_DETAIL) segment else segment.take(MAX_DETAIL) + "…"
+
+    private val WHITESPACE = Regex("\\s+")
+    private const val MAX_DETAIL = 160
+
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyAuditLog.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyAuditLog.kt
