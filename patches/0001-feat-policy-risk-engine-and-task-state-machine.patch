+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyConfig.kt
@@ -0,0 +1,84 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * The inputs to [RiskEngine] that the user (not the model) controls.
+ *
+ * Defaults are the conservative set: only [RiskLevel.LOW] is auto-approved, so an unconfigured
+ * install behaves exactly like today's approval UI - every other request still asks. Widening
+ * [autoApproveLevels] is a deliberate user action, and no tool payload can change these values.
+ */
+data class PolicyConfig(
+    /**
+     * Guest paths an agent may work in without extra approval. `/workspace` matches the sandbox path
+     * the runtimes mount the app's workspace directory at (see `WorkspaceFolders.WORKSPACE_ROOT`).
+     */
+    val workspaceRoots: List<String> = listOf(DEFAULT_WORKSPACE_ROOT),
+    /** Levels that execute without asking. Keep this at `[LOW]` unless the user opted out. */
+    val autoApproveLevels: Set<RiskLevel> = setOf(RiskLevel.LOW),
+    /** Above this many touched files a request is treated as a bulk change and needs approval. */
+    val bulkChangeThreshold: Int = DEFAULT_BULK_CHANGE_THRESHOLD,
+    /**
+     * Hosts the user allowed for egress. Empty means every host is reported as unknown, which raises
+     * a read-only network call to [RiskLevel.MEDIUM]; it never blocks the call by itself.
+     */
+    val allowedNetworkHosts: List<String> = emptyList(),
+    /** Files the app itself depends on; writing them can silently change what the agent runs. */
+    val protectedPathPatterns: List<String> = DEFAULT_PROTECTED_PATTERNS,
+    /** Credential material. Writes and deletes here are refused outright, reads need approval. */
+    val secretPathPatterns: List<String> = DEFAULT_SECRET_PATTERNS,
+) {
+    companion object {
+        const val DEFAULT_WORKSPACE_ROOT = "/workspace"
+        const val DEFAULT_BULK_CHANGE_THRESHOLD = 10
+
+        /**
+         * `.git/config` can point a remote at another host, `.git/hooks` executes on the next commit,
+         * and the rest decide what gets installed or signed. All are reachable from a normal agent
+         * session, so a write here is never LOW.
+         */
+        val DEFAULT_PROTECTED_PATTERNS =
+            listOf(
+                ".git/config",
+                ".git/hooks",
+                "gradle-wrapper.properties",
+                "keystore",
+                "*.jks",
+                "*.keystore",
+                "signing",
+            )
+
+        /**
+         * The credential files the on-device runtimes actually write under the PRoot root
+         * (`/root/.config/opencode/auth.json`, `/root/.gemini`, `CODEX_HOME=/root/.codex`,
+         * `/root/.git-credentials`), plus the usual SSH and package-manager stores.
+         */
+        val DEFAULT_SECRET_PATTERNS =
+            listOf(
+                ".env",
+                ".ssh",
+                "id_rsa",
+                "id_ed25519",
+                ".netrc",
+                ".npmrc",
+                ".git-credentials",
+                ".gnupg",
+                ".aws/credentials",
+                "auth.json",
+                ".credentials.json",
+                ".gemini",
+                ".codex",
+                ".claude",
+            )
+
+        /** A config that auto-approves everything is never the default and is not reachable from a tool payload. */
+        fun permissive(
+            workspaceRoots: List<String> = listOf(DEFAULT_WORKSPACE_ROOT),
+            allowedNetworkHosts: List<String> = emptyList(),
+        ): PolicyConfig =
+            PolicyConfig(
+                workspaceRoots = workspaceRoots,
+                autoApproveLevels = setOf(RiskLevel.LOW, RiskLevel.MEDIUM),
+                allowedNetworkHosts = allowedNetworkHosts,
+            )
+    }
+}
