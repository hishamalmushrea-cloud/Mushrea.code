+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyOperation.kt
@@ -0,0 +1,92 @@
+package com.yugahashimoto.andcode.core.policy
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/**
+ * What a tool call is about to do, in a form the policy engine can reason about without knowing the
+ * tool that produced it.
+ *
+ * Callers normalise a backend's tool payload once (a shell tool becomes [OperationKind.RUN_COMMAND]
+ * with [command] set, a patch tool becomes [OperationKind.WRITE_FILE] with [paths]) and the engine
+ * stays independent of every CLI's naming. Nothing here is executed: an operation is a description.
+ */
+data class PolicyOperation(
+    /** Tool name as the runtime reported it, kept for the audit trail only. */
+    val tool: String,
+    val kind: OperationKind,
+    /**
+     * Guest paths the operation reads, writes or deletes, in the same space the workspace uses
+     * (`/workspace/...`). Relative paths are resolved against the first configured workspace root.
+     */
+    val paths: List<String> = emptyList(),
+    /** The shell line for [OperationKind.RUN_COMMAND]; inspected by [CommandInspector]. */
+    val command: String? = null,
+    /** Hosts the operation would contact, when the caller knows them. */
+    val networkHosts: List<String> = emptyList(),
+    /**
+     * How many files the operation touches when that is more than [paths] lists - a bulk edit
+     * arrives as one request with hundreds of paths, and the count is what trips the bulk rule.
+     */
+    val fileCount: Int = 0,
+) {
+    /** Total files touched, never smaller than the listed paths. */
+    val touchedFileCount: Int get() = maxOf(fileCount, paths.size)
+
+    /**
+     * One-line description for logs and the approval sheet.
+     *
+     * The command is redacted and whitespace-collapsed here rather than at each logging call site,
+     * so a command that embeds a token cannot reach the audit log through a caller that forgot.
+     */
+    val summary: String
+        get() {
+            val target =
+                when {
+                    !command.isNullOrBlank() -> SecretRedaction.redact(command.trim().replace(WHITESPACE, " "))
+                    paths.isNotEmpty() -> paths.joinToString(", ")
+                    networkHosts.isNotEmpty() -> networkHosts.joinToString(", ")
+                    else -> "-"
+                }
+            val rendered = "${kind.name.lowercase()}[$tool] → $target"
+            return if (rendered.length <= MAX_SUMMARY_LENGTH) rendered else rendered.take(MAX_SUMMARY_LENGTH) + "…"
+        }
+
+    private companion object {
+        const val MAX_SUMMARY_LENGTH = 240
+        val WHITESPACE = Regex("\\s+")
+    }
+}
+
+/** The class of work a tool request performs. Rules are keyed on this, not on tool names. */
+enum class OperationKind {
+    READ_FILE,
+    WRITE_FILE,
+    DELETE_FILE,
+
+    /** Anything that runs a shell line, including `git` invocations. */
+    RUN_COMMAND,
+
+    /** An outbound request the caller performs itself (fetch/web tool). */
+    NETWORK,
+
+    /** Pushing commits, opening PRs, any git write that reaches a remote. */
+    VCS_PUSH,
+
+    /** Publishing anywhere: store uploads, releases, package registries. */
+    RELEASE,
+
+    /** Reads or writes aimed at credential material. */
+    SECRET_ACCESS,
+
+    /** Adding or upgrading a dependency. */
+    INSTALL_DEPENDENCY,
+
+    /** USB/ADB/fastboot style work on a device or its partitions. */
+    DEVICE_FLASH,
+
+    /** A request that would disable or loosen this policy itself. */
+    POLICY_OVERRIDE,
+
+    /** A tool whose payload the caller could not classify. */
+    UNKNOWN,
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyPaths.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyPaths.kt
new file mode 100644
index 0000000..cae1939
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/PolicyPaths.kt
@@ -0,0 +1,105 @@
+package com.yugahashimoto.andcode.core.policy
+
+/**
+ * Guest-path arithmetic for the policy engine.
+ *
+ * Deliberately separate from `feature.workspace.WorkspaceFolders`: that object is UI-facing and pulls
+ * Android storage in, while the engine has to stay pure Kotlin so it can be unit tested on the JVM and
+ * reused for the remote runtimes too.
+ */
+internal object PolicyPaths {
+    const val HOME = "/root"
+
+    /**
+     * Makes [path] absolute against [base], collapses `.`/`..` and drops trailing slashes.
+     *
+     * `..` never climbs above `/`: `/../../etc/passwd` is `/etc/passwd`. That matches what the guest
+     * shell would do, so "is this inside the workspace" is answered on the same path the command
+     * would actually touch.
+     */
+    fun canonicalise(
+        path: String,
+        base: String = PolicyConfig.DEFAULT_WORKSPACE_ROOT,
+    ): String {
+        val expanded = expandHome(path.trim())
+        val absolute = if (expanded.startsWith("/")) expanded else "${base.trimEnd('/')}/$expanded"
+        val segments = ArrayList<String>()
+        for (segment in absolute.split('/')) {
+            when (segment) {
+                "", "." -> Unit
+                ".." -> if (segments.isNotEmpty()) segments.removeAt(segments.lastIndex)
+                else -> segments.add(segment)
+            }
+        }
+        return "/" + segments.joinToString("/")
+    }
+
+    /** [path] is [root] itself or sits under it. Both sides are canonicalised first. */
+    fun isInside(
+        path: String,
+        root: String,
+    ): Boolean {
+        val canonicalRoot = canonicalise(root)
+        val canonicalPath = canonicalise(path, canonicalRoot)
+        return canonicalPath == canonicalRoot || canonicalPath.startsWith("${canonicalRoot.trimEnd('/')}/")
+    }
+
+    /**
+     * Glob-lite match of a canonical [path] against a [pattern] from [PolicyConfig].
+     *
+     * - `name` (no slash) matches that exact segment, or a segment starting with `name.`
+     *   (`.env` matches `.env.local`).
+     * - `dir/name` matches anywhere in the path (`/workspace/app/.git/config`).
+     * - `*` matches within one segment, `**` across segments, `?` one character.
+     *
+     * A pattern that matches nothing is inert; callers keep the lists small on purpose because this
+     * runs once per path per request.
+     */
+    fun matchesPattern(
+        path: String,
+        pattern: String,
+    ): Boolean {
+        val trimmed = pattern.trim().trim('/')
+        if (trimmed.isEmpty()) return false
+        val segments = path.split('/').filter { it.isNotEmpty() }
+        return when {
+            trimmed.contains('*') || trimmed.contains('?') -> {
+                val regex = toRegex(trimmed)
+                regex.matches(path.trim('/')) || segments.any { regex.matches(it) }
+            }
+            trimmed.contains('/') -> {
+                val needle = "/$trimmed"
+                path.endsWith(needle) || path.contains("$needle/")
+            }
+            else -> segments.any { it.equals(trimmed, ignoreCase = true) || it.startsWith("$trimmed.", ignoreCase = true) }
+        }
+    }
+
+    private fun expandHome(path: String): String =
+        when {
+            path == "~" || path.startsWith("~/") -> HOME + path.removePrefix("~")
+            path == "\$HOME" || path.startsWith("\$HOME/") -> HOME + path.removePrefix("\$HOME")
+            else -> path
+        }
+
+    private fun toRegex(pattern: String): Regex {
+        val builder = StringBuilder()
+        var index = 0
+        while (index < pattern.length) {
+            val char = pattern[index]
+            when {
+                char == '*' && index + 1 < pattern.length && pattern[index + 1] == '*' -> {
+                    builder.append(".*")
+                    index += 2
+                    continue
+                }
+                char == '*' -> builder.append("[^/]*")
+                char == '?' -> builder.append("[^/]")
+                char in ".^$+{}()[]|\\" -> builder.append('\\').append(char)
+                else -> builder.append(char)
+            }
+            index++
+        }
+        return Regex(builder.toString(), RegexOption.IGNORE_CASE)
+    }
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskAssessment.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskAssessment.kt
new file mode 100644
index 0000000..590f144
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskAssessment.kt
@@ -0,0 +1,74 @@
+package com.yugahashimoto.andcode.core.policy
+
+/** What the app is allowed to do with an assessed [PolicyOperation]. */
+enum class PolicyDecision {
+    /** Run it without asking. */
+    ALLOW,
+
+    /** Ask first: the UI shows [RiskAssessment.reasons] and the user decides. */
+    REQUIRE_APPROVAL,
+
+    /**
+     * Refuse it regardless of the answer to any prompt.
+     *
+     * Reserved for operations a static rule forbids - disarming the policy, writing credential
+     * material, wiping the root filesystem, firmware flashing. No chat message, tool payload or
+     * model output can turn a [DENY] into an approval.
+     */
+    DENY,
+}
+
+/** Which rule fired. Codes are stable so tests, the audit log and the UI can rely on them. */
+enum class PolicyReasonCode {
+    /** Nothing escalated: the operation stays inside an allowed workspace. */
+    WITHIN_POLICY,
+
+    INSIDE_WORKSPACE,
+    OUTSIDE_WORKSPACE,
+    SECRET_PATH,
+    PROTECTED_PATH,
+    DESTRUCTIVE_COMMAND,
+    ELEVATED_COMMAND,
+    FORCE_PUSH,
+    PROTECTED_BRANCH,
+    RELEASE_ACTION,
+    BULK_CHANGE,
+    UNKNOWN_NETWORK_HOST,
+    UNKNOWN_OPERATION,
+    POLICY_OVERRIDE,
+    DEVICE_OPERATION,
+    DEPENDENCY_CHANGE,
+    PERMISSION_CHANGE,
+    SHELL_COMMAND,
+    NETWORK_EGRESS,
+    READ_ONLY,
+}
+
+/**
+ * One reason a level was raised.
+ *
+ * [detail] is already redacted by [RiskEngine] - it is safe to log and to show in the approval sheet.
+ */
+data class PolicyReason(
+    val code: PolicyReasonCode,
+    val detail: String,
+)
+
+/**
+ * The engine's verdict. Deliberately plain data: the caller decides how to surface it, and the same
+ * value is what gets written to the audit log.
+ */
+data class RiskAssessment(
+    val level: RiskLevel,
+    val decision: PolicyDecision,
+    val reasons: List<PolicyReason>,
+) {
+    /** True when the user has to see this before it runs (approval) or it must not run at all (deny). */
+    val requiresAttention: Boolean get() = decision != PolicyDecision.ALLOW
+
+    /** Codes in firing order, worst first; the audit log stores these instead of free text. */
+    val codes: List<PolicyReasonCode> get() = reasons.map { it.code }
+
+    /** Single-line rendering for logs: `HIGH/REQUIRE_APPROVAL [OUTSIDE_WORKSPACE, ...]`. */
+    fun render(): String = "${level.name}/${decision.name} ${codes.joinToString(prefix = "[", postfix = "]")}"
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskEngine.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskEngine.kt
new file mode 100644
index 0000000..2e1c647
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskEngine.kt
@@ -0,0 +1,197 @@
+package com.yugahashimoto.andcode.core.policy
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/**
+ * Decides, in the app, how risky an agent's next operation is.
+ *
+ * The model never grades its own work here: [assess] is a pure function of the operation the caller
+ * built and the [PolicyConfig] the user owns, so the same input always yields the same verdict and a
+ * tool payload cannot talk itself into an approval. This is the piece that makes "the app enforces the
+ * policy" true rather than "the prompt asks the model to behave".
+ *
+ * Scope, stated honestly: the levels are advisory-to-blocking at the *app* boundary. Anything the
+ * guest runtime runs is still bounded by PRoot and the CLI's own permission mode, not by this engine.
+ */
+object RiskEngine {
+    /** Findings reported per request cap the log/sheet size; the verdict still uses every one. */
+    private const val MAX_PATH_FINDINGS = 5
+
+    private data class KindPathPolicy(
+        val insideLevel: RiskLevel,
+        val outsideLevel: RiskLevel,
+        val protectedLevel: RiskLevel,
+        val secretLevel: RiskLevel,
+        val secretDeny: Boolean,
+    )
+
+    private val READ_POLICY = KindPathPolicy(RiskLevel.LOW, RiskLevel.MEDIUM, RiskLevel.HIGH, RiskLevel.HIGH, false)
+    private val WRITE_POLICY = KindPathPolicy(RiskLevel.LOW, RiskLevel.HIGH, RiskLevel.HIGH, RiskLevel.CRITICAL, true)
+    private val DELETE_POLICY = KindPathPolicy(RiskLevel.MEDIUM, RiskLevel.CRITICAL, RiskLevel.CRITICAL, RiskLevel.CRITICAL, true)
+
+    fun assess(
+        operation: PolicyOperation,
+        config: PolicyConfig = PolicyConfig(),
+    ): RiskAssessment {
+        val findings = mutableListOf<CommandInspector.Finding>()
+        findings += kindFindings(operation, config)
+
+        if (!operation.command.isNullOrBlank()) {
+            findings += CommandInspector.inspect(operation.command, config.allowedNetworkHosts).findings
+        }
+        if (operation.touchedFileCount > config.bulkChangeThreshold) {
+            findings +=
+                CommandInspector.Finding(
+                    PolicyReasonCode.BULK_CHANGE,
+                    RiskLevel.MEDIUM,
+                    detail = "${operation.touchedFileCount} files touched, threshold is ${config.bulkChangeThreshold}",
+                )
+        }
+        if (findings.isEmpty()) {
+            findings += CommandInspector.Finding(PolicyReasonCode.WITHIN_POLICY, RiskLevel.LOW, detail = "no rule escalated")
+        }
+
+        // Worst first so the approval sheet leads with what matters; the sort is stable, so rules of
+        // equal level keep the order they are declared in.
+        val ordered = findings.sortedByDescending { it.level.ordinal }
+        val level = RiskLevel.worstOf(ordered.map { it.level })
+        val decision =
+            when {
+                ordered.any { it.deny } -> PolicyDecision.DENY
+                level in config.autoApproveLevels -> PolicyDecision.ALLOW
+                else -> PolicyDecision.REQUIRE_APPROVAL
+            }
+        return RiskAssessment(
+            level = level,
+            decision = decision,
+            reasons = ordered.map { PolicyReason(it.code, SecretRedaction.redact(it.detail)) },
+        )
+    }
+
+    private fun kindFindings(
+        operation: PolicyOperation,
+        config: PolicyConfig,
+    ): List<CommandInspector.Finding> =
+        when (operation.kind) {
+            OperationKind.READ_FILE -> pathFindings(operation, config, READ_POLICY)
+            OperationKind.WRITE_FILE -> pathFindings(operation, config, WRITE_POLICY)
+            OperationKind.DELETE_FILE -> pathFindings(operation, config, DELETE_POLICY)
+            OperationKind.SECRET_ACCESS -> pathFindings(operation, config, READ_POLICY) + secretFinding(operation)
+            OperationKind.RUN_COMMAND -> commandFindings(operation, config)
+            OperationKind.NETWORK -> networkFindings(operation, config)
+            OperationKind.VCS_PUSH -> listOf(finding(PolicyReasonCode.OUTSIDE_WORKSPACE, RiskLevel.MEDIUM, "push reaches a remote"))
+            OperationKind.RELEASE -> listOf(finding(PolicyReasonCode.RELEASE_ACTION, RiskLevel.HIGH, "publishes outside the device"))
+            OperationKind.INSTALL_DEPENDENCY ->
+                listOf(finding(PolicyReasonCode.DEPENDENCY_CHANGE, RiskLevel.MEDIUM, "adds or upgrades a dependency"))
+            OperationKind.DEVICE_FLASH ->
+                listOf(finding(PolicyReasonCode.DEVICE_OPERATION, RiskLevel.CRITICAL, "device/partition operation", deny = true))
+            OperationKind.POLICY_OVERRIDE ->
+                listOf(finding(PolicyReasonCode.POLICY_OVERRIDE, RiskLevel.CRITICAL, "would loosen the policy", deny = true))
+            OperationKind.UNKNOWN -> listOf(finding(PolicyReasonCode.UNKNOWN_OPERATION, RiskLevel.MEDIUM, "tool could not be classified"))
+        }
+
+    private fun commandFindings(
+        operation: PolicyOperation,
+        config: PolicyConfig,
+    ): List<CommandInspector.Finding> {
+        val command = operation.command
+        if (command.isNullOrBlank()) {
+            return listOf(finding(PolicyReasonCode.UNKNOWN_OPERATION, RiskLevel.MEDIUM, "shell operation without a command line"))
+        }
+        val inspection = CommandInspector.inspect(command, config.allowedNetworkHosts)
+        val baseline =
+            if (inspection.readOnly) {
+                finding(PolicyReasonCode.READ_ONLY, RiskLevel.LOW, "known read-only command")
+            } else {
+                finding(PolicyReasonCode.SHELL_COMMAND, RiskLevel.MEDIUM, "runs a shell command")
+            }
+        return listOf(baseline) + inspection.findings
+    }
+
+    private fun networkFindings(
+        operation: PolicyOperation,
+        config: PolicyConfig,
+    ): List<CommandInspector.Finding> {
+        if (operation.networkHosts.isEmpty()) {
+            return listOf(finding(PolicyReasonCode.NETWORK_EGRESS, RiskLevel.MEDIUM, "network request with no host metadata"))
+        }
+        val unknown = operation.networkHosts.filterNot { host -> config.allowedNetworkHosts.any { it.hostMatches(host) } }
+        return if (unknown.isEmpty()) {
+            listOf(finding(PolicyReasonCode.WITHIN_POLICY, RiskLevel.LOW, "allowlisted host"))
+        } else {
+            unknown.map {
+                finding(PolicyReasonCode.UNKNOWN_NETWORK_HOST, RiskLevel.MEDIUM, "egress to $it is not allowlisted")
+            }
+        }
+    }
+
+    private fun pathFindings(
+        operation: PolicyOperation,
+        config: PolicyConfig,
+        policy: KindPathPolicy,
+    ): List<CommandInspector.Finding> {
+        if (operation.paths.isEmpty()) {
+            return listOf(finding(PolicyReasonCode.UNKNOWN_OPERATION, RiskLevel.MEDIUM, "no path was reported for a file operation"))
+        }
+        val base = config.workspaceRoots.firstOrNull() ?: PolicyConfig.DEFAULT_WORKSPACE_ROOT
+        val findings =
+            operation.paths.map { raw ->
+                val path = PolicyPaths.canonicalise(raw, base)
+                val secret = config.secretPathPatterns.firstOrNull { PolicyPaths.matchesPattern(path, it) }
+                val protected = config.protectedPathPatterns.firstOrNull { PolicyPaths.matchesPattern(path, it) }
+                val inside = config.workspaceRoots.any { PolicyPaths.isInside(path, it) }
+                when {
+                    secret != null ->
+                        CommandInspector.Finding(
+                            PolicyReasonCode.SECRET_PATH,
+                            policy.secretLevel,
+                            deny = policy.secretDeny,
+                            detail = "$path matches credential pattern '$secret'",
+                        )
+                    protected != null ->
+                        CommandInspector.Finding(
+                            PolicyReasonCode.PROTECTED_PATH,
+                            policy.protectedLevel,
+                            detail = "$path matches protected pattern '$protected'",
+                        )
+                    !inside ->
+                        CommandInspector.Finding(
+                            PolicyReasonCode.OUTSIDE_WORKSPACE,
+                            policy.outsideLevel,
+                            detail = "$path is outside ${config.workspaceRoots.joinToString()}",
+                        )
+                    else -> CommandInspector.Finding(PolicyReasonCode.INSIDE_WORKSPACE, policy.insideLevel, detail = path)
+                }
+            }
+        if (findings.size <= MAX_PATH_FINDINGS) return findings
+        val head = findings.take(MAX_PATH_FINDINGS)
+        val rest = findings.drop(MAX_PATH_FINDINGS)
+        return head +
+            CommandInspector.Finding(
+                PolicyReasonCode.BULK_CHANGE,
+                RiskLevel.worstOf(rest.map { it.level }),
+                deny = rest.any { it.deny },
+                detail = "${rest.size} further paths, worst ${RiskLevel.worstOf(rest.map { it.level }).name}",
+            )
+    }
+
+    private fun secretFinding(operation: PolicyOperation): List<CommandInspector.Finding> =
+        if (operation.kind == OperationKind.SECRET_ACCESS && operation.paths.isEmpty()) {
+            listOf(finding(PolicyReasonCode.SECRET_PATH, RiskLevel.HIGH, "reads credential material"))
+        } else {
+            emptyList()
+        }
+
+    private fun finding(
+        code: PolicyReasonCode,
+        level: RiskLevel,
+        detail: String,
+        deny: Boolean = false,
+    ) = CommandInspector.Finding(code, level, deny, detail)
+
+    private fun String.hostMatches(host: String): Boolean {
+        val allowed = lowercase().trim()
+        val candidate = host.lowercase().trim()
+        return allowed.isNotEmpty() && (candidate == allowed || candidate.endsWith(".$allowed"))
+    }
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskLevel.kt b/app/src/main/java/com/yugahashimoto/andcode/core/policy/RiskLevel.kt
