+package com.yugahashimoto.andcode.core.buildcheck
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectDetectorTest {
+    @Test
+    fun `an android project is detected from its manifest and gradle settings`() {
+        val profile =
+            ProjectDetector.detect(
+                listOf(
+                    "settings.gradle.kts",
+                    "build.gradle.kts",
+                    "app/build.gradle.kts",
+                    "app/src/main/AndroidManifest.xml",
+                ),
+            )
+
+        assertEquals(ProjectType.ANDROID_GRADLE, profile.type)
+        assertEquals("gradle", profile.buildSystem)
+        assertTrue(profile.needsExternalSdkMessage())
+        assertTrue(profile.evidence.any { it.endsWith("AndroidManifest.xml") })
+        assertEquals(
+            listOf("android.unit-test", "android.detekt", "android.assemble-debug"),
+            profile.checks.map { it.id },
+        )
+    }
+
+    @Test
+    fun `a plain gradle project is not mistaken for android`() {
+        val profile = ProjectDetector.detect(listOf("settings.gradle.kts", "build.gradle.kts"))
+        assertEquals(ProjectType.JVM_GRADLE, profile.type)
+        assertFalse(profile.unavailable.any { it.contains("Android SDK") })
+    }
+
+    @Test
+    fun `a gradle project with an android manifest flag counts as android`() {
+        val profile = ProjectDetector.detect(listOf("settings.gradle", "app/build.gradle"), hasAndroidManifest = true)
+        assertEquals(ProjectType.ANDROID_GRADLE, profile.type)
+    }
+
+    @Test
+    fun `node is detected and gets a typecheck only when typescript is configured`() {
+        val plain = ProjectDetector.detect(listOf("package.json", "index.js"))
+        assertEquals(ProjectType.NODE, plain.type)
+        assertEquals(listOf("node.test"), plain.checks.map { it.id })
+
+        val typed = ProjectDetector.detect(listOf("package.json", "tsconfig.json"))
+        assertTrue(typed.checks.any { it.id == "node.typecheck" })
+    }
+
+    @Test
+    fun `python gets pytest only when a pytest marker exists`() {
+        assertEquals(listOf("python.compile"), ProjectDetector.detect(listOf("requirements.txt")).checks.map { it.id })
+        assertTrue(ProjectDetector.detect(listOf("pyproject.toml", "conftest.py")).checks.any { it.id == "python.pytest" })
+    }
+
+    @Test
+    fun `rust and go are detected`() {
+        assertEquals(ProjectType.RUST, ProjectDetector.detect(listOf("Cargo.toml", "src/main.rs")).type)
+        assertEquals(ProjectType.GO, ProjectDetector.detect(listOf("go.mod", "main.go")).type)
+    }
+
+    @Test
+    fun `an unrecognised workspace reports no checks and says why`() {
+        val profile = ProjectDetector.detect(listOf("notes.txt", "data.csv"))
+        assertEquals(ProjectType.UNKNOWN, profile.type)
+        assertTrue(profile.checks.isEmpty())
+        assertTrue(profile.unavailable.single().contains("no recognised build file"))
+    }
+
+    @Test
+    fun `every generated check is safe and stays inside the limits`() {
+        val paths =
+            listOf(
+                "settings.gradle.kts",
+                "app/src/main/AndroidManifest.xml",
+                "package.json",
+                "tsconfig.json",
+                "pyproject.toml",
+                "conftest.py",
+                "Cargo.toml",
+                "go.mod",
+            )
+        for (type in ProjectType.entries) {
+            val profile =
+                when (type) {
+                    ProjectType.ANDROID_GRADLE -> ProjectDetector.detect(paths)
+                    else -> ProjectDetector.detect(paths.filter { it != "settings.gradle.kts" && !it.contains("AndroidManifest") })
+                }
+            profile.checks.forEach { check ->
+                assertTrue("${check.id} is unsafe", check.isSafe)
+                assertTrue(check.timeoutMs <= CheckCommand.MAX_TIMEOUT_MS)
+                assertTrue(check.maxOutputBytes <= CheckCommand.MAX_OUTPUT_BYTES)
+            }
+        }
+    }
+
+    @Test
+    fun `a shell metacharacter in an argument makes the check unsafe`() {
+        val check = CheckCommand("bad", "./gradlew", listOf("test; rm -rf /"), CheckCategory.UNIT_TEST)
+        assertFalse(check.isSafe)
+        val injected = CheckCommand("bad2", "./gradlew", listOf("test", "--project-cache-dir=\$(whoami)"), CheckCategory.BUILD)
+        assertFalse(injected.isSafe)
+    }
+
+    @Test
+    fun `an executable outside the allowlist is refused`() {
+        val check = CheckCommand("custom", "./scripts/deploy.sh", emptyList(), CheckCategory.BUILD)
+        assertFalse(check.isSafe)
+        assertEquals(emptyList<CheckCommand>(), ProjectDetector.detect(listOf("package.json")).checks.filter { !it.isSafe })
+    }
+
+    @Test
+    fun `the fastest signal prefers the unit test check`() {
+        val profile = ProjectDetector.detect(listOf("settings.gradle.kts", "app/src/main/AndroidManifest.xml"))
+        assertEquals("android.unit-test", profile.fastestSignal()?.id)
+
+        val python = ProjectDetector.detect(listOf("requirements.txt"))
+        assertEquals("python.compile", python.fastestSignal()?.id)
+    }
+
+    @Test
+    fun `checks can be selected by category`() {
+        val profile = ProjectDetector.detect(listOf("Cargo.toml"))
+        assertEquals(listOf("rust.test"), profile.checksFor(setOf(CheckCategory.UNIT_TEST)).map { it.id })
+    }
+
+    private fun ProjectProfile.needsExternalSdkMessage() = unavailable.any { it.contains("Android SDK") }
+}
