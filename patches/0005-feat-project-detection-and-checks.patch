+++ b/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/FailureClassifier.kt
@@ -0,0 +1,133 @@
+package com.yugahashimoto.andcode.core.buildcheck
+
+/**
+ * Sorts a failed check into [FailureClass] by the signatures its output actually contains.
+ *
+ * The ordering of the rules is the whole design: a missing Android SDK prints `error:` lines all over the
+ * log, so environment signatures have to win over code signatures, or every setup problem would be
+ * reported to the user as "your code is broken". A class the classifier cannot justify stays
+ * [FailureClass.UNKNOWN] rather than being guessed, because a wrong guess sends the next step of the task
+ * in the wrong direction.
+ *
+ * The retry hint is separate on purpose: nothing here retries, it only says whether a retry could ever help.
+ */
+object FailureClassifier {
+    data class Verdict(
+        val failureClass: FailureClass,
+        val evidence: String?,
+        /** Environment failures are not fixed by re-running; timeouts might be, once, with more room. */
+        val retryable: Boolean,
+    )
+
+    private data class Rule(
+        val failureClass: FailureClass,
+        val phrases: List<String>,
+        val retryable: Boolean,
+    )
+
+    private val RULES =
+        listOf(
+            Rule(
+                FailureClass.ENVIRONMENT,
+                listOf(
+                    "sdk location not found",
+                    "android_sdk_root",
+                    "android_home",
+                    "java_home is not set",
+                    "could not resolve all dependencies",
+                    "could not resolve",
+                    "could not download",
+                    "could not get resource",
+                    "connection refused",
+                    "network is unreachable",
+                    "temporary failure in name resolution",
+                    "no space left on device",
+                    "permission denied",
+                    "command not found",
+                    "is not recognized as an internal or external command",
+                    "unable to locate android sdk",
+                    "failed to install the following android sdk",
+                ),
+                retryable = false,
+            ),
+            Rule(
+                FailureClass.TEST,
+                listOf(
+                    "tests failed",
+                    "there were failing tests",
+                    "failed tests:",
+                    "assertionerror",
+                    "test failed",
+                    "failures!",
+                    "failed (failures=",
+                ),
+                retryable = false,
+            ),
+            Rule(
+                FailureClass.CODE,
+                listOf(
+                    "unresolved reference",
+                    "compilation error",
+                    "compilation failed",
+                    "compileerror",
+                    "syntaxerror",
+                    "e: file:",
+                    "error: ",
+                    "detekt",
+                    "spotless",
+                    "ktlint",
+                    "tsc error",
+                    "type error",
+                ),
+                retryable = false,
+            ),
+        )
+
+    fun classify(
+        exitCode: Int?,
+        timedOut: Boolean,
+        output: String,
+    ): Verdict {
+        if (timedOut) {
+            return Verdict(FailureClass.TIMEOUT, "the check exceeded its time budget", retryable = true)
+        }
+        if (exitCode == 0) return Verdict(FailureClass.UNKNOWN, null, retryable = false)
+
+        val haystack = output.lowercase()
+        for (rule in RULES) {
+            val hit = rule.phrases.firstOrNull { haystack.contains(it) }
+            if (hit != null) return Verdict(rule.failureClass, lineContaining(output, hit), rule.retryable)
+        }
+        return Verdict(FailureClass.UNKNOWN, null, retryable = false)
+    }
+
+    /** Builds the result record, so callers cannot disagree with the classifier about [CheckResult.passed]. */
+    fun result(
+        command: CheckCommand,
+        exitCode: Int?,
+        timedOut: Boolean,
+        output: String,
+    ): CheckResult {
+        val verdict = classify(exitCode, timedOut, output)
+        return CheckResult(
+            command = command,
+            exitCode = exitCode,
+            timedOut = timedOut,
+            output = output.takeLast(command.maxOutputBytes.toInt().coerceAtLeast(1)),
+            failure = if (exitCode == 0 && !timedOut) FailureClass.UNKNOWN else verdict.failureClass,
+            failureEvidence = verdict.evidence,
+        )
+    }
+
+    /** Trims the log around the matched phrase: the line itself, and never the whole build output. */
+    private fun lineContaining(
+        output: String,
+        phrase: String,
+    ): String? =
+        output.lineSequence()
+            .firstOrNull { it.lowercase().contains(phrase) }
+            ?.trim()
+            ?.take(MAX_EVIDENCE_LENGTH)
+
+    private const val MAX_EVIDENCE_LENGTH = 200
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectDetector.kt b/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectDetector.kt
