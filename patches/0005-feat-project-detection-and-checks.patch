+++ b/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectDetector.kt
@@ -0,0 +1,174 @@
+package com.yugahashimoto.andcode.core.buildcheck
+
+/**
+ * Works out what a workspace is and which checks make sense, from its file list alone.
+ *
+ * Deliberate limits, stated because they are the difference between a useful hint and a false promise:
+ * this does not read file contents, does not run anything, and cannot know whether the toolchain those
+ * checks need exists on this device. It reports both the evidence and the [ProjectProfile.unavailable]
+ * constraints so the task UI can say "this project needs an Android SDK this device does not have" instead
+ * of running a build that fails for an unrelated-looking reason.
+ */
+object ProjectDetector {
+    /** Files checked in order of specificity; the first matching type wins. */
+    private val MARKERS =
+        listOf(
+            ProjectType.ANDROID_GRADLE to listOf("settings.gradle.kts", "settings.gradle", "AndroidManifest.xml"),
+            ProjectType.JVM_GRADLE to listOf("build.gradle.kts", "build.gradle", "settings.gradle.kts", "settings.gradle"),
+            ProjectType.NODE to listOf("package.json"),
+            ProjectType.PYTHON to listOf("pyproject.toml", "requirements.txt", "setup.py"),
+            ProjectType.RUST to listOf("Cargo.toml"),
+            ProjectType.GO to listOf("go.mod"),
+        )
+
+    fun detect(
+        paths: List<String>,
+        hasAndroidManifest: Boolean = false,
+    ): ProjectProfile {
+        val files = paths.map { it.trim().trimStart('/') }.filter { it.isNotEmpty() }
+        val names = files.map { it.substringAfterLast('/') }.toSet()
+        val androidMarkers = files.any { it.endsWith("AndroidManifest.xml") } || hasAndroidManifest
+
+        if (androidMarkers && hasGradleSettings(names)) {
+            return profile(
+                type = ProjectType.ANDROID_GRADLE,
+                buildSystem = "gradle",
+                evidence = evidence(files, "AndroidManifest.xml", "settings.gradle.kts", "settings.gradle", "build.gradle.kts"),
+                checks = androidChecks(),
+                unavailable =
+                    listOf(
+                        "an Android SDK and JDK are required; a device without them cannot run these checks",
+                        "a release build needs a signing key, which is never handled by an automated check",
+                    ),
+            )
+        }
+        if (hasGradleSettings(names) || names.contains("build.gradle.kts") || names.contains("build.gradle")) {
+            return profile(
+                ProjectType.JVM_GRADLE,
+                "gradle",
+                evidence(files, "settings.gradle.kts", "settings.gradle", "build.gradle.kts", "build.gradle"),
+                jvmChecks(),
+                unavailable = listOf("a JDK is required"),
+            )
+        }
+        if (names.contains("package.json")) {
+            return profile(
+                ProjectType.NODE,
+                "npm",
+                evidence(files, "package.json", "tsconfig.json", "package-lock.json"),
+                nodeChecks(hasTsConfig = names.contains("tsconfig.json")),
+            )
+        }
+        if (names.any { it in setOf("pyproject.toml", "requirements.txt", "setup.py") }) {
+            return profile(
+                ProjectType.PYTHON,
+                "python",
+                evidence(files, "pyproject.toml", "requirements.txt", "setup.py"),
+                pythonChecks(hasPytestConfig = names.contains("pytest.ini") || names.contains("conftest.py")),
+            )
+        }
+        if (names.contains("Cargo.toml")) {
+            return profile(ProjectType.RUST, "cargo", evidence(files, "Cargo.toml"), rustChecks())
+        }
+        if (names.contains("go.mod")) {
+            return profile(ProjectType.GO, "go", evidence(files, "go.mod"), goChecks())
+        }
+        return ProjectProfile(
+            type = ProjectType.UNKNOWN,
+            buildSystem = "none",
+            evidence = emptyList(),
+            checks = emptyList(),
+            unavailable = listOf("no recognised build file; ask the user how this project is built"),
+        )
+    }
+
+    private fun hasGradleSettings(names: Set<String>) = names.contains("settings.gradle.kts") || names.contains("settings.gradle")
+
+    private fun evidence(
+        files: List<String>,
+        vararg markers: String,
+    ): List<String> = files.filter { file -> markers.any { file.endsWith(it) } }.take(MAX_EVIDENCE)
+
+    private fun profile(
+        type: ProjectType,
+        buildSystem: String,
+        evidence: List<String>,
+        checks: List<CheckCommand>,
+        unavailable: List<String> = emptyList(),
+    ) = ProjectProfile(type, buildSystem, evidence, checks.filter { it.isSafe }, unavailable)
+
+    private fun androidChecks() =
+        listOf(
+            CheckCommand(
+                id = "android.unit-test",
+                executable = "./gradlew",
+                args = listOf(":app:testDebugUnitTest", "--console=plain"),
+                category = CheckCategory.UNIT_TEST,
+                timeoutMs = 20L * 60L * 1000L,
+            ),
+            CheckCommand(
+                id = "android.detekt",
+                executable = "./gradlew",
+                args = listOf("detekt", "spotlessCheck", "--console=plain"),
+                category = CheckCategory.STATIC_ANALYSIS,
+                timeoutMs = 15L * 60L * 1000L,
+            ),
+            CheckCommand(
+                id = "android.assemble-debug",
+                executable = "./gradlew",
+                args = listOf(":app:assembleDebug", "--console=plain"),
+                category = CheckCategory.BUILD,
+                timeoutMs = 25L * 60L * 1000L,
+            ),
+        )
+
+    private fun jvmChecks() =
+        listOf(
+            CheckCommand("jvm.test", "./gradlew", listOf("test", "--console=plain"), CheckCategory.UNIT_TEST),
+            CheckCommand("jvm.build", "./gradlew", listOf("build", "--console=plain"), CheckCategory.BUILD),
+        )
+
+    private fun nodeChecks(hasTsConfig: Boolean): List<CheckCommand> {
+        val checks =
+            mutableListOf(
+                CheckCommand("node.test", "npm", listOf("test", "--silent"), CheckCategory.UNIT_TEST, timeoutMs = 15L * 60L * 1000L),
+            )
+        if (hasTsConfig) {
+            checks +=
+                CheckCommand("node.typecheck", "npx", listOf("tsc", "--noEmit"), CheckCategory.STATIC_ANALYSIS)
+        }
+        return checks
+    }
+
+    private fun pythonChecks(hasPytestConfig: Boolean): List<CheckCommand> {
+        val checks =
+            mutableListOf(
+                CheckCommand(
+                    "python.compile",
+                    "python3",
+                    listOf("-m", "compileall", "-q", "."),
+                    CheckCategory.STATIC_ANALYSIS,
+                    timeoutMs = 5L * 60L * 1000L,
+                ),
+            )
+        if (hasPytestConfig) {
+            checks +=
+                CheckCommand("python.pytest", "python3", listOf("-m", "pytest", "-q"), CheckCategory.UNIT_TEST)
+        }
+        return checks
+    }
+
+    private fun rustChecks() =
+        listOf(
+            CheckCommand("rust.check", "cargo", listOf("check", "--quiet"), CheckCategory.STATIC_ANALYSIS),
+            CheckCommand("rust.test", "cargo", listOf("test", "--quiet"), CheckCategory.UNIT_TEST),
+        )
+
+    private fun goChecks() =
+        listOf(
+            CheckCommand("go.vet", "go", listOf("vet", "./..."), CheckCategory.STATIC_ANALYSIS),
+            CheckCommand("go.test", "go", listOf("test", "./..."), CheckCategory.UNIT_TEST),
+        )
+
+    private const val MAX_EVIDENCE = 6
+}
diff --git a/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectProfile.kt b/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectProfile.kt
new file mode 100644
index 0000000..22efcf6
--- /dev/null
+++ b/app/src/main/java/com/yugahashimoto/andcode/core/buildcheck/ProjectProfile.kt
@@ -0,0 +1,124 @@
+package com.yugahashimoto.andcode.core.buildcheck
+
+/**
+ * What kind of project a workspace holds.
+ *
+ * Detection is filename-based on purpose: it needs no execution, no SDK and no network, so the same code
+ * runs on the phone, in a unit test and on a CI runner. It can be wrong about a project that has been
+ * reorganised in unusual ways, which is why every profile carries its [ProjectProfile.evidence] instead of
+ * just asserting a type.
+ */
+enum class ProjectType {
+    ANDROID_GRADLE,
+    JVM_GRADLE,
+    NODE,
+    PYTHON,
+    RUST,
+    GO,
+    UNKNOWN,
+    ;
+
+    /** True when the checks for this type need a toolchain the app cannot assume the device has. */
+    val needsExternalToolchain: Boolean get() = this == ANDROID_GRADLE
+}
+
+/** The classes of check the app knows how to ask for, in the order a task normally runs them. */
+enum class CheckCategory {
+    FORMAT,
+    STATIC_ANALYSIS,
+    UNIT_TEST,
+    BUILD,
+}
+
+/**
+ * One check the app is allowed to run.
+ *
+ * [executable] and [args] are separate, and args are passed as argv rather than through a shell, so a
+ * project cannot smuggle a second command in through a flag value. [CheckCommand.isSafe] re-checks that
+ * invariant because manifests and profiles are data, and data gets edited.
+ */
+data class CheckCommand(
+    val id: String,
+    val executable: String,
+    val args: List<String>,
+    val category: CheckCategory,
+    val timeoutMs: Long = DEFAULT_TIMEOUT_MS,
+    val maxOutputBytes: Long = DEFAULT_MAX_OUTPUT_BYTES,
+) {
+    val isSafe: Boolean
+        get() = executable in ALLOWED_EXECUTABLES &&
+            args.none { arg -> SHELL_METACHARACTERS.any { arg.contains(it) } } &&
+            timeoutMs in 1..MAX_TIMEOUT_MS &&
+            maxOutputBytes in 1..MAX_OUTPUT_BYTES
+
+    /** Command line for the log and the report; safe to display because args cannot contain a separator. */
+    val display: String get() = (listOf(executable) + args).joinToString(" ")
+
+    companion object {
+        const val DEFAULT_TIMEOUT_MS = 10L * 60L * 1000L
+        const val DEFAULT_MAX_OUTPUT_BYTES = 512L * 1024L
+        const val MAX_TIMEOUT_MS = 30L * 60L * 1000L
+        const val MAX_OUTPUT_BYTES = 4L * 1024L * 1024L
+
+        /**
+         * The only executables a generated check may name. Anything else - a project script, a wrapper the
+         * repo ships, an interpreter - has to go through the task runner as an explicit operation and the
+         * policy engine, not through a generated check.
+         */
+        val ALLOWED_EXECUTABLES =
+            setOf("./gradlew", "gradlew", "npm", "npx", "python3", "python", "cargo", "go")
+
+        private val SHELL_METACHARACTERS = listOf(";", "|", "&", "$", "`", ">", "<", "\n", "\r")
+    }
+}
+
+/** The result of looking at a workspace's file list. */
+data class ProjectProfile(
+    val type: ProjectType,
+    val buildSystem: String,
+    /** Files that led to this verdict, so the user can see why. */
+    val evidence: List<String>,
+    /** Checks the app may run, already ordered and limited. */
+    val checks: List<CheckCommand>,
+    /** Things this environment cannot do, stated up front instead of discovered by a failing build. */
+    val unavailable: List<String> = emptyList(),
+) {
+    fun checksFor(categories: Set<CheckCategory>): List<CheckCommand> = checks.filter { it.category in categories }
+
+    /** The quickest check that gives a signal about whether the code even compiles. */
+    fun fastestSignal(): CheckCommand? =
+        checksFor(setOf(CheckCategory.UNIT_TEST)).firstOrNull() ?: checks.firstOrNull()
+}
+
+/** One check's result. [FailureClass] comes from [FailureClassifier], never from the model's prose. */
+data class CheckResult(
+    val command: CheckCommand,
+    val exitCode: Int?,
+    val timedOut: Boolean,
+    val output: String,
+    val failure: FailureClass,
+    val failureEvidence: String?,
+) {
+    val passed: Boolean get() = exitCode == 0 && !timedOut
+}
+
+/**
+ * What went wrong, in the three buckets a task report has to distinguish so the user is not told "your code
+ * is broken" when the device is simply missing an SDK.
+ */
+enum class FailureClass {
+    /** Toolchain, SDK, dependency download, disk or permissions. Not the project's fault. */
+    ENVIRONMENT,
+
+    /** The code did not compile or a static rule failed. */
+    CODE,
+
+    /** The code built and a test failed. */
+    TEST,
+
+    /** The check hit its time budget. */
+    TIMEOUT,
+
+    /** Nothing recognisable; reported as unknown rather than guessed. */
+    UNKNOWN,
+}
diff --git a/app/src/test/java/com/yugahashimoto/andcode/core/buildcheck/FailureClassifierTest.kt b/app/src/test/java/com/yugahashimoto/andcode/core/buildcheck/FailureClassifierTest.kt
new file mode 100644
index 0000000..857fcd5
--- /dev/null
+++ b/app/src/test/java/com/yugahashimoto/andcode/core/buildcheck/FailureClassifierTest.kt
@@ -0,0 +1,92 @@
+package com.yugahashimoto.andcode.core.buildcheck
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class FailureClassifierTest {
+    private val unitTest =
+        CheckCommand(
+            id = "android.unit-test",
+            executable = "./gradlew",
+            args = listOf(":app:testDebugUnitTest"),
+            category = CheckCategory.UNIT_TEST,
+            maxOutputBytes = 100,
+        )
+
+    @Test
+    fun `a passing check is not a failure`() {
+        val result = FailureClassifier.result(unitTest, exitCode = 0, timedOut = false, output = "BUILD SUCCESSFUL")
+        assertTrue(result.passed)
+        assertEquals(null, result.failureEvidence)
+    }
+
+    @Test
+    fun `a missing sdk is an environment failure even though the log is full of errors`() {
+        val log =
+            """
+            > Task :app:compileDebugKotlin FAILED
+            e: file:///w/app/Main.kt:3:1 error: unresolved reference
+            FAILURE: Build failed with an exception.
+            * What went wrong:
+            SDK location not found. Define a valid SDK location with an ANDROID_HOME
+            """.trimIndent()
+
+        val result = FailureClassifier.result(unitTest, exitCode = 1, timedOut = false, output = log)
+        assertEquals(FailureClass.ENVIRONMENT, result.failure)
+        assertTrue(result.failureEvidence!!.contains("SDK location not found"))
+        assertFalse(FailureClassifier.classify(1, false, log).retryable)
+    }
+
+    @Test
+    fun `a dependency download failure is environmental`() {
+        val verdict =
+            FailureClassifier.classify(
+                exitCode = 1,
+                timedOut = false,
+                output = "Could not resolve all dependencies for configuration ':app:debugRuntimeClasspath'",
+            )
+        assertEquals(FailureClass.ENVIRONMENT, verdict.failureClass)
+    }
+
+    @Test
+    fun `a compile error is a code failure`() {
+        val verdict = FailureClassifier.classify(1, false, "e: file:///w/Main.kt:10:5 Unresolved reference: Foo")
+        assertEquals(FailureClass.CODE, verdict.failureClass)
+    }
+
+    @Test
+    fun `a failing test is a test failure`() {
+        val verdict = FailureClassifier.classify(1, false, "There were failing tests. See the report at: file:///w/report")
+        assertEquals(FailureClass.TEST, verdict.failureClass)
+    }
+
+    @Test
+    fun `a timeout is its own class and the only retryable one`() {
+        val verdict = FailureClassifier.classify(null, timedOut = true, output = "")
+        assertEquals(FailureClass.TIMEOUT, verdict.failureClass)
+        assertTrue(verdict.retryable)
+    }
+
+    @Test
+    fun `an unrecognised failure stays unknown instead of being guessed`() {
+        val verdict = FailureClassifier.classify(3, false, "something unexpected happened")
+        assertEquals(FailureClass.UNKNOWN, verdict.failureClass)
+        assertEquals(null, verdict.evidence)
+    }
+
+    @Test
+    fun `the stored output is truncated to the command limit`() {
+        val result = FailureClassifier.result(unitTest, exitCode = 1, timedOut = false, output = "x".repeat(500))
+        assertTrue(result.output.length <= 100)
+        assertFalse(result.passed)
+    }
+
+    @Test
+    fun `evidence is a single trimmed line, not the whole log`() {
+        val log = "line1\n   error: something broke here   \nline3"
+        val result = FailureClassifier.result(unitTest, exitCode = 1, timedOut = false, output = log)
+        assertEquals("error: something broke here", result.failureEvidence)
+    }
+}
