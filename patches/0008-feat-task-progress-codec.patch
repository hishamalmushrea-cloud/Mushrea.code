+package com.yugahashimoto.andcode.core.task
+
+import com.yugahashimoto.andcode.core.security.SecretRedaction
+
+/** Why a stored task could not be read back. Every case is reported, never thrown. */
+enum class DecodeRejection {
+    EMPTY,
+
+    /** Not a task file at all. */
+    BAD_HEADER,
+
+    /** Written by a newer app; refusing is safer than guessing at the format. */
+    UNSUPPORTED_VERSION,
+
+    /** Larger than [TaskProgressCodec.MAX_BYTES]; refused rather than parsed. */
+    TOO_LARGE,
+
+    /** More steps than [TaskProgressCodec.MAX_STEPS]. */
+    TOO_MANY_STEPS,
+
+    /** A line that is not `key=value`, or a step line with the wrong column count. */
+    MALFORMED_LINE,
+
+    /** A value that does not parse: unknown state, negative attempt count, bad number, invalid step id. */
+    INVALID_VALUE,
+
+    /** The same step id twice. */
+    DUPLICATE_STEP,
+}
+
+sealed interface TaskDecodeResult {
+    /**
+     * [unknownKeys] lists fields this version of the app did not understand. They are ignored, not fatal, so a
+     * newer writer does not corrupt an older reader - but the caller can log them while diagnosing a resume.
+     */
+    data class Decoded(
+        val progress: TaskProgress,
+        val unknownKeys: List<String>,
+    ) : TaskDecodeResult
+
+    data class Rejected(
+        val reason: DecodeRejection,
+        val detail: String,
+    ) : TaskDecodeResult
+}
+
+/**
+ * Line-based, dependency-free format for a saved task.
+ *
+ * Hand-written rather than `kotlinx.serialization` on purpose: this has to be readable by a resumed process
+ * on any app version, must not silently change shape when a data class gains a field, and must be diffable
+ * in a bug report. It is also the reason the format has a version header and explicit bounds: a corrupt or
+ * hostile file must fail loudly, not half-load.
+ *
+ * ```
+ * andcode-task 1
+ * state=RUNNING
+ * attempts=1
+ * startedAt=1700000000000
+ * pausedAt=
+ * step=edit|DONE|1|1|1700000000001|1700000000002|
+ * ```
+ *
+ * The last column is the failure message, escaped: `\\` for a backslash, `\p` for a pipe, `\n` and `\r` for
+ * newlines, so a message can never break the record. It is passed through [SecretRedaction] on the way in
+ * and on the way out, so a step that failed while quoting a token cannot persist it.
+ */
+object TaskProgressCodec {
+    const val MAGIC = "andcode-task"
+    const val VERSION = 1
+
+    /** 64 KiB is far more than [TaskLimits.DEFAULT_MAX_STEPS] steps can need. */
+    const val MAX_BYTES = 64 * 1024
+    const val MAX_STEPS = 200
+
+    private const val STEP_PREFIX = "step="
+    private const val COLUMNS = 7
+    private val STEP_ID = Regex("^[A-Za-z0-9._:-]{1,64}$")
+
+    fun encode(progress: TaskProgress): String =
+        buildString {
+            appendLine("$MAGIC $VERSION")
+            appendLine("state=${progress.state.name}")
+            appendLine("attempts=${progress.attempts}")
+            appendLine("startedAt=${progress.startedAtMs}")
+            appendLine("pausedAt=${progress.pausedAtMs ?: ""}")
+            for (step in progress.steps.take(MAX_STEPS)) {
+                append(STEP_PREFIX)
+                append(escape(step.id))
+                append('|').append(step.state.name)
+                append('|').append(if (step.sideEffecting) 1 else 0)
+                append('|').append(step.attempts)
+                append('|').append(step.startedAtMs ?: "")
+                append('|').append(step.finishedAtMs ?: "")
+                append('|').append(step.failure?.let { escape(SecretRedaction.redact(it)) }.orEmpty())
+                appendLine()
+            }
+        }.trimEnd('\n') + "\n"
+
+    fun decode(text: String): TaskDecodeResult {
+        if (text.isBlank()) return reject(DecodeRejection.EMPTY, "file is empty")
+        if (text.length > MAX_BYTES) return reject(DecodeRejection.TOO_LARGE, "${text.length} > $MAX_BYTES characters")
+
+        val lines = text.trimEnd('\n').split('\n')
+        val header = lines.first().trim()
+        if (!header.startsWith("$MAGIC ")) return reject(DecodeRejection.BAD_HEADER, "missing '$MAGIC' header")
+        val version = header.removePrefix("$MAGIC ").trim().toIntOrNull()
+        if (version != VERSION) return reject(DecodeRejection.UNSUPPORTED_VERSION, "version '$version', expected $VERSION")
+
+        val scalars = mutableMapOf<String, String>()
+        val steps = mutableListOf<String>()
+        val unknown = mutableListOf<String>()
+        for (line in lines.drop(1)) {
+            if (line.isBlank()) continue
+            if (line.startsWith(STEP_PREFIX)) {
+                steps += line.removePrefix(STEP_PREFIX)
+                continue
+            }
+            val key = line.substringBefore('=', "")
+            if (key.isEmpty() || !line.contains('=')) {
+                return reject(DecodeRejection.MALFORMED_LINE, "not key=value: ${line.take(40)}")
+            }
+            when (key) {
+                "state", "attempts", "startedAt", "pausedAt" -> scalars[key] = line.substringAfter('=')
+                else -> unknown += key
+            }
+        }
+        if (steps.size > MAX_STEPS) return reject(DecodeRejection.TOO_MANY_STEPS, "${steps.size} > $MAX_STEPS")
+
+        val state =
+            scalars["state"]?.let { value -> TaskState.entries.firstOrNull { it.name == value } }
+                ?: return reject(DecodeRejection.INVALID_VALUE, "state '${scalars["state"]}' is not a known state")
+        val attempts = scalars["attempts"]?.toIntOrNull()
+            ?: return reject(DecodeRejection.INVALID_VALUE, "attempts is missing or not a number")
+        if (attempts < 0) return reject(DecodeRejection.INVALID_VALUE, "attempts is negative")
+        val startedAt = scalars["startedAt"]?.toLongOrNull()
+            ?: return reject(DecodeRejection.INVALID_VALUE, "startedAt is missing or not a number")
+        val rawPausedAt = scalars["pausedAt"].orEmpty()
+        val pausedAt =
+            if (rawPausedAt.isEmpty()) {
+                null
+            } else {
+                rawPausedAt.toLongOrNull() ?: return reject(DecodeRejection.INVALID_VALUE, "pausedAt is not a number")
+            }
+
+        val parsedSteps = mutableListOf<TaskStep>()
+        val seen = mutableSetOf<String>()
+        for (raw in steps) {
+            when (val parsed = parseStep(raw)) {
+                is StepParse.Rejected -> return reject(parsed.reason, parsed.detail)
+                is StepParse.Parsed -> {
+                    if (!seen.add(parsed.step.id)) {
+                        return reject(DecodeRejection.DUPLICATE_STEP, "step '${parsed.step.id}' appears twice")
+                    }
+                    parsedSteps += parsed.step
+                }
+            }
+        }
+        val progress = TaskProgress(state, parsedSteps, attempts, startedAt, pausedAt)
+        return TaskDecodeResult.Decoded(progress, unknown.distinct())
+    }
+
+    private sealed interface StepParse {
+        data class Parsed(val step: TaskStep) : StepParse
+
+        data class Rejected(val reason: DecodeRejection, val detail: String) : StepParse
+    }
+
+    /** Parses one step record. A wrong shape and a wrong value are both reported, never guessed at. */
+    private fun parseStep(raw: String): StepParse {
+        val columns = raw.split('|')
+        if (columns.size < COLUMNS) {
+            return StepParse.Rejected(DecodeRejection.MALFORMED_LINE, "step line has fewer than $COLUMNS columns")
+        }
+        val id = unescape(columns[0])
+        if (id.isEmpty() || !STEP_ID.matches(id)) {
+            return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step id '$id' is not allowed")
+        }
+        val state =
+            StepState.entries.firstOrNull { it.name == columns[1] }
+                ?: return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' has unknown state '${columns[1]}'")
+        val sideEffecting =
+            when (columns[2]) {
+                "1", "true" -> true
+                "0", "false" -> false
+                else -> return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' has a non-boolean sideEffecting")
+            }
+        val attempts =
+            columns[3].toIntOrNull()
+                ?: return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' attempts is not a number")
+        if (attempts < 0) return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' attempts is negative")
+        // An empty column means "no timestamp", which is unknown-but-valid; only a non-empty non-number is an
+        // error. Conflating the two rejected every step that had not started or finished yet.
+        val startedAt =
+            if (columns[4].isEmpty()) {
+                null
+            } else {
+                columns[4].toLongOrNull()
+                    ?: return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' startedAt is not a number")
+            }
+        val finishedAt =
+            if (columns[5].isEmpty()) {
+                null
+            } else {
+                columns[5].toLongOrNull()
+                    ?: return StepParse.Rejected(DecodeRejection.INVALID_VALUE, "step '$id' finishedAt is not a number")
+            }
+        // Columns beyond the sixth are part of the message: a pipe that survived escaping must not truncate it.
+        val failure = columns.drop(6).joinToString("|").takeIf { it.isNotEmpty() }?.let { SecretRedaction.redact(unescape(it)) }
+        return StepParse.Parsed(TaskStep(id, state, sideEffecting, attempts, startedAt, finishedAt, failure))
+    }
+
+
+    private fun reject(
+        reason: DecodeRejection,
+        detail: String,
+    ) = TaskDecodeResult.Rejected(reason, SecretRedaction.redact(detail))
+
+    private fun escape(value: String): String =
+        value.replace("\\", "\\\\").replace("|", "\\p").replace("\n", "\\n").replace("\r", "\\r")
+
+    private fun unescape(value: String): String {
+        val out = StringBuilder(value.length)
+        var index = 0
+        while (index < value.length) {
+            val char = value[index]
+            if (char == '\\' && index + 1 < value.length) {
+                when (val next = value[index + 1]) {
+                    '\\' -> out.append('\\')
+                    'p' -> out.append('|')
+                    'n' -> out.append('\n')
+                    'r' -> out.append('\r')
+                    else -> out.append(next)
+                }
+                index += 2
+            } else {
+                out.append(char)
+                index++
+            }
+        }
+        return out.toString()
+    }
+}
