+package com.yugahashimoto.andcode.core.task
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class TaskProgressCodecTest {
+    private val progress =
+        TaskProgress(
+            state = TaskState.RUNNING,
+            steps =
+                listOf(
+                    TaskStep("edit", StepState.DONE, sideEffecting = true, attempts = 1, startedAtMs = 10, finishedAtMs = 20),
+                    TaskStep("scan", StepState.RUNNING, sideEffecting = false, attempts = 2, startedAtMs = 20),
+                    TaskStep("write", StepState.FAILED, sideEffecting = true, attempts = 3, failure = "compile broke"),
+                ),
+            attempts = 3,
+            startedAtMs = 1_700_000_000_000,
+            pausedAtMs = null,
+        )
+
+    private fun decoded(text: String): TaskProgress =
+        (TaskProgressCodec.decode(text) as TaskDecodeResult.Decoded).progress
+
+    private fun rejection(text: String): DecodeRejection =
+        (TaskProgressCodec.decode(text) as TaskDecodeResult.Rejected).reason
+
+    @Test
+    fun `a saved task round trips exactly`() {
+        assertEquals(progress, decoded(TaskProgressCodec.encode(progress)))
+    }
+
+    @Test
+    fun `every state round trips`() {
+        for (state in TaskState.entries) {
+            val saved = progress.copy(state = state, steps = emptyList())
+            assertEquals(state, decoded(TaskProgressCodec.encode(saved)).state)
+        }
+        for (state in StepState.entries) {
+            val saved = TaskProgress(TaskState.RUNNING, listOf(TaskStep("s", state)), 0, 1)
+            assertEquals(state, decoded(TaskProgressCodec.encode(saved)).steps.single().state)
+        }
+    }
+
+    @Test
+    fun `a paused timestamp survives`() {
+        val saved = progress.copy(state = TaskState.PAUSED, pausedAtMs = 1_700_000_000_500)
+        assertEquals(1_700_000_000_500, decoded(TaskProgressCodec.encode(saved)).pausedAtMs)
+    }
+
+    @Test
+    fun `a failure message with pipes, backslashes and newlines survives`() {
+        val messy = "a|b\\c\nd\re"
+        val saved = TaskProgress(TaskState.FAILED, listOf(TaskStep("s", StepState.FAILED, failure = messy)), 1, 1)
+        val text = TaskProgressCodec.encode(saved)
+
+        assertEquals(1, text.lines().count { it.startsWith("step=") })
+        assertEquals(messy, decoded(text).steps.single().failure)
+    }
+
+    @Test
+    fun `a credential in a failure message is never written to disk`() {
+        val saved =
+            TaskProgress(
+                TaskState.FAILED,
+                listOf(TaskStep("s", StepState.FAILED, failure = "auth failed for sk-proj-abcdefghijklmnop")),
+                1,
+                1,
+            )
+        val text = TaskProgressCodec.encode(saved)
+
+        assertTrue(!text.contains("sk-proj-abcdefghijklmnop"))
+        assertTrue(text.contains("<redacted>"))
+    }
+
+    @Test
+    fun `the encoded form is a stable, readable header plus one line per step`() {
+        val lines = TaskProgressCodec.encode(progress).trimEnd('\n').split('\n')
+        assertEquals("andcode-task 1", lines[0])
+        assertEquals(5 + 3, lines.size) // header, state, attempts, startedAt, pausedAt, then one line per step
+        assertTrue(lines[1].startsWith("state=RUNNING"))
+        assertEquals(3, lines.count { it.startsWith("step=") })
+    }
+
+    @Test
+    fun `an empty file is refused`() {
+        assertEquals(DecodeRejection.EMPTY, rejection(""))
+        assertEquals(DecodeRejection.EMPTY, rejection("   \n "))
+    }
+
+    @Test
+    fun `a file without the magic header is refused`() {
+        assertEquals(DecodeRejection.BAD_HEADER, rejection("state=RUNNING\n"))
+    }
+
+    @Test
+    fun `a newer format version is refused instead of half parsed`() {
+        assertEquals(DecodeRejection.UNSUPPORTED_VERSION, rejection("andcode-task 2\nstate=RUNNING\n"))
+        assertEquals(DecodeRejection.UNSUPPORTED_VERSION, rejection("andcode-task nonsense\nstate=RUNNING\n"))
+    }
+
+    @Test
+    fun `an oversized file is refused before parsing`() {
+        val huge = "andcode-task 1\nstate=RUNNING\n" + "x".repeat(TaskProgressCodec.MAX_BYTES)
+        assertEquals(DecodeRejection.TOO_LARGE, rejection(huge))
+    }
+
+    @Test
+    fun `too many steps are refused`() {
+        val header = "andcode-task 1\nstate=RUNNING\nattempts=0\nstartedAt=1\npausedAt=\n"
+        val step = "step=s|PENDING|0|0|||\n"
+        assertEquals(DecodeRejection.TOO_MANY_STEPS, rejection(header + step.repeat(TaskProgressCodec.MAX_STEPS + 1)))
+    }
+
+    @Test
+    fun `malformed lines and values are refused`() {
+        assertEquals(DecodeRejection.MALFORMED_LINE, rejection("andcode-task 1\nstate RUNNING\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection("andcode-task 1\nstate=NOPE\nattempts=0\nstartedAt=1\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection("andcode-task 1\nstate=RUNNING\nattempts=-1\nstartedAt=1\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection("andcode-task 1\nstate=RUNNING\nattempts=x\nstartedAt=1\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection("andcode-task 1\nstate=RUNNING\nattempts=0\n"))
+    }
+
+    @Test
+    fun `a bad step line is refused with a reason`() {
+        val header = "andcode-task 1\nstate=RUNNING\nattempts=0\nstartedAt=1\n"
+        assertEquals(DecodeRejection.MALFORMED_LINE, rejection(header + "step=edit|DONE|1\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection(header + "step=edit|NOPE|1|0|||\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection(header + "step=../etc/passwd|DONE|1|0|||\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection(header + "step=edit|DONE|2|0|||\n"))
+        assertEquals(DecodeRejection.INVALID_VALUE, rejection(header + "step=edit|DONE|1|-1|||\n"))
+    }
+
+    @Test
+    fun `a duplicated step is refused`() {
+        val header = "andcode-task 1\nstate=RUNNING\nattempts=0\nstartedAt=1\n"
+        val step = "step=edit|DONE|1|1|||\n"
+        assertEquals(DecodeRejection.DUPLICATE_STEP, rejection(header + step + step))
+    }
+
+    @Test
+    fun `an unknown field is ignored and reported, not fatal`() {
+        val text = TaskProgressCodec.encode(progress).replace("state=RUNNING", "state=RUNNING\nfutureField=42")
+        val result = TaskProgressCodec.decode(text) as TaskDecodeResult.Decoded
+
+        assertEquals(TaskState.RUNNING, result.progress.state)
+        assertEquals(listOf("futureField"), result.unknownKeys)
+    }
+
+    @Test
+    fun `blank lines between records are tolerated`() {
+        val text = TaskProgressCodec.encode(progress).replace("state=RUNNING\n", "state=RUNNING\n\n")
+        assertEquals(progress, decoded(text))
+    }
+
+    @Test
+    fun `a decoded task can be resumed`() {
+        val saved =
+            TaskProgress(
+                state = TaskState.PAUSED,
+                steps = listOf(TaskStep("scan", StepState.PENDING), TaskStep("write", StepState.RUNNING, sideEffecting = true)),
+                startedAtMs = 1_000,
+            )
+        val restored = decoded(TaskProgressCodec.encode(saved))
+        val plan = TaskResume.plan(restored, now = 2_000, limits = TaskLimits()) as ResumePlan.Resumable
+
+        assertEquals(listOf("scan"), plan.stepsToRun)
+        assertEquals(listOf("write"), plan.stepsNeedingConfirmation)
+    }
+}
